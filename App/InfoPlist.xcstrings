{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "NSFaceIDUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry uses Touch ID to confirm destructive actions like removing a container or deleting a host."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry 使用 Touch ID 确认移除容器或删除主机等破坏性操作。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry verwendet Touch ID, um destruktive Aktionen wie das Entfernen eines Containers oder das Löschen eines Hosts zu bestätigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry utilise Touch ID pour confirmer les actions destructrices, comme la suppression d'un conteneur ou d'un hôte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry usa Touch ID para confirmar acciones destructivas, como eliminar un contenedor o un host."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry usa Touch ID per confermare le azioni distruttive, come la rimozione di un container o l'eliminazione di un host."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Gantry utiliza o Touch ID para confirmar ações destrutivas, como remover um contentor ou eliminar um host."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry gebruikt Touch ID om destructieve acties te bevestigen, zoals het verwijderen van een container of een host."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry använder Touch ID för att bekräfta destruktiva åtgärder, som att ta bort en container eller radera en värd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry bruger Touch ID til at bekræfte destruktive handlinger som at fjerne en container eller slette en vært."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry bruker Touch ID til å bekrefte destruktive handlinger, for eksempel å fjerne en container eller slette en vert."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry käyttää Touch ID:tä tuhoavien toimintojen, kuten kontin poistamisen tai isännän poistamisen, vahvistamiseen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry używa Touch ID do potwierdzania nieodwracalnych czynności, takich jak usunięcie kontenera lub hosta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry používá Touch ID k potvrzení destruktivních akcí, jako je odstranění kontejneru nebo smazání hostitele."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry používa Touch ID na potvrdenie deštruktívnych akcií, ako je odstránenie kontajnera alebo vymazanie hostiteľa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Gantry a Touch ID-t használja a romboló műveletek, például egy konténer eltávolításának vagy egy gazdagép törlésének megerősítésére."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry folosește Touch ID pentru a confirma acțiunile distructive, cum ar fi eliminarea unui container sau ștergerea unei gazde."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry използва Touch ID за потвърждаване на деструктивни действия, като премахване на контейнер или изтриване на хост."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Gantry χρησιμοποιεί το Touch ID για να επιβεβαιώνει καταστροφικές ενέργειες, όπως την αφαίρεση ενός κοντέινερ ή τη διαγραφή ενός host."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry koristi Touch ID za potvrdu destruktivnih radnji, poput uklanjanja kontejnera ili brisanja hosta."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry uporablja Touch ID za potrditev uničujočih dejanj, kot sta odstranitev vsebnika ali brisanje gostitelja."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry користи Touch ID за потврду деструктивних радњи, као што су уклањање контејнера или брисање хоста."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry koristi Touch ID za potvrdu destruktivnih radnji, kao što su uklanjanje kontejnera ili brisanje hosta."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry naudoja Touch ID, kad patvirtintų negrįžtamus veiksmus, pavyzdžiui, konteinerio pašalinimą ar serverio ištrynimą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry izmanto Touch ID, lai apstiprinātu neatgriezeniskas darbības, piemēram, konteinera noņemšanu vai resursdatora dzēšanu."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry kasutab Touch ID-d hävitavate toimingute kinnitamiseks, näiteks konteineri eemaldamisel või hosti kustutamisel."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry використовує Touch ID для підтвердження незворотних дій, як-от вилучення контейнера чи видалення хоста."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry использует Touch ID, чтобы подтверждать необратимые действия, например удаление контейнера или хоста."
          }
        }
      }
    },
