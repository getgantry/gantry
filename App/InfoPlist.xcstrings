    "NSFaceIDUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry uses Touch ID to confirm destructive actions like removing a container or deleting a host."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry 使用 Touch ID 确认移除容器或删除主机等破坏性操作。"
