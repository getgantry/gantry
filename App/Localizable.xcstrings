            "state": "translated",
            "value": "Машина працює, її буде зупинено."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Машина работает и будет остановлена."
          }
        }
      }
    },
    "The network is deleted from this host.": {
      "localizations": {
        "en": {
          "stringUnit": {
