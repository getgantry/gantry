    "Enter a new name: letters, digits, “_”, “.” and “-”, starting with a letter or digit. It must differ from the current name and from other containers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a new name: letters, digits, “_”, “.” and “-”, starting with a letter or digit. It must differ from the current name and from other containers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入新名称：可使用字母、数字、“_”、“.”和“-”，并以字母或数字开头。新名称必须与当前名称及其他容器的名称不同。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen neuen Namen ein: Buchstaben, Ziffern, „_“, „.“ und „-“, beginnend mit einem Buchstaben oder einer Ziffer. Er muss sich vom aktuellen Namen und von anderen Containern unterscheiden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un nouveau nom : lettres, chiffres, « _ », « . » et « - », en commençant par une lettre ou un chiffre. Il doit être différent du nom actuel et de celui des autres conteneurs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un nombre nuevo: letras, dígitos, “_”, “.” y “-”, empezando por una letra o un dígito. Debe ser distinto del nombre actual y del de otros contenedores."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un nuovo nome: lettere, cifre, “_”, “.” e “-”, iniziando con una lettera o una cifra. Deve essere diverso dal nome attuale e da quello degli altri container."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza um novo nome: letras, algarismos, “_”, “.” e “-”, a começar por uma letra ou algarismo. Tem de ser diferente do nome atual e do nome de outros contentores."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een nieuwe naam in: letters, cijfers, “_”, “.” en “-”, beginnend met een letter of cijfer. De naam moet verschillen van de huidige naam en van andere containers."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange ett nytt namn: bokstäver, siffror, ”_”, ”.” och ”-”, som börjar med en bokstav eller siffra. Det måste skilja sig från det nuvarande namnet och från andra containrar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast et nyt navn: bogstaver, cifre, “_”, “.” og “-”, der starter med et bogstav eller et ciffer. Det skal være forskelligt fra det nuværende navn og fra andre containeres navne."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn et nytt navn: bokstaver, sifre, «_», «.» og «-». Navnet må begynne med en bokstav eller et siffer og være forskjellig fra det nåværende navnet og fra navnene på andre containere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna uusi nimi: kirjaimia, numeroita, ”_”, ”.” ja ”-”. Nimen on alettava kirjaimella tai numerolla. Sen on oltava eri kuin nykyinen nimi ja muiden konttien nimet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź nową nazwę: litery, cyfry, „_”, „.” i „-”, zaczynającą się od litery lub cyfry. Musi się różnić od obecnej nazwy i od nazw innych kontenerów."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte nový název: písmena, číslice, „_“, „.“ a „-“, na začátku písmeno nebo číslice. Musí se lišit od současného názvu i od názvů ostatních kontejnerů."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadajte nový názov: písmená, číslice, „_“, „.“ a „-“, na začiatku písmeno alebo číslica. Musí sa líšiť od aktuálneho názvu a od názvov iných kontajnerov."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjon meg egy új nevet: betűk, számjegyek, „_”, „.” és „-”, betűvel vagy számjeggyel kezdve. Különböznie kell a jelenlegi névtől és a többi konténer nevétől."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduceți un nume nou: litere, cifre, „_”, „.” și „-”, începând cu o literă sau o cifră. Trebuie să difere de numele actual și de numele altor containere."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Въведете ново име: букви, цифри, „_“, „.“ и „-“, като започва с буква или цифра. То трябва да се различава от текущото име и от имената на другите контейнери."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε νέο όνομα: γράμματα, ψηφία, «_», «.» και «-», με πρώτο χαρακτήρα γράμμα ή ψηφίο. Πρέπει να διαφέρει από το τρέχον όνομα και από τα άλλα κοντέινερ."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite novi naziv: slova, znamenke, „_”, „.” i „-”, s početnim slovom ili znamenkom. Mora se razlikovati od trenutačnog naziva i od naziva drugih kontejnera."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vnesite novo ime: črke, števke, „_“, „.“ in „-“, na začetku črka ali števka. Ime se mora razlikovati od trenutnega imena in od imen drugih vsebnikov."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Унесите ново име: слова, цифре, „_“, „.“ и „-“, почевши словом или цифром. Мора да се разликује од тренутног имена и од имена других контејнера."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite novo ime: slova, cifre, „_“, „.“ i „-“, počevši slovom ili cifrom. Mora da se razlikuje od trenutnog imena i od imena drugih kontejnera."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įveskite naują pavadinimą: raidės, skaitmenys, „_“, „.“ ir „-“, pradedant raide arba skaitmeniu. Jis turi skirtis nuo dabartinio pavadinimo ir nuo kitų konteinerių pavadinimų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ievadiet jaunu nosaukumu: burti, cipari, „_”, „.” un „-”, sākot ar burtu vai ciparu. Tam jāatšķiras no pašreizējā nosaukuma un citu konteineru nosaukumiem."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisestage uus nimi: tähed, numbrid, „_“, „.“ ja „-“, alguses täht või number. See peab erinema praegusest nimest ja teiste konteinerite nimedest."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть нову назву: літери, цифри, «_», «.» і «-»; назва має починатися з літери чи цифри. Вона має відрізнятися від поточної назви та від назв інших контейнерів."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите новое имя: буквы, цифры, «_», «.» и «-», первый символ — буква или цифра. Имя должно отличаться от текущего и от имён других контейнеров."
          }
        }
      }
    },
    "Enter an image reference and choose Pull.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an image reference and choose Pull."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入镜像引用并选择拉取。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine Image-Referenz ein und wähle „Pullen“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une référence d'image et choisissez Télécharger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce una referencia de imagen y elige Descargar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un riferimento all'immagine e scegli Scarica."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza uma referência de imagem e escolha Descarregar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een imageverwijzing in en kies “Pull”."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange en image-referens och välj Hämta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast en image-reference, og vælg Hent."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn en image-referanse, og velg Hent."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna levykuvan viittaus ja valitse Nouda."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź odwołanie do obrazu i wybierz „Pobierz”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte odkaz na image a zvolte „Stáhnout“."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadajte referenciu obrazu a kliknite na „Stiahnuť“."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjon meg egy image-hivatkozást, és válassza a Letöltés lehetőséget."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduceți o referință de imagine și alegeți Descarcă."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Въведете референция на образ и изберете „Изтегли“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε μια αναφορά εικόνας και επιλέξτε «Λήψη»."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite referencu slike i odaberite Povuci."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vnesite sklic na sliko in izberite Povleci."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Унесите референцу слике и изаберите „Повуци“."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite referencu slike i izaberite „Povuci“."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įveskite atvaizdo nuorodą ir pasirinkite „Atsisiųsti“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ievadiet attēla atsauci un izvēlieties „Lejupielādēt”."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisestage tõmmise viide ja valige „Tõmba“."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть посилання на образ і виберіть «Отримати»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите ссылку на образ и нажмите «Скачать»."
          }
        }
      }
    },
