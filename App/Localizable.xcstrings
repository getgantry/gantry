    "Restart services to apply name resolution for new containers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart services to apply name resolution for new containers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重启服务以为新容器应用名称解析。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte die Dienste neu, um die Namensauflösung für neue Container anzuwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redémarrez les services pour appliquer la résolution de noms aux nouveaux conteneurs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia los servicios para aplicar la resolución de nombres a los contenedores nuevos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riavvia i servizi per applicare la risoluzione dei nomi ai nuovi container."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicie os serviços para aplicar a resolução de nomes aos novos contentores."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstart de services om naamresolutie voor nieuwe containers toe te passen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Starta om tjänsterna för att tillämpa namnuppslagning för nya containrar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genstart tjenesterne for at anvende navneopslag på nye containere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Start tjenestene på nytt for å bruke navneoppslag for nye containere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käynnistä palvelut uudelleen, jotta nimenselvitys toimii uusille konteille."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchom ponownie usługi, aby nowe kontenery korzystały z rozwiązywania nazw."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Restartujte služby, aby se překlad názvů použil pro nové kontejnery."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Reštartujte služby, aby sa pre nové kontajnery použil preklad názvov."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Indítsa újra a szolgáltatásokat, hogy az új konténerekre is érvényes legyen a névfeloldás."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reporniți serviciile pentru a aplica rezolvarea numelor pentru containerele noi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Рестартирайте услугите, за да се приложи разрешаването на имена за новите контейнери."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επανεκκινήστε τις υπηρεσίες για να εφαρμοστεί η ανάλυση ονομάτων στα νέα κοντέινερ."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno pokrenite servise kako bi se razrješavanje naziva primijenilo na nove kontejnere."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znova zaženite storitve, da bo razreševanje imen veljalo za nove vsebnike."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Поново покрените сервисе да би се разрешавање имена применило на нове контејнере."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovo pokrenite servise da bi se razrešavanje imena primenilo na nove kontejnere."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Paleiskite paslaugas iš naujo, kad naujiems konteineriams būtų taikomas vardų nustatymas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Restartējiet pakalpojumus, lai jauniem konteineriem lietotu nosaukumu atrisināšanu."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Taaskäivitage teenused, et uute konteinerite nimelahendus rakenduks."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезапустіть служби, щоб розпізнавання імен діяло для нових контейнерів."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезапустите службы, чтобы разрешение имён работало для новых контейнеров."
          }
        }
      }
    },
