    "Container host names resolve under this domain. Create the domain in Settings first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Container host names resolve under this domain. Create the domain in Settings first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "容器主机名在此域名下解析。请先在设置中创建该域名。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostnamen von Containern werden unter dieser Domain aufgelöst. Erstelle die Domain zuerst in den Einstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms d'hôte des conteneurs sont résolus sous ce domaine. Créez d'abord le domaine dans Réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres de host de los contenedores se resuelven bajo este dominio. Crea primero el dominio en Ajustes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nomi host dei container vengono risolti in questo dominio. Crea prima il dominio in Impostazioni."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nomes de host dos contentores são resolvidos neste domínio. Crie primeiro o domínio nas Definições."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostnamen van containers worden onder dit domein omgezet. Maak het domein eerst aan in Instellingen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Containrarnas värdnamn slås upp under den här domänen. Skapa domänen i Inställningar först."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Containeres værtsnavne slås op under dette domæne. Opret først domænet i Indstillinger."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertsnavn for containere slås opp under dette domenet. Opprett domenet i Innstillinger først."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Konttien isäntänimet selvitetään tämän verkkotunnuksen alla. Luo verkkotunnus ensin Asetuksissa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwy hostów kontenerów są rozwiązywane w tej domenie. Najpierw utwórz domenę w Ustawieniach."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Názvy hostitelů kontejnerů se překládají v této doméně. Nejprve doménu vytvořte v Nastavení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Názvy hostiteľov kontajnerov sa prekladajú v tejto doméne. Najprv doménu vytvorte v Nastaveniach."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A konténerek gazdagépnevei ebben a tartományban oldhatók fel. Előbb hozza létre a tartományt a Beállításokban."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numele de gazdă ale containerelor sunt rezolvate în acest domeniu. Creați mai întâi domeniul în Configurări."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Имената на хостове на контейнерите се разрешават в този домейн. Първо създайте домейна в Настройки."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα ονόματα host των κοντέινερ επιλύονται σε αυτόν τον τομέα. Δημιουργήστε πρώτα τον τομέα στις Ρυθμίσεις."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazivi hostova kontejnera razrješavaju se unutar ove domene. Najprije stvorite domenu u Postavkama."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Imena gostiteljev vsebnikov se razrešujejo v tej domeni. Domeno najprej ustvarite v Nastavitvah."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Имена хостова контејнера се разрешавају у овом домену. Најпре креирајте домен у Подешавањима."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Imena hostova kontejnera se razrešavaju u ovom domenu. Najpre kreirajte domen u Podešavanjima."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Konteinerių DNS vardai nustatomi šiame domene. Pirmiausia sukurkite domeną nustatymuose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Konteineru resursdatoru nosaukumi tiek atrisināti šajā domēnā. Vispirms izveidojiet domēnu iestatījumos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Konteinerite hostinimed lahenduvad selle domeeni all. Looge domeen esmalt seadetes."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імена хостів контейнерів розпізнаються в цьому домені. Спершу створіть домен у Параметрах."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имена хостов контейнеров разрешаются в этом домене. Сначала создайте домен в Настройках."
          }
        }
      }
    },
    "The kernel that “Install Recommended Kernel” downloads.": {
