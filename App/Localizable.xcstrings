    "Downloads the kernel that this apple/container version recommends and makes it the default.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads the kernel that this apple/container version recommends and makes it the default."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载此 apple/container 版本推荐的内核并设为默认内核。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt den Kernel herunter, den diese apple/container-Version empfiehlt, und legt ihn als Standard fest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharge le noyau recommandé par cette version d'apple/container et le définit par défaut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga el kernel que recomienda esta versión de apple/container y lo establece como predeterminado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica il kernel consigliato da questa versione di apple/container e lo imposta come predefinito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarrega o kernel recomendado por esta versão do apple/container e define-o como predefinido."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloadt de kernel die deze versie van apple/container aanbeveelt en maakt deze de standaard."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämtar kärnan som den här versionen av apple/container rekommenderar och gör den till standard."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloader den kerne, som denne version af apple/container anbefaler, og gør den til standard."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Laster ned kjernen som denne versjonen av apple/container anbefaler, og gjør den til standard."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataa ytimen, jota tämä apple/container-versio suosittelee, ja asettaa sen oletukseksi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobiera jądro zalecane przez tę wersję apple/container i ustawia je jako domyślne."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stáhne jádro doporučené touto verzí apple/container a nastaví ho jako výchozí."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiahne jadro, ktoré odporúča táto verzia apple/container, a nastaví ho ako predvolené."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Letölti az ehhez az apple/container verzióhoz ajánlott kernelt, és alapértelmezetté teszi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarcă kernelul recomandat de această versiune apple/container și îl setează ca implicit."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изтегля ядрото, препоръчано за тази версия на apple/container, и го задава по подразбиране."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάνει λήψη του πυρήνα που συνιστά αυτή η έκδοση του apple/container και τον ορίζει ως προεπιλογή."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuzima jezgru koju preporučuje ova verzija apple/container i postavlja je kao zadanu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenese jedro, ki ga priporoča ta različica apple/container, in ga nastavi kot privzeto."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Преузима језгро које препоручује ова верзија apple/container и поставља га као подразумевано."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuzima jezgro koje preporučuje ova verzija apple/container i postavlja ga kao podrazumevano."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atsisiunčia šiai apple/container versijai rekomenduojamą branduolį ir nustato jį numatytuoju."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lejupielādē šai apple/container versijai ieteikto kodolu un iestata to kā noklusējumu."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Laadib alla selle apple/containeri versiooni soovitatud tuuma ja määrab selle vaiketuumaks."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажує ядро, рекомендоване для цієї версії apple/container, і робить його типовим."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скачивает ядро, рекомендованное для этой версии apple/container, и делает его ядром по умолчанию."
          }
        }
      }
    },
