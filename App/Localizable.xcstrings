          "stringUnit": {
            "state": "translated",
            "value": "Image-lag uden tag, der er tilbage fra genopbygninger."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Image-lag uten tagg som er til overs etter nye bygginger."
          }
        },
