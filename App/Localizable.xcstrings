    "Return blocks freed inside running containers and their volumes to macOS.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return blocks freed inside running containers and their volumes to macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将运行中容器及其卷内已释放的磁盘块归还给 macOS。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blöcke, die in laufenden Containern und ihren Volumes freigegeben wurden, an macOS zurückgeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendre à macOS les blocs libérés dans les conteneurs en cours d'exécution et leurs volumes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Devolver a macOS los bloques liberados dentro de los contenedores en ejecución y sus volúmenes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restituisci a macOS i blocchi liberati all'interno dei container in esecuzione e dei loro volumi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Devolver ao macOS os blocos libertados dentro dos contentores em execução e dos respetivos volumes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef blokken die in actieve containers en hun volumes zijn vrijgemaakt terug aan macOS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återlämna block som frigjorts i containrar som körs och deras volymer till macOS."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Returner blokke, der er frigjort i kørende containere og deres volumes, til macOS."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi frigjorte blokker i kjørende containere og volumene deres tilbake til macOS."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palauta käynnissä olevien konttien ja niiden taltioiden sisällä vapautuneet lohkot macOS:lle."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwróć do macOS bloki zwolnione w uruchomionych kontenerach i ich woluminach."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrátit systému macOS bloky uvolněné uvnitř spuštěných kontejnerů a jejich svazků."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vráti do macOS bloky uvoľnené v spustených kontajneroch a ich zväzkoch."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A futó konténerekben és köteteikben felszabadult blokkok visszaadása a macOS-nek."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Returnează către macOS blocurile eliberate din containerele în execuție și din volumele lor."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Връща на macOS блоковете, освободени в работещите контейнери и техните томове."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιστρέφει στο macOS τα μπλοκ που ελευθερώθηκαν μέσα σε κοντέινερ σε εκτέλεση και στους τόμους τους."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraća macOS-u blokove oslobođene unutar pokrenutih kontejnera i njihovih volumena."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloke, sproščene v vsebnikih, ki se izvajajo, in njihovih nosilcih, vrne sistemu macOS."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Врати macOS-у блокове ослобођене унутар покренутих контејнера и њихових волумена."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrati macOS-u blokove oslobođene unutar pokrenutih kontejnera i njihovih volumena."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Grąžinti į macOS blokus, atlaisvintus veikiančiuose konteineriuose ir jų tomuose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atgriezt macOS blokus, kas atbrīvoti darbojošos konteineros un to sējumos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagasta töötavates konteinerites ja nende köidetes vabanenud plokid macOS-ile."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернути в macOS блоки, звільнені всередині запущених контейнерів та їхніх томів."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращает в macOS блоки, освобождённые внутри работающих контейнеров и их томов."
          }
        }
      }
    },
