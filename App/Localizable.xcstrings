        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Taikyti ir paleisti iš naujo"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lietot un restartēt"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakenda ja taaskäivita"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосувати й перезапустити"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применить и перезапустить"
          }
        }
      }
    },
    "Applying recreates “%@”. Volumes and bind mounts are kept; the container's writable layer is reset.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying recreates “%@”. Volumes and bind mounts are kept; the container's writable layer is reset."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用更改会重建“%@”。卷与绑定挂载会保留；容器的可写层会被重置。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Anwenden wird „%@“ neu erstellt. Volumes und Bind-Mounts bleiben erhalten; die beschreibbare Ebene des Containers wird zurückgesetzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquer les modifications recrée « %@ ». Les volumes et les montages liés sont conservés ; la couche inscriptible du conteneur est réinitialisée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al aplicar se vuelve a crear “%@”. Los volúmenes y los montajes enlazados se conservan; la capa de escritura del contenedor se restablece."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se applichi le modifiche, “%@” viene ricreato. Volumi e bind mount vengono mantenuti; il livello scrivibile del container viene reimpostato."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar recria “%@”. Os volumes e as montagens de associação são mantidos; a camada gravável do contentor é reposta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toepassen maakt “%@” opnieuw aan. Volumes en bind mounts blijven behouden; de beschrijfbare laag van de container wordt teruggezet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att verkställa återskapar ”%@”. Volymer och bindningsmonteringar behålls; containerns skrivbara lager återställs."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du anvender, oprettes “%@” igen. Volumes og bind-mounts bevares; containerens skrivbare lag nulstilles."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du bruker endringene, opprettes «%@» på nytt. Volumer og bind-monteringer beholdes, men det skrivbare laget i containeren tilbakestilles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutosten käyttäminen luo kontin ”%@” uudelleen. Taltiot ja sidosliitokset säilyvät, mutta kontin kirjoitettava kerros nollataan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastosowanie zmian utworzy kontener „%@” od nowa. Woluminy i montowane katalogi zostaną zachowane, a warstwa zapisywalna kontenera zostanie wyzerowana."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použitím změn se kontejner „%@“ znovu vytvoří. Svazky a bind mounty zůstanou zachovány; zapisovatelná vrstva kontejneru se resetuje."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použitím sa kontajner „%@“ vytvorí znova. Zväzky a bind mounty sa zachovajú; zapisovateľná vrstva kontajnera sa vynuluje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A módosítások alkalmazásakor a(z) „%@” újra létrejön. A kötetek és a bind mountok megmaradnak, a konténer írható rétege alaphelyzetbe áll."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicarea recreează „%@”. Volumele și montările bind sunt păstrate; stratul inscriptibil al containerului este resetat."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Прилагането пресъздава „%@“. Томовете и bind монтиранията се запазват; записваемият слой на контейнера се нулира."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή αναδημιουργεί το «%@». Οι τόμοι και τα bind mount διατηρούνται· το εγγράψιμο επίπεδο του κοντέινερ επαναφέρεται."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Primjena ponovno stvara kontejner „%@”. Volumeni i bind mountovi se zadržavaju, a zapisivi sloj kontejnera se poništava."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporaba znova ustvari vsebnik „%@“. Nosilci in vezni priklopi se ohranijo; zapisljiva plast vsebnika se ponastavi."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Примена поново креира „%@“. Волумени и монтиране фасцикле се задржавају; слој контејнера за упис се ресетује."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Primena ponovo kreira „%@“. Volumeni i montirane fascikle se zadržavaju; sloj kontejnera za upis se resetuje."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pritaikius konteineris „%@“ bus sukurtas iš naujo. Tomai ir susietieji prijungimai išsaugomi; konteinerio rašomasis sluoksnis bus išvalytas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lietojot tiek no jauna izveidots konteiners „%@”. Sējumi un bind montējumi tiek saglabāti; konteinera rakstāmais slānis tiek atiestatīts."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakendamine loob konteineri „%@“ uuesti. Köited ja bind mount'id säilivad, konteineri kirjutatav kiht lähtestatakse."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосування повторно створить «%@». Томи та bind-монтування буде збережено, а записуваний шар контейнера — скинуто."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При применении контейнер «%@» будет пересоздан. Тома и bind-монтирования сохранятся, а записываемый слой контейнера будет сброшен."
          }
        }
      }
    },
    "Applying restarts the machine so the new CPU and memory take effect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying restarts the machine so the new CPU and memory take effect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用后会重启机器，使新的 CPU 与内存设置生效。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Anwenden wird die Maschine neu gestartet, damit die neuen CPU- und Speicherwerte wirksam werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquer les modifications redémarre la machine pour que les nouveaux réglages de CPU et de mémoire prennent effet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al aplicar se reinicia la máquina para que se apliquen los nuevos valores de CPU y memoria."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se applichi le modifiche, la macchina viene riavviata affinché i nuovi valori di CPU e memoria abbiano effetto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar reinicia a máquina para que os novos valores de CPU e memória tenham efeito."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toepassen herstart de machine, zodat de nieuwe CPU- en geheugeninstellingen van kracht worden."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att verkställa startar om maskinen så att den nya CPU- och minnesinställningen börjar gälla."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du anvender, genstarter maskinen, så de nye CPU- og hukommelsesindstillinger træder i kraft."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du bruker endringene, starter maskinen på nytt slik at ny CPU og nytt minne trer i kraft."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutosten käyttäminen käynnistää koneen uudelleen, jotta uudet CPU- ja muistiasetukset tulevat voimaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastosowanie zmian uruchomi ponownie maszynę, aby nowe ustawienia CPU i pamięci zaczęły obowiązywać."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použitím změn se stroj restartuje, aby se projevily nové hodnoty CPU a paměti."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použitím sa stroj reštartuje, aby sa prejavili nové hodnoty CPU a pamäte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A módosítások alkalmazásakor a gép újraindul, hogy az új CPU- és memóriabeállítás érvénybe lépjen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicarea repornește mașina pentru ca noile valori de CPU și memorie să intre în vigoare."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Прилагането рестартира машината, за да влязат в сила новите стойности за CPU и памет."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή επανεκκινεί το μηχάνημα ώστε να ισχύσουν η νέα CPU και η μνήμη."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Primjena ponovno pokreće stroj kako bi novi CPU i memorija stupili na snagu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporaba znova zažene stroj, da začnejo veljati nove nastavitve CPU in pomnilnika."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Примена поново покреће машину да би нови CPU и меморија ступили на снагу."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Primena ponovo pokreće mašinu da bi novi CPU i memorija stupili na snagu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pritaikius mašina bus paleista iš naujo, kad įsigaliotų nauji CPU ir atminties nustatymai."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lietojot mašīna tiek restartēta, lai stātos spēkā jaunie CPU un atmiņas iestatījumi."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakendamine taaskäivitab masina, et uus CPU ja mälu jõustuksid."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосування перезапустить машину, щоб нові параметри CPU і пам’яті набули чинності."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При применении машина перезапустится, чтобы новые значения CPU и памяти вступили в силу."
          }
        }
      }
    },
