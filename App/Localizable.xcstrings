    "Still running on the daemon — check back in a moment.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still running on the daemon — check back in a moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在守护进程上运行 — 请稍后再查看。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft noch auf dem Daemon – schau gleich noch einmal nach."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours en cours sur le daemon — revenez dans un instant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue en ejecución en el daemon; vuelve a mirar en un momento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora in esecuzione sul daemon: ricontrolla tra poco."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda em execução no daemon — volte a verificar daqui a pouco."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draait nog op de daemon — kijk zo meteen nog eens."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Körs fortfarande på daemonen – kom tillbaka om en stund."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kører stadig på daemonen — tjek igen om et øjeblik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjører fortsatt i daemonen — sjekk igjen om et øyeblikk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toiminto on yhä käynnissä daemonissa – tarkista hetken kuluttua."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadal działa w demonie — sprawdź ponownie za chwilę."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stále běží na démonovi – podívejte se za chvíli znovu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na démonovi ešte beží – skontrolujte to o chvíľu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még fut a démonon – nézzen vissza egy kis idő múlva."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă rulează pe daemon — reveniți peste câteva momente."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Все още се изпълнява в демона — проверете отново след малко."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκτελείται ακόμη στον daemon — ελέγξτε ξανά σε λίγο."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još se izvršava na daemonu — provjerite ponovno za trenutak."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na demonu se še izvaja – preverite čez trenutek."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Још ради на демону — проверите поново за тренутак."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Još radi na demonu — proverite ponovo za trenutak."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarnyboje vis dar vykdoma – patikrinkite po akimirkos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Joprojām darbojas dēmonā — pārbaudiet pēc brīža."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Deemonis veel käib — vaadake hetke pärast uuesti."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Демон ще виконує операцію — перевірте трохи згодом."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция ещё выполняется в демоне — проверьте чуть позже."
          }
        }
      }
    },
