    "Data that is not in a volume is lost. Force Remove also stops a running container.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data that is not in a volume is lost. Force Remove also stops a running container."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不在卷中的数据会丢失。强制移除也会停止正在运行的容器。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten, die nicht in einem Volume liegen, gehen verloren. „Entfernen erzwingen“ stoppt auch einen laufenden Container."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données hors d'un volume sont perdues. Forcer la suppression arrête aussi un conteneur en cours d'exécution."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pierden los datos que no estén en un volumen. Forzar eliminación también detiene un contenedor en ejecución."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati che non si trovano in un volume vanno persi. Forza rimozione arresta anche un container in esecuzione."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados que não estão num volume são perdidos. Forçar remoção também faz parar um contentor em execução."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegevens die niet in een volume staan, gaan verloren. “Verwijder geforceerd” stopt ook een actieve container."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Data som inte ligger i en volym går förlorad. Tvinga borttagning stoppar även en container som körs."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Data, der ikke er i et volume, går tabt. Tvangsfjern stopper også en kørende container."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Data som ikke ligger i et volum, går tapt. Tving fjerning stopper også en kjørende container."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedot, jotka eivät ole taltiossa, menetetään. Pakota poisto pysäyttää myös käynnissä olevan kontin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane spoza woluminów zostaną utracone. Wymuś usunięcie zatrzymuje także uruchomiony kontener."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Data, která nejsou ve svazku, budou ztracena. Vynutit odstranění také zastaví spuštěný kontejner."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dáta, ktoré nie sú vo zväzku, sa stratia. Vynútené odstránenie zastaví aj spustený kontajner."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A köteten kívüli adatok elvesznek. A Kényszerített eltávolítás a futó konténert is leállítja."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele care nu sunt într-un volum se pierd. Elimină forțat oprește și un container în execuție."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Данните, които не са в том, ще бъдат изгубени. „Премахни принудително“ спира и работещ контейнер."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα δεδομένα που δεν βρίσκονται σε τόμο χάνονται. Η «Αναγκαστική αφαίρεση» διακόπτει επίσης ένα κοντέινερ σε εκτέλεση."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaci koji nisu u volumenu bit će izgubljeni. Prisilno ukloni također zaustavlja pokrenuti kontejner."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podatki, ki niso v nosilcu, bodo izgubljeni. Prisilno odstrani ustavi tudi vsebnik, ki se izvaja."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Подаци који нису у волумену се губе. „Принудно уклони“ зауставља и покренути контејнер."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaci koji nisu u volumenu se gube. „Prinudno ukloni“ zaustavlja i pokrenuti kontejner."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Duomenys, kurie nėra tome, bus prarasti. „Pašalinti priverstinai“ taip pat sustabdo veikiantį konteinerį."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati, kas neatrodas sējumā, tiek zaudēti. „Noņemt piespiedu kārtā” aptur arī darbojošos konteineru."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Andmed, mis ei ole köites, lähevad kaotsi. „Sundeemalda“ peatab ka töötava konteineri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані, що не зберігаються в томі, буде втрачено. «Вилучити примусово» також зупиняє запущений контейнер."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные вне тома будут потеряны. «Удалить принудительно» также останавливает работающий контейнер."
          }
        }
      }
    },
