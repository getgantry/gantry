    "The builder, registry logins, service logs and system properties are in the System section of the apple/container host in the sidebar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The builder, registry logins, service logs and system properties are in the System section of the apple/container host in the sidebar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "构建器、镜像仓库登录、服务日志和系统属性位于边栏中 apple/container 主机的“系统”部分。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Builder, Registry-Anmeldungen, Dienst-Logs und Systemeigenschaften befinden sich im Bereich „System“ des apple/container-Hosts in der Seitenleiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le builder, les connexions aux registres, les journaux des services et les propriétés système se trouvent dans la section Système de l'hôte apple/container, dans la barre latérale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El builder, las sesiones en registros, los logs de servicios y las propiedades del sistema están en la sección Sistema del host de apple/container, en la barra lateral."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Builder, accessi ai registri, log dei servizi e proprietà di sistema si trovano nella sezione Sistema dell'host apple/container nella barra laterale."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O builder, as sessões em registos, os logs dos serviços e as propriedades de sistema estão na secção Sistema do host apple/container, na barra lateral."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De builder, registry-aanmeldingen, servicelogs en systeemeigenschappen staan in de sectie Systeem van de apple/container-host in de navigatiekolom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byggaren, registerinloggningar, tjänsteloggar och systemegenskaper finns i avsnittet System för apple/container-värden i sidofältet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Builderen, registry-logins, tjenestelogge og systemegenskaber findes i sektionen System for apple/container-værten i indholdsoversigten."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Byggeren, registerpåloggingene, tjenesteloggene og systemegenskapene finner du i System-seksjonen for apple/container-verten i sidepanelet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koontityökalu, rekisterikirjautumiset, palvelulokit ja järjestelmäominaisuudet löytyvät sivupalkista apple/container-isännän Järjestelmä-osiosta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Builder, logowania do rejestrów, logi usług i właściwości systemowe znajdują się w sekcji System hosta apple/container na pasku bocznym."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Builder, přihlášení k registrům, logy služeb a systémové vlastnosti najdete v sekci Systém hostitele apple/container v postranním panelu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Builder, prihlásenia do registrov, logy služieb a systémové vlastnosti nájdete v sekcii Systém hostiteľa apple/container v bočnom paneli."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A builder, a registry-bejelentkezések, a szolgáltatásnaplók és a rendszertulajdonságok az oldalsávon, az apple/container gazdagép Rendszer szakaszában találhatók."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Builderul, autentificările la registre, jurnalele serviciilor și proprietățile de sistem se află în secțiunea Sistem a gazdei apple/container din bara laterală."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Билдърът, влизанията в регистри, логовете на услугите и системните свойства са в раздела „Система“ на хоста на apple/container в страничната лента."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο builder, οι συνδέσεις σε μητρώα, τα αρχεία καταγραφής υπηρεσιών και οι ιδιότητες συστήματος βρίσκονται στην ενότητα «Σύστημα» του host apple/container στην πλαϊνή στήλη."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Builder, prijave u registre, zapisnici servisa i svojstva sustava nalaze se u odjeljku Sustav hosta apple/container u bočnoj traci."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Graditelj, prijave v registre, dnevniki storitev in sistemske lastnosti so v razdelku Sistem gostitelja apple/container v stranski vrstici."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Билдер, пријаве на регистре, логови сервиса и системска својства налазе се у одељку Систем хоста apple/container у бочној траци."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder, prijave na registre, logovi servisa i sistemska svojstva nalaze se u odeljku Sistem hosta apple/container u bočnoj traci."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kūrimo įrankis, prisijungimai prie registrų, paslaugų žurnalai ir sistemos savybės yra šoninės juostos apple/container serverio skyriuje „Sistema“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Būvētājs, pieteikšanās reģistros, pakalpojumu žurnāli un sistēmas rekvizīti atrodas apple/container resursdatora sadaļā „Sistēma” sānjoslā."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Koostaja, registritesse sisselogimised, teenuste logid ja süsteemiatribuudid asuvad külgribal apple/containeri hosti jaotises Süsteem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збирач, входи в реєстри, журнали служб і системні властивості містяться в розділі «Система» хоста apple/container на боковій панелі."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сборщик, входы в реестры, логи служб и системные свойства находятся в разделе «Система» хоста apple/container в боковом меню."
          }
        }
      }
    },
