    "%@ is now in the nodes of the cluster “%@”. Use imagePullPolicy: Never or IfNotPresent in your pods.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is now in the nodes of the cluster “%@”. Use imagePullPolicy: Never or IfNotPresent in your pods."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已载入集群“%@”的节点。请在 Pod 中使用 imagePullPolicy: Never 或 IfNotPresent。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist jetzt auf den Nodes des Clusters „%@“. Verwende in deinen Pods imagePullPolicy: Never oder IfNotPresent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se trouve maintenant dans les nœuds du cluster « %@ ». Utilisez imagePullPolicy: Never ou IfNotPresent dans vos pods."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya está en los nodos del clúster “%@”. Usa imagePullPolicy: Never o IfNotPresent en tus pods."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è ora nei nodi del cluster “%@”. Usa imagePullPolicy: Never o IfNotPresent nei tuoi pod."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está agora nos nós do cluster “%@”. Utilize imagePullPolicy: Never ou IfNotPresent nos seus pods."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ staat nu op de nodes van het cluster “%@”. Gebruik imagePullPolicy: Never of IfNotPresent in je pods."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ finns nu på noderna i klustret ”%@”. Använd imagePullPolicy: Never eller IfNotPresent i dina poddar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er nu på noderne i klyngen “%@”. Brug imagePullPolicy: Never eller IfNotPresent i dine pods."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er nå i nodene i klyngen «%@». Bruk imagePullPolicy: Never eller IfNotPresent i podene dine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on nyt klusterin ”%@” solmuissa. Käytä podeissasi asetusta imagePullPolicy: Never tai IfNotPresent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obraz %@ jest teraz na węzłach klastra „%@”. W podach użyj imagePullPolicy: Never lub IfNotPresent."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Image %@ je nyní v uzlech clusteru „%@“. V podech použijte imagePullPolicy: Never nebo IfNotPresent."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obraz %@ je teraz v uzloch klastra „%@“. V podoch použite imagePullPolicy: Never alebo IfNotPresent."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ már a(z) „%@” klaszter csomópontjain van. A podokban használja az imagePullPolicy: Never vagy IfNotPresent beállítást."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se află acum pe nodurile clusterului „%@”. Folosiți imagePullPolicy: Never sau IfNotPresent în podurile dvs."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ вече е във възлите на клъстера „%@“. Използвайте imagePullPolicy: Never или IfNotPresent във вашите подове."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εικόνα %1$@ βρίσκεται πλέον στους κόμβους του cluster «%2$@». Χρησιμοποιήστε imagePullPolicy: Never ή IfNotPresent στα pod σας."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slika %@ sada je na čvorovima klastera „%@”. U podovima koristite imagePullPolicy: Never ili IfNotPresent."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slika %@ je zdaj na vozliščih gruče „%@“. V podih uporabite imagePullPolicy: Never ali IfNotPresent."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ је сада на чворовима кластера „%@“. У подовима користите imagePullPolicy: Never или IfNotPresent."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je sada na čvorovima klastera „%@“. U podovima koristite imagePullPolicy: Never ili IfNotPresent."
