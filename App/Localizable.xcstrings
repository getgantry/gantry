    "Attaches a toolbox with curl, ps, ip and friends — works even without a shell in the image.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attaches a toolbox with curl, ps, ip and friends — works even without a shell in the image."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挂载包含 curl、ps、ip 等工具的工具箱 — 即使镜像中没有 shell 也能使用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hängt eine Toolbox mit curl, ps, ip und mehr an – funktioniert auch ohne Shell im Image."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attache une boîte à outils avec curl, ps, ip et compagnie — fonctionne même sans shell dans l'image."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta una caja de herramientas con curl, ps, ip y demás; funciona incluso si la imagen no tiene shell."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega un set di strumenti con curl, ps, ip e simili: funziona anche se l'immagine non ha una shell."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Associa uma caixa de ferramentas com curl, ps, ip e afins — funciona mesmo sem shell na imagem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppelt een toolbox met curl, ps, ip en meer — werkt ook zonder shell in de image."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopplar på en verktygslåda med curl, ps, ip med flera – fungerar även utan skal i imagen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilknytter en værktøjskasse med curl, ps, ip m.fl. — virker også uden en shell i imaget."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legger til en verktøykasse med curl, ps, ip og lignende — fungerer selv uten et skall i imaget."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liittää työkalupaketin (curl, ps, ip ym.) – toimii, vaikka levykuvassa ei olisi komentotulkkia."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dołącza zestaw narzędzi z curl, ps, ip i innymi — działa nawet wtedy, gdy obraz nie ma powłoki."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojí sadu nástrojů s curl, ps, ip a dalšími – funguje i bez shellu v image."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripojí sadu nástrojov s curl, ps, ip a ďalšími – funguje aj bez shellu v obraze."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csatol egy eszközkészletet curl, ps, ip és hasonló eszközökkel – akkor is működik, ha az image-ben nincs shell."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atașează o trusă de instrumente cu curl, ps, ip și altele — funcționează chiar și fără shell în imagine."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Прикачва набор инструменти с curl, ps, ip и други — работи дори когато в образа няма обвивка."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσαρτά μια εργαλειοθήκη με curl, ps, ip και άλλα — λειτουργεί ακόμη και χωρίς shell στην εικόνα."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Priključuje alate curl, ps, ip i druge — radi i kad slika nema ljusku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripne orodjarno s curl, ps, ip in drugimi orodji – deluje tudi, če slika nima lupine."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Прикључује комплет алата са curl, ps, ip и сличним — ради чак и када слика нема љуску."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Priključuje komplet alata sa curl, ps, ip i sličnim — radi čak i kada slika nema ljusku."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijungia įrankių rinkinį su curl, ps, ip ir kitais įrankiais – veikia net jei atvaizde nėra apvalkalo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pievieno rīku komplektu ar curl, ps, ip u.c. — darbojas pat tad, ja attēlā nav čaulas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisab tööriistakasti (curl, ps, ip jt) — töötab ka siis, kui tõmmises pole shelli."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під’єднує набір інструментів із curl, ps, ip тощо — працює, навіть якщо в образі немає оболонки."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключает набор инструментов с curl, ps, ip и другими утилитами — работает, даже если в образе нет оболочки."
          }
        }
      }
    },
