    "Override the unix socket path for the local host. Leave empty to auto-detect. The override is stored on the Local host and applied on reconnect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Override the unix socket path for the local host. Leave empty to auto-detect. The override is stored on the Local host and applied on reconnect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "覆盖本地主机的 Unix 套接字路径。留空则自动检测。覆盖值保存在 Local 主机上，并在重新连接时应用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unix-Socket-Pfad für den lokalen Host überschreiben. Leer lassen für automatische Erkennung. Der Wert wird beim lokalen Host gespeichert und beim erneuten Verbinden angewendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacez le chemin du socket Unix de l'hôte local. Laissez vide pour la détection automatique. La valeur est enregistrée sur l'hôte local et appliquée à la reconnexion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustituye la ruta del socket Unix del host local. Déjala vacía para detectarla automáticamente. El valor se guarda en el host local y se aplica al volver a conectar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovrascrivi il percorso del socket Unix per l'host locale. Lascia vuoto per il rilevamento automatico. Il valore viene salvato sull'host locale e applicato alla riconnessione."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitua o caminho do socket Unix do host local. Deixe vazio para deteção automática. O valor é guardado no host local e aplicado ao voltar a ligar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Overschrijf het pad van de unix-socket voor de lokale host. Laat leeg om automatisch te detecteren. De overschrijving wordt bij de lokale host bewaard en toegepast bij opnieuw verbinden."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Åsidosätt unix-socketens sökväg för den lokala värden. Lämna tomt för att identifiera automatiskt. Åsidosättningen sparas på den lokala värden och tillämpas vid återanslutning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilsidesæt stien til Unix-socketten for den lokale vært. Lad feltet stå tomt for at finde den automatisk. Tilsidesættelsen gemmes på den lokale vært og anvendes, når der oprettes forbindelse igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Overstyr banen til unix-socketen for den lokale verten. La feltet stå tomt for automatisk gjenkjenning. Overstyringen lagres på den lokale verten og brukes ved ny tilkobling."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohita paikallisen isännän unix-socketin polku. Jätä tyhjäksi, niin polku tunnistetaan automaattisesti. Ohitus tallennetaan paikalliseen isäntään ja otetaan käyttöön uudelleenyhdistettäessä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadpisz ścieżkę gniazda unix dla hosta lokalnego. Pozostaw puste, aby wykryć automatycznie. Ustawienie jest zapisywane w ustawieniach hosta lokalnego i stosowane przy ponownym połączeniu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepíše cestu k unixovému socketu pro místního hostitele. Pro automatické rozpoznání nechte prázdné. Přepsání se uloží u místního hostitele a použije se při opětovném připojení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepíše cestu k unixovému soketu pre lokálneho hostiteľa. Ak chcete automatické rozpoznanie, nechajte prázdne. Nastavenie sa uloží v lokálnom hostiteľovi a použije sa pri opätovnom pripojení."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helyi gazdagép unix socket útvonalának felülírása. Az automatikus észleléshez hagyja üresen. A felülírást a Helyi gazdagép tárolja, és újracsatlakozáskor alkalmazza."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Suprascrieți calea socketului Unix pentru gazda locală. Lăsați gol pentru detectare automată. Valoarea este salvată pe gazda locală și aplicată la reconectare."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте друг път на unix сокета за локалния хост. Оставете празно за автоматично откриване. Стойността се запазва в хоста „Локален“ и се прилага при повторно свързване."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παράκαμψη της διαδρομής unix socket για τον τοπικό host. Αφήστε κενό για αυτόματο εντοπισμό. Η παράκαμψη αποθηκεύεται στον τοπικό host και εφαρμόζεται κατά την επανασύνδεση."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadjačajte putanju unix utičnice za lokalni host. Ostavite prazno za automatsko otkrivanje. Nadjačana vrijednost sprema se uz lokalni host i primjenjuje pri ponovnom povezivanju."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preglasi pot vtičnice unix za lokalnega gostitelja. Pustite prazno za samodejno zaznavanje. Preglasitev se shrani pri lokalnem gostitelju in uporabi ob ponovni povezavi."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Замените путању unix сокета за локални хост. Оставите празно за аутоматско откривање. Замена се чува на локалном хосту и примењује при поновном повезивању."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamenite putanju unix soketa za lokalni host. Ostavite prazno za automatsko otkrivanje. Zamena se čuva na lokalnom hostu i primenjuje pri ponovnom povezivanju."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nustatykite kitą vietinio serverio unix lizdo kelią. Palikite tuščią, kad būtų aptiktas automatiškai. Nustatymas saugomas vietiniame serveryje ir pritaikomas prisijungiant iš naujo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aizstāt lokālā resursdatora unix ligzdas ceļu. Atstājiet tukšu, lai noteiktu automātiski. Aizstājējvērtība tiek saglabāta lokālajā resursdatorā un lietota, atkārtoti savienojoties."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Määrake kohaliku hosti unix-sokli tee. Automaatseks tuvastamiseks jätke tühjaks. Määrang salvestatakse kohaliku hosti juurde ja rakendub uuesti ühendamisel."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевизначте шлях до unix-сокета для локального хоста. Залиште поле порожнім, щоб визначати його автоматично. Перевизначення зберігається для хоста Local і застосовується під час повторного під’єднання."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переопределите путь к unix-сокету для локального хоста. Оставьте поле пустым, чтобы путь определялся автоматически. Значение хранится в настройках локального хоста и применяется при повторном подключении."
          }
        }
      }
    },
