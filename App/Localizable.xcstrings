    "The nodes that this creation made so far are deleted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The nodes that this creation made so far are deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此次创建已生成的节点将被删除。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nodes, die diese Erstellung bisher angelegt hat, werden gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nœuds créés jusqu'ici par cette opération sont supprimés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan los nodos que esta creación ha generado hasta ahora."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nodi creati finora da questa operazione vengono eliminati."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nós criados até agora por esta operação são eliminados."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De nodes die tot nu toe bij het aanmaken zijn gemaakt, worden verwijderd."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De noder som har skapats hittills raderas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De noder, som denne oprettelse har lavet indtil nu, slettes."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodene som denne opprettingen har laget så langt, slettes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tähän mennessä luodut solmut poistetaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Węzły utworzone dotąd w tym procesie zostaną usunięte."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzly, které toto vytváření dosud vytvořilo, budou smazány."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzly, ktoré toto vytváranie doteraz vytvorilo, sa vymažú."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eddig létrehozott csomópontok törlődnek."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodurile create până acum de această operațiune sunt șterse."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Възлите, създадени досега от този процес, ще бъдат изтрити."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράφονται οι κόμβοι που έχει δημιουργήσει μέχρι τώρα αυτή η διαδικασία."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brišu se čvorovi koje je ovo stvaranje dosad napravilo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vozlišča, ki jih je to ustvarjanje doslej ustvarilo, bodo izbrisana."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Чворови које је ово креирање до сада направило се бришу."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Čvorovi koje je ovo kreiranje do sada napravilo se brišu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ištrinami iki šiol šio kūrimo metu sukurti mazgai."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiek dzēsti mezgli, kas līdz šim izveidoti šīs izveides laikā."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kustutatakse sõlmed, mille see loomine seni lõi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вузли, створені до цього моменту, буде видалено."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узлы, которые уже успели создаться, будут удалены."
          }
        }
      }
    },
    "The password or passphrase is deleted from the Keychain. Gantry asks for it on the next connection.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The password or passphrase is deleted from the Keychain. Gantry asks for it on the next connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码或密钥口令将从钥匙串中删除。下次连接时 Gantry 会再次询问。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Passwort oder die Passphrase wird aus dem Schlüsselbund gelöscht. Gantry fragt bei der nächsten Verbindung erneut danach."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe ou la phrase secrète est supprimé du trousseau. Gantry vous le redemandera à la prochaine connexion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña o la frase de contraseña se elimina del llavero. Gantry te la pedirá en la próxima conexión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La password o la passphrase viene eliminata dal portachiavi. Gantry la richiederà alla prossima connessione."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A palavra-passe ou a frase-passe é eliminada do porta-chaves. O Gantry vai pedi-la na próxima ligação."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het wachtwoord of de wachtwoordzin wordt uit de sleutelhanger verwijderd. Gantry vraagt er bij de volgende verbinding opnieuw om."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösenordet eller lösenfrasen raderas från nyckelringen. Gantry frågar efter det vid nästa anslutning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgangskoden eller adgangsudtrykket slettes fra nøgleringen. Gantry beder om det ved næste forbindelse."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Passordet eller passordfrasen slettes fra nøkkelringen. Gantry spør etter det ved neste tilkobling."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salasana tai tunnuslause poistetaan Avainnipusta. Gantry kysyy sitä, kun yhdistät seuraavan kerran."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasło lub hasło klucza zostanie usunięte z pęku kluczy. Gantry poprosi o nie przy następnym połączeniu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Heslo nebo heslo ke klíči bude smazáno z Klíčenky. Gantry si o něj řekne při příštím připojení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Heslo alebo prístupová fráza sa vymaže z Kľúčenky. Gantry si ich vyžiada pri ďalšom pripojení."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelszó vagy jelmondat törlődik a Kulcskarikából. A Gantry a következő csatlakozáskor újra elkéri."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola sau fraza de acces este ștearsă din portchei. Gantry o va cere la următoarea conectare."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Паролата или паролата за ключа ще бъде изтрита от Ключодържателя. Gantry ще я поиска при следващото свързване."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το συνθηματικό ή η φράση πρόσβασης διαγράφεται από την Κλειδοθήκη. Το Gantry θα το ζητήσει στην επόμενη σύνδεση."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lozinka ili lozinka ključa briše se iz Privjeska ključeva. Gantry će je zatražiti pri sljedećem povezivanju."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geslo ali geslo ključa bo izbrisano iz obeska za ključe. Gantry ga bo zahteval ob naslednji povezavi."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Лозинка или приступна фраза се брише из привеска за кључеве. Gantry ће је тражити при следећем повезивању."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Lozinka ili pristupna fraza se briše iz priveska za ključeve. Gantry će je tražiti pri sledećem povezivanju."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaptažodis arba slaptafrazė ištrinami iš raktinės. Gantry jo paprašys kito prisijungimo metu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Parole vai ieejas frāze tiek dzēsta no atslēgu piekariņa. Gantry to pieprasīs nākamajā savienojuma reizē."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Parool või võtme parool kustutatakse võtmerõngast. Gantry küsib seda järgmisel ühendamisel."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль або парольну фразу буде видалено з В’язки ключів. Gantry запитає їх під час наступного під’єднання."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль или парольная фраза будут удалены из Связки ключей. Gantry запросит их при следующем подключении."
          }
        }
      }
    },
    "The pull keeps running. Follow it in Activity.": {
