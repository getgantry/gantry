          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изтеглянето продължава. Следете го в „Активност“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η λήψη συνεχίζεται. Παρακολουθήστε τη στη Δραστηριότητα."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povlačenje se nastavlja. Pratite ga u odjeljku Aktivnost."
