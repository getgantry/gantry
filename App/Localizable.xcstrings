    "Route a hostname on a domain in your Cloudflare account to this port. Requires a one-time login.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Route a hostname on a domain in your Cloudflare account to this port. Requires a one-time login."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Cloudflare 账户中某域名上的主机名路由到此端口。需要一次性登录。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Hostnamen in einer Domain deines Cloudflare-Accounts an diesen Port leiten. Erfordert eine einmalige Anmeldung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associer un nom d'hôte d'un domaine de votre compte Cloudflare à ce port. Nécessite une connexion unique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirige un nombre de host de un dominio de tu cuenta de Cloudflare a este puerto. Requiere iniciar sesión una vez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrada a questa porta un nome host di un dominio del tuo account Cloudflare. Richiede un accesso una tantum."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaminhe um nome de host de um domínio da sua conta Cloudflare para esta porta. Requer um início de sessão único."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Routeer een hostnaam op een domein in je Cloudflare-account naar deze poort. Vereist eenmalig inloggen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirigera ett värdnamn på en domän i ditt Cloudflare-konto till den här porten. Kräver en engångsinloggning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Omdiriger et værtsnavn på et domæne i din Cloudflare-konto til denne port. Kræver et engangslogin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble et vertsnavn på et domene i Cloudflare-kontoen din til denne porten. Krever pålogging én gang."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohjaa Cloudflare-tilisi verkkotunnuksen isäntänimi tähän porttiin. Vaatii kertakirjautumisen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skieruj nazwę hosta w domenie na koncie Cloudflare na ten port. Wymaga jednorazowego zalogowania."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Směrujte název hostitele v doméně vašeho účtu Cloudflare na tento port. Vyžaduje jednorázové přihlášení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasmerujte názov hostiteľa v doméne vo vašom účte Cloudflare na tento port. Vyžaduje jednorazové prihlásenie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy Cloudflare-fiókjához tartozó tartomány gazdagépnevének átirányítása erre a portra. Egyszeri bejelentkezést igényel."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Direcționează către acest port un nume de gazdă de pe un domeniu din contul dvs. Cloudflare. Necesită o singură autentificare."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Насочете име на хост от домейн във вашия акаунт в Cloudflare към този порт. Изисква еднократно влизане."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δρομολογήστε ένα όνομα host σε τομέα του λογαριασμού σας Cloudflare προς αυτή τη θύρα. Απαιτείται εφάπαξ σύνδεση."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Usmjerite naziv hosta na domeni u vašem Cloudflare računu na ovaj port. Potrebna je jednokratna prijava."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preusmeri ime gostitelja v domeni vašega računa Cloudflare na ta vrata. Zahteva enkratno prijavo."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Усмерите име хоста на домену у вашем Cloudflare налогу на овај порт. Потребна је једнократна пријава."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Usmerite ime hosta na domenu u vašem Cloudflare nalogu na ovaj port. Potrebna je jednokratna prijava."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nukreipkite vardą (hostname) jūsų Cloudflare paskyros domene į šį prievadą. Reikia vieną kartą prisijungti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Novirzīt uz šo portu resursdatora nosaukumu jūsu Cloudflare konta domēnā. Nepieciešama vienreizēja pieteikšanās."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Suunake teie Cloudflare'i konto domeeni hostinimi sellesse porti. Nõuab ühekordset sisselogimist."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спрямувати на цей порт ім’я хоста в домені вашого облікового запису Cloudflare. Потрібно один раз увійти."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Направить имя хоста в домене вашей учётной записи Cloudflare на этот порт. Нужно один раз войти в учётную запись."
          }
        }
      }
    },
