    "To reach cluster services from macOS, run a gateway container on the same network, for example: container run -d --name gateway --network %@,alias=.gateway …": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To reach cluster services from macOS, run a gateway container on the same network, for example: container run -d --name gateway --network %@,alias=.gateway …"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要从 macOS 访问集群服务，请在同一网络上运行网关容器，例如：container run -d --name gateway --network %@,alias=.gateway …"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Clusterdienste von macOS aus zu erreichen, führe einen Gateway-Container im selben Netzwerk aus, zum Beispiel: container run -d --name gateway --network %@,alias=.gateway …"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour accéder aux services du cluster depuis macOS, exécutez un conteneur passerelle sur le même réseau, par exemple : container run -d --name gateway --network %@,alias=.gateway …"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para acceder a los servicios del clúster desde macOS, ejecuta un contenedor de pasarela en la misma red, por ejemplo: container run -d --name gateway --network %@,alias=.gateway …"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per raggiungere i servizi del cluster da macOS, esegui un container gateway sulla stessa rete, ad esempio: container run -d --name gateway --network %@,alias=.gateway …"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para aceder aos serviços do cluster a partir do macOS, execute um contentor gateway na mesma rede, por exemplo: container run -d --name gateway --network %@,alias=.gateway …"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer om clusterservices vanuit macOS te bereiken een gatewaycontainer uit op hetzelfde netwerk, bijvoorbeeld: container run -d --name gateway --network %@,alias=.gateway …"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att nå klustertjänster från macOS kör du en gateway-container i samma nätverk, till exempel: container run -d --name gateway --network %@,alias=.gateway …"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at nå klyngetjenester fra macOS skal du køre en gateway-container på samme netværk, f.eks.: container run -d --name gateway --network %@,alias=.gateway …"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å nå klyngetjenester fra macOS kan du kjøre en gateway-container på samme nettverk, for eksempel: container run -d --name gateway --network %@,alias=.gateway …"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos haluat tavoittaa klusterin palvelut macOS:stä, suorita yhdyskäytäväkontti samassa verkossa, esimerkiksi: container run -d --name gateway --network %@,alias=.gateway …"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby łączyć się z usługami klastra z macOS, uruchom kontener bramy w tej samej sieci, na przykład: container run -d --name gateway --network %@,alias=.gateway …"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li se ke službám clusteru dostat z macOS, spusťte ve stejné síti kontejner brány, například: container run -d --name gateway --network %@,alias=.gateway …"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete služby klastra používať z macOS, spustite v tej istej sieti kontajner brány, napríklad: container run -d --name gateway --network %@,alias=.gateway …"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A klaszter szolgáltatásainak macOS-ről való eléréséhez futtasson egy átjáró-konténert ugyanazon a hálózaton, például: container run -d --name gateway --network %@,alias=.gateway …"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a accesa serviciile clusterului din macOS, rulați un container gateway în aceeași rețea, de exemplu: container run -d --name gateway --network %@,alias=.gateway …"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За да достъпвате услугите на клъстера от macOS, стартирайте контейнер шлюз в същата мрежа, например: container run -d --name gateway --network %@,alias=.gateway …"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για πρόσβαση στις υπηρεσίες του cluster από το macOS, εκτελέστε ένα κοντέινερ πύλης στο ίδιο δίκτυο, για παράδειγμα: container run -d --name gateway --network %@,alias=.gateway …"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za pristup servisima klastera iz macOS-a pokrenite kontejner pristupnika na istoj mreži, na primjer: container run -d --name gateway --network %@,alias=.gateway …"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za dostop do storitev gruče iz sistema macOS zaženite prehodni vsebnik v istem omrežju, na primer: container run -d --name gateway --network %@,alias=.gateway …"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Да бисте из macOS-а приступили сервисима кластера, покрените контејнер мрежног пролаза у истој мрежи, на пример: container run -d --name gateway --network %@,alias=.gateway …"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Da biste iz macOS-a pristupili servisima klastera, pokrenite kontejner mrežnog prolaza u istoj mreži, na primer: container run -d --name gateway --network %@,alias=.gateway …"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Norėdami pasiekti klasterio paslaugas iš macOS, tame pačiame tinkle paleiskite šliuzo konteinerį, pavyzdžiui: container run -d --name gateway --network %@,alias=.gateway …"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai piekļūtu klastera pakalpojumiem no macOS, palaidiet vārtejas konteineru tajā pašā tīklā, piemēram: container run -d --name gateway --network %@,alias=.gateway …"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klastri teenustele macOS-ist pääsemiseks käivitage samas võrgus lüüsikonteiner, näiteks: container run -d --name gateway --network %@,alias=.gateway …"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб звертатися до служб кластера з macOS, запустіть контейнер-шлюз у тій самій мережі, наприклад: container run -d --name gateway --network %@,alias=.gateway …"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы обращаться к сервисам кластера из macOS, запустите контейнер-шлюз в той же сети, например: container run -d --name gateway --network %@,alias=.gateway …"
          }
        }
      }
    },
