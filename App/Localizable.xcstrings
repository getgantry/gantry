    "Log in to a registry to push images and pull private images with apple/container.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in to a registry to push images and pull private images with apple/container."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
