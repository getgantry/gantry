    "Lists the containers on a Docker host, with a summary of how many are running and stopped.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists the containers on a Docker host, with a summary of how many are running and stopped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列出 Docker 主机上的容器，并汇总运行中与已停止的数量。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Listet die Container auf einem Docker-Host auf, mit einer Übersicht, wie viele laufen und wie viele gestoppt sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste les conteneurs d'un hôte Docker, avec le nombre de conteneurs en cours d'exécution et arrêtés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista los contenedores de un host de Docker, con un resumen de cuántos están en ejecución y cuántos detenidos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elenca i container su un host Docker, con un riepilogo di quanti sono in esecuzione e quanti arrestati."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista os contentores num host Docker, com um resumo de quantos estão em execução e parados."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont de containers op een Docker-host, met een overzicht van hoeveel er actief en gestopt zijn."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Listar containrarna på en Docker-värd med en sammanfattning av hur många som körs och är stoppade."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser containerne på en Docker-vært med en oversigt over, hvor mange der kører og er stoppet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lister opp containerne på en Docker-vert, med en oppsummering av hvor mange som kjører og hvor mange som er stoppet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luettelee Docker-isännän kontit ja yhteenvedon käynnissä olevien ja pysäytettyjen määrästä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetla kontenery na hoście Docker wraz z podsumowaniem liczby uruchomionych i zatrzymanych."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypíše kontejnery na hostiteli Docker se souhrnem, kolik jich běží a kolik je zastavených."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypíše kontajnery na hostiteľovi Docker so súhrnom, koľko z nich je spustených a zastavených."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Listázza a Docker-gazdagép konténereit, összesítve, hány fut és hány van leállítva."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Listează containerele de pe o gazdă Docker, cu un rezumat al celor care rulează și al celor oprite."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Показва контейнерите на хост на Docker с обобщение колко работят и колко са спрени."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει τα κοντέινερ ενός host Docker, με σύνοψη για το πόσα εκτελούνται και πόσα έχουν διακοπεί."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje kontejnere na Docker hostu sa sažetkom koliko ih je pokrenuto, a koliko zaustavljeno."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaže vsebnike na gostitelju Docker s povzetkom, koliko se jih izvaja in koliko je ustavljenih."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Приказује контејнере на Docker хосту, са прегледом колико их је покренуто и заустављено."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje kontejnere na Docker hostu, sa pregledom koliko ih je pokrenuto i zaustavljeno."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Išvardija Docker serverio konteinerius ir pateikia, kiek jų veikia ir kiek sustabdyta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Parāda Docker resursdatora konteinerus un kopsavilkumu par to, cik darbojas un cik ir apturēti."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loetleb Dockeri hosti konteinerid ja näitab, mitu neist töötab ja mitu on peatatud."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує контейнери на хості Docker і підсумок: скільки запущено та скільки зупинено."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выводит список контейнеров на хосте Docker и показывает, сколько из них работает и сколько остановлено."
          }
        }
      }
