    "The Dockerfile must live inside the build context.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Dockerfile must live inside the build context."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockerfile 必须位于构建上下文内。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dockerfile muss sich im Build-Kontext befinden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Dockerfile doit se trouver dans le contexte de build."
          }
        },
        "es": {
