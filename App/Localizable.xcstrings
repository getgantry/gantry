    "Create a local Kubernetes cluster. Each node runs in its own lightweight VM.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a local Kubernetes cluster. Each node runs in its own lightweight VM."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建本地 Kubernetes 集群。每个节点运行在自己的轻量虚拟机中。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle einen lokalen Kubernetes-Cluster. Jeder Node läuft in einer eigenen leichtgewichtigen VM."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un cluster Kubernetes local. Chaque nœud s'exécute dans sa propre VM légère."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un clúster de Kubernetes local. Cada nodo se ejecuta en su propia VM ligera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un cluster Kubernetes locale. Ogni nodo viene eseguito in una propria VM leggera."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie um cluster Kubernetes local. Cada nó é executado na sua própria VM leve."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een lokaal Kubernetes-cluster aan. Elke node draait in een eigen lichtgewicht VM."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa ett lokalt Kubernetes-kluster. Varje nod körs i en egen lättviktig VM."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret en lokal Kubernetes-klynge. Hver node kører i sin egen lette VM."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprett en lokal Kubernetes-klynge. Hver node kjører i sin egen lette VM."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo paikallinen Kubernetes-klusteri. Jokainen solmu toimii omassa kevyessä virtuaalikoneessaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwórz lokalny klaster Kubernetes. Każdy węzeł działa we własnej, lekkiej maszynie wirtualnej."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvořte místní cluster Kubernetes. Každý uzel běží ve vlastním odlehčeném virtuálním stroji."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvorte lokálny klaster Kubernetes. Každý uzol beží vo vlastnom odľahčenom virtuálnom stroji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Helyi Kubernetes-klaszter létrehozása. Minden csomópont saját könnyű virtuális gépen fut."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Creați un cluster Kubernetes local. Fiecare nod rulează în propria sa VM ușoară."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Създайте локален клъстер на Kubernetes. Всеки възел работи в собствена олекотена виртуална машина."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργήστε ένα τοπικό cluster Kubernetes. Κάθε κόμβος εκτελείται στη δική του ελαφριά VM."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stvorite lokalni Kubernetes klaster. Svaki čvor radi u vlastitom laganom virtualnom stroju."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustvarite lokalno gručo Kubernetes. Vsako vozlišče se izvaja v svojem lahkem navideznem stroju."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Креирајте локални Kubernetes кластер. Сваки чвор ради у сопственој лакој виртуелној машини."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreirajte lokalni Kubernetes klaster. Svaki čvor radi u sopstvenoj lakoj virtuelnoj mašini."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sukurkite vietinį Kubernetes klasterį. Kiekvienas mazgas veikia savoje lengvoje virtualiojoje mašinoje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izveidojiet lokālu Kubernetes klasteri. Katrs mezgls darbojas savā vieglā virtuālajā mašīnā."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Looge kohalik Kubernetese klaster. Iga sõlm töötab oma kerges virtuaalmasinas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створіть локальний кластер Kubernetes. Кожен вузол працює у власній легкій віртуальній машині."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте локальный кластер Kubernetes. Каждый узел работает в собственной легковесной ВМ."
          }
        }
      }
    },
    "Create a long-lived Linux environment to develop in.": {
      "localizations": {
        "en": {
