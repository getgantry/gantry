          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld contenedores usan esta imagen. Usa Forzar eliminación para eliminarla de todos modos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld container usano questa immagine. Usa Forza rimozione per rimuoverla comunque."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld contentores utilizam esta imagem. Utilize Forçar remoção para a remover mesmo assim."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld containers gebruiken deze image. Gebruik “Verwijder geforceerd” om de image toch te verwijderen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld containrar använder den här imagen. Använd Tvinga borttagning för att ta bort den ändå."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld containere bruger dette image. Brug Tvangsfjern for at fjerne det alligevel."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld containere bruker dette imaget. Bruk Tving fjerning for å fjerne det likevel."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld konttia käyttää tätä levykuvaa. Poista se silti valitsemalla Pakota poisto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontenery używające tego obrazu: %lld. Aby mimo to go usunąć, użyj opcji Wymuś usunięcie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počet kontejnerů, které používají tento image: %lld. Chcete-li ho přesto odstranit, použijte „Vynutit odstranění“."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počet kontajnerov, ktoré používajú tento obraz: %lld. Ak ho chcete aj tak odstrániť, použite Vynútene odstrániť."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld konténer használja ezt az image-et. A „Kényszerített eltávolítás” gombbal így is eltávolíthatja."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Containere care folosesc această imagine: %lld. Folosiți Elimină forțat pentru a o elimina oricum."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Контейнери, които използват този образ: %lld. Използвайте „Премахни принудително“, за да го премахнете въпреки това."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld κοντέινερ χρησιμοποιούν αυτή την εικόνα. Χρησιμοποιήστε την «Αναγκαστική αφαίρεση» για να την αφαιρέσετε ούτως ή άλλως."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Broj kontejnera koji koriste ovu sliku: %lld. Za uklanjanje svejedno upotrijebite Prisilno ukloni."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Število vsebnikov, ki uporabljajo to sliko: %lld. Če jo želite kljub temu odstraniti, uporabite Prisilno odstrani."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Контејнера који користе ову слику: %lld. Користите „Принудно уклони“ да бисте је ипак уклонили."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontejnera koji koriste ovu sliku: %lld. Koristite „Prinudno ukloni“ da biste je ipak uklonili."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šį atvaizdą naudojančių konteinerių: %lld. Norėdami vis tiek jį pašalinti, naudokite „Pašalinti priverstinai“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šo attēlu izmanto konteineri: %lld. Lai to tomēr noņemtu, izmantojiet „Noņemt piespiedu kārtā”."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seda tõmmist kasutab %lld konteinerit. Eemaldamiseks valige „Sundeemalda“."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Контейнерів, що використовують цей образ: %lld. Щоб усе одно вилучити його, виберіть «Вилучити примусово»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контейнеров, которые используют этот образ: %lld. Чтобы всё равно удалить его, выберите «Удалить принудительно»."
          }
        }
      }
    },
