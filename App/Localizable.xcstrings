    "The options apply when the builder starts. Stop it first to start it with other options.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The options apply when the builder starts. Stop it first to start it with other options."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些选项在构建器启动时生效。如需使用其他选项启动，请先停止构建器。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Optionen gelten beim Start des Builders. Stoppe ihn zuerst, um ihn mit anderen Optionen zu starten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les options s'appliquent au démarrage du builder. Arrêtez-le d'abord pour le démarrer avec d'autres options."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las opciones se aplican cuando se inicia el builder. Detenlo primero para iniciarlo con otras opciones."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le opzioni vengono applicate all'avvio del builder. Arrestalo prima per avviarlo con altre opzioni."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As opções são aplicadas quando o builder inicia. Pare-o primeiro para o iniciar com outras opções."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opties gelden wanneer de builder start. Stop de builder eerst om hem met andere opties te starten."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternativen tillämpas när byggaren startar. Stoppa den först för att starta den med andra alternativ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indstillingerne anvendes, når builderen starter. Stop den først for at starte den med andre indstillinger."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgene brukes når byggeren starter. Stopp den først for å starte den med andre valg."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valinnat otetaan käyttöön, kun koontityökalu käynnistyy. Pysäytä se ensin, jos haluat käynnistää sen muilla valinnoilla."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcje są stosowane przy uruchamianiu buildera. Aby uruchomić go z innymi opcjami, najpierw go zatrzymaj."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Možnosti se použijí při spuštění builderu. Chcete-li ho spustit s jinými možnostmi, nejprve ho zastavte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Možnosti sa použijú pri spustení buildera. Ak ho chcete spustiť s inými možnosťami, najprv ho zastavte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beállítások a builder indításakor érvényesülnek. Más beállításokkal való indításhoz előbb állítsa le."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Opțiunile se aplică la pornirea builderului. Opriți-l mai întâi pentru a-l porni cu alte opțiuni."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Опциите се прилагат при стартиране на билдъра. Първо го спрете, за да го стартирате с други опции."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι επιλογές ισχύουν κατά την εκκίνηση του builder. Διακόψτε τον πρώτα για να τον ξεκινήσετε με άλλες επιλογές."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcije se primjenjuju pri pokretanju buildera. Najprije ga zaustavite da biste ga pokrenuli s drugim opcijama."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Možnosti veljajo ob zagonu graditelja. Če ga želite zagnati z drugimi možnostmi, ga najprej ustavite."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Опције се примењују при покретању билдера. Најпре га зауставите да бисте га покренули са другим опцијама."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcije se primenjuju pri pokretanju bildera. Najpre ga zaustavite da biste ga pokrenuli sa drugim opcijama."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Parinktys taikomos paleidžiant kūrimo įrankį. Norėdami paleisti su kitomis parinktimis, pirmiausia jį sustabdykite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcijas tiek lietotas, kad būvētājs tiek startēts. Lai to startētu ar citām opcijām, vispirms apturiet to."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valikud rakenduvad koostaja käivitamisel. Teiste valikutega käivitamiseks peatage see esmalt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметри застосовуються під час запуску збирача. Щоб запустити його з іншими параметрами, спершу зупиніть його."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметры применяются при запуске сборщика. Чтобы запустить его с другими параметрами, сначала остановите его."
          }
        }
      }
    },
    "Defaults come from the build.cpus and build.memory system properties.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaults come from the build.cpus and build.memory system properties."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认值来自 build.cpus 和 build.memory 系统属性。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Standardwerte stammen aus den Systemeigenschaften build.cpus und build.memory."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs par défaut proviennent des propriétés système build.cpus et build.memory."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores predeterminados provienen de las propiedades del sistema build.cpus y build.memory."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I valori predefiniti provengono dalle proprietà di sistema build.cpus e build.memory."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As predefinições provêm das propriedades de sistema build.cpus e build.memory."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaardwaarden komen uit de systeemeigenschappen build.cpus en build.memory."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardvärdena kommer från systemegenskaperna build.cpus och build.memory."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardværdierne kommer fra systemegenskaberne build.cpus og build.memory."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardverdiene kommer fra systemegenskapene build.cpus og build.memory."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletukset tulevat järjestelmäominaisuuksista build.cpus ja build.memory."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartości domyślne pochodzą z właściwości systemowych build.cpus i build.memory."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výchozí hodnoty pocházejí ze systémových vlastností build.cpus a build.memory."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Predvolené hodnoty pochádzajú zo systémových vlastností build.cpus a build.memory."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alapértékek a build.cpus és a build.memory rendszertulajdonságból származnak."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Valorile implicite provin din proprietățile de sistem build.cpus și build.memory."
          }
        },
        "bg": {
