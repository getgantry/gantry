    "Update apple/container to 1.4 or later to see host facts and resource counts here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update apple/container to 1.4 or later to see host facts and resource counts here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将 apple/container 更新到 1.4 或更高版本，以在此查看主机信息和资源数量。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiere apple/container auf 1.4 oder neuer, um hier Hostinformationen und Ressourcenzahlen zu sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour apple/container vers la version 1.4 ou ultérieure pour voir ici les informations sur l'hôte et le nombre de ressources."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza apple/container a la versión 1.4 o posterior para ver aquí la información del host y el recuento de recursos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna apple/container alla versione 1.4 o successiva per vedere qui le informazioni sull'host e il numero di risorse."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize o apple/container para a versão 1.4 ou posterior para ver aqui as informações do host e a contagem de recursos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werk apple/container bij naar 1.4 of nieuwer om hier hostgegevens en aantallen bronnen te zien."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppdatera apple/container till 1.4 eller senare för att se värdinformation och antal resurser här."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdater apple/container til 1.4 eller nyere for at se værtsoplysninger og antal ressourcer her."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppdater apple/container til 1.4 eller nyere for å se vertsinformasjon og ressurstall her."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivitä apple/container versioon 1.4 tai uudempaan, niin näet isännän tiedot ja resurssimäärät täällä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uaktualnij apple/container do wersji 1.4 lub nowszej, aby zobaczyć tutaj informacje o hoście i liczbę zasobów."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li zde vidět údaje o hostiteli a počty prostředků, aktualizujte apple/container na verzi 1.4 nebo novější."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete tu vidieť údaje o hostiteľovi a počty prostriedkov, aktualizujte apple/container na verziu 1.4 alebo novšiu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gazdagép adatainak és az erőforrások számának megtekintéséhez frissítse az apple/containert 1.4-es vagy újabb verzióra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizați apple/container la 1.4 sau o versiune ulterioară pentru a vedea aici informațiile despre gazdă și numărul de resurse."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Актуализирайте apple/container до 1.4 или по-нова версия, за да виждате тук данни за хоста и броя на ресурсите."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενημερώστε το apple/container σε 1.4 ή νεότερη για να βλέπετε εδώ στοιχεία host και πλήθος πόρων."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ažurirajte apple/container na 1.4 ili noviju kako biste ovdje vidjeli podatke o hostu i broj resursa."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Posodobite apple/container na 1.4 ali novejšo, da boste tukaj videli podatke o gostitelju in število virov."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ажурирајте apple/container на 1.4 или новију верзију да бисте овде видели податке о хосту и бројеве ресурса."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ažurirajte apple/container na 1.4 ili noviju verziju da biste ovde videli podatke o hostu i brojeve resursa."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atnaujinkite apple/container į 1.4 ar naujesnę versiją, kad čia matytumėte serverio duomenis ir išteklių skaičius."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai šeit redzētu resursdatora informāciju un resursu skaitu, atjauniniet apple/container uz 1.4 vai jaunāku versiju."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hosti andmete ja ressursside arvu nägemiseks siin uuendage apple/container versioonile 1.4 või uuemale."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновіть apple/container до 1.4 або новішої версії, щоб бачити тут відомості про хост і кількість ресурсів."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновите apple/container до 1.4 или новее, чтобы видеть здесь сведения о хосте и количество ресурсов."
          }
        }
      }
    },
