        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spúšťacie argumenty jadra vyžadujú apple/container %@ alebo novší."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kernel rendszerindítási argumentumaihoz apple/container %@ vagy újabb szükséges."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
