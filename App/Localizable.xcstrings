    "Cloudflare hands out a temporary `https://….trycloudflare.com` address. Anyone with the link can reach the port while the tunnel is up.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare hands out a temporary `https://….trycloudflare.com` address. Anyone with the link can reach the port while the tunnel is up."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 会分配临时的 `https://….trycloudflare.com` 地址。隧道开启期间，任何持有链接的人都可以访问该端口。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare vergibt eine temporäre Adresse `https://….trycloudflare.com`. Jeder mit dem Link kann den Port erreichen, solange der Tunnel besteht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare attribue une adresse temporaire `https://….trycloudflare.com`. Toute personne disposant du lien peut accéder au port tant que le tunnel est actif."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare asigna una dirección temporal `https://….trycloudflare.com`. Cualquiera que tenga el enlace puede acceder al puerto mientras el túnel esté activo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare assegna un indirizzo temporaneo `https://….trycloudflare.com`. Chiunque abbia il link può raggiungere la porta finché il tunnel è attivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cloudflare atribui um endereço temporário `https://….trycloudflare.com`. Qualquer pessoa com a ligação pode aceder à porta enquanto o túnel estiver ativo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare geeft een tijdelijk `https://….trycloudflare.com`-adres uit. Iedereen met de link kan de poort bereiken zolang de tunnel actief is."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare tilldelar en tillfällig `https://….trycloudflare.com`-adress. Alla som har länken kan nå porten medan tunneln är uppe."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare tildeler en midlertidig `https://….trycloudflare.com`-adresse. Alle med linket kan nå porten, mens tunnelen er aktiv."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare deler ut en midlertidig `https://….trycloudflare.com`-adresse. Alle som har lenken, kan nå porten mens tunnelen er aktiv."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare antaa väliaikaisen osoitteen `https://….trycloudflare.com`. Kuka tahansa, jolla on linkki, voi käyttää porttia niin kauan kuin tunneli on auki."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare przydziela tymczasowy adres `https://….trycloudflare.com`. Każdy, kto ma ten link, może połączyć się z portem, dopóki tunel działa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare přidělí dočasnou adresu `https://….trycloudflare.com`. Kdokoli s odkazem se dostane k portu, dokud je tunel aktivní."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare pridelí dočasnú adresu `https://….trycloudflare.com`. Kým je tunel aktívny, port je dostupný pre každého, kto má odkaz."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cloudflare egy ideiglenes `https://….trycloudflare.com` címet ad. Amíg az alagút fut, a linkkel bárki elérheti a portot."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare oferă o adresă temporară `https://….trycloudflare.com`. Oricine are linkul poate accesa portul cât timp tunelul este activ."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare дава временен адрес `https://….trycloudflare.com`. Всеки, който има връзката, може да достъпи порта, докато тунелът работи."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Cloudflare δίνει μια προσωρινή διεύθυνση `https://….trycloudflare.com`. Όποιος έχει τον σύνδεσμο μπορεί να έχει πρόσβαση στη θύρα όσο το tunnel είναι ενεργό."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare dodjeljuje privremenu adresu `https://….trycloudflare.com`. Svatko tko ima poveznicu može pristupiti portu dok je tunel aktivan."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare dodeli začasni naslov `https://….trycloudflare.com`. Dokler je tunel odprt, lahko do vrat dostopa vsak, ki ima povezavo."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare додељује привремену адресу `https://….trycloudflare.com`. Свако ко има везу може да приступи порту док је тунел активан."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare dodeljuje privremenu adresu `https://….trycloudflare.com`. Svako ko ima vezu može da pristupi portu dok je tunel aktivan."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare suteikia laikiną adresą `https://….trycloudflare.com`. Kol tunelis veikia, prievadą gali pasiekti bet kas, turintis nuorodą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare piešķir pagaidu adresi `https://….trycloudflare.com`. Ikviens, kam ir saite, var piekļūt portam, kamēr tunelis ir aktīvs."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare annab ajutise aadressi `https://….trycloudflare.com`. Kuni tunnel töötab, pääseb pordile ligi igaüks, kellel on link."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare видає тимчасову адресу `https://….trycloudflare.com`. Будь-хто, хто має посилання, може отримати доступ до порту, поки тунель активний."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare выдаёт временный адрес `https://….trycloudflare.com`. Пока работает туннель, любой, у кого есть ссылка, может получить доступ к порту."
          }
        }
      }
    },
