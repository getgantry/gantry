    "“%@” is not a Dockerfile and has no Dockerfile in it. Choose a Dockerfile or a folder that contains one.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is not a Dockerfile and has no Dockerfile in it. Choose a Dockerfile or a folder that contains one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不是 Dockerfile，其中也没有 Dockerfile。请选择 Dockerfile 或包含 Dockerfile 的文件夹。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist kein Dockerfile und enthält kein Dockerfile. Wähle ein Dockerfile oder einen Ordner, der eines enthält."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n'est pas un Dockerfile et n'en contient pas. Choisissez un Dockerfile ou un dossier qui en contient un."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” no es un Dockerfile ni contiene ninguno. Elige un Dockerfile o una carpeta que contenga uno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non è un Dockerfile e non ne contiene uno. Scegli un Dockerfile o una cartella che ne contiene uno."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não é um Dockerfile e não contém nenhum Dockerfile. Escolha um Dockerfile ou uma pasta que contenha um."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is geen Dockerfile en bevat geen Dockerfile. Kies een Dockerfile of een map die er een bevat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” är inte en Dockerfile och innehåller ingen Dockerfile. Välj en Dockerfile eller en mapp som innehåller en."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” er ikke en Dockerfile og indeholder ingen Dockerfile. Vælg en Dockerfile eller en mappe, der indeholder en."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» er ikke en Dockerfile og inneholder ingen Dockerfile. Velg en Dockerfile eller en mappe som inneholder en."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” ei ole Dockerfile, eikä se sisällä Dockerfilea. Valitse Dockerfile tai kansio, joka sisältää sen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nie jest plikiem Dockerfile i nie zawiera pliku Dockerfile. Wybierz plik Dockerfile lub folder, który go zawiera."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ není Dockerfile a žádný Dockerfile neobsahuje. Vyberte Dockerfile nebo složku, která ho obsahuje."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ nie je Dockerfile a neobsahuje ani Dockerfile. Vyberte Dockerfile alebo priečinok, ktorý ho obsahuje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nem Dockerfile, és nincs benne Dockerfile. Válasszon egy Dockerfile-t vagy egy azt tartalmazó mappát."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nu este un Dockerfile și nu conține niciun Dockerfile. Alegeți un Dockerfile sau un dosar care conține unul."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ не е Dockerfile и не съдържа Dockerfile. Изберете Dockerfile или папка, която съдържа такъв."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» δεν είναι Dockerfile και δεν περιέχει Dockerfile. Επιλέξτε ένα Dockerfile ή έναν φάκελο που το περιέχει."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nije Dockerfile i ne sadrži Dockerfile. Odaberite Dockerfile ili mapu koja ga sadrži."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ni datoteka Dockerfile in je ne vsebuje. Izberite datoteko Dockerfile ali mapo, ki jo vsebuje."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ није Dockerfile и не садржи Dockerfile. Изаберите Dockerfile или фасциклу која га садржи."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ nije Dockerfile i ne sadrži Dockerfile. Izaberite Dockerfile ili fasciklu koja ga sadrži."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ nėra Dockerfile ir jame nėra Dockerfile. Pasirinkite Dockerfile arba aplanką, kuriame jis yra."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nav Dockerfile, un tajā nav Dockerfile. Izvēlieties Dockerfile vai mapi, kurā tas atrodas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ei ole Dockerfile ega sisalda Dockerfile'i. Valige Dockerfile või seda sisaldav kaust."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» не є Dockerfile і не містить Dockerfile. Виберіть Dockerfile або папку, що його містить."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» — не Dockerfile, и Dockerfile в нём нет. Выберите Dockerfile или папку, в которой он есть."
          }
        }
      }
    },
    "“%@” stopped right after it started. Its logs usually show why.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” stopped right after it started. Its logs usually show why."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”启动后立即停止。日志通常会显示原因。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wurde direkt nach dem Start beendet. Die Logs zeigen meist den Grund."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » s'est arrêté juste après son démarrage. Ses journaux en indiquent généralement la raison."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” se ha detenido justo después de iniciarse. Sus logs suelen indicar el motivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” si è arrestato subito dopo l'avvio. Di solito i suoi log ne indicano il motivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” parou logo após iniciar. Normalmente, os respetivos logs indicam o motivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is direct na het starten gestopt. De logs laten meestal zien waarom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” stoppades direkt efter att den startade. Dess loggar visar oftast varför."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” stoppede lige efter start. Dens logge viser normalt hvorfor."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» stoppet rett etter at den startet. Loggene viser vanligvis hvorfor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” pysähtyi heti käynnistymisen jälkeen. Syy näkyy yleensä sen lokeista."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontener „%@” zatrzymał się zaraz po uruchomieniu. Przyczynę zwykle można znaleźć w jego logach."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontejner „%@“ se zastavil hned po spuštění. Důvod obvykle najdete v jeho logech."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontajner „%@“ sa zastavil hneď po spustení. Príčinu zvyčajne nájdete v jeho logoch."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” közvetlenül az indulása után leállt. Az okát általában a naplói mutatják."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” s-a oprit imediat după pornire. De obicei, jurnalele sale arată de ce."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ спря веднага след стартирането си. Причината обикновено се вижда в логовете му."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» διακόπηκε αμέσως μετά την εκκίνηση. Τα αρχεία καταγραφής του συνήθως δείχνουν τον λόγο."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontejner „%@” zaustavio se odmah nakon pokretanja. Razlog se obično vidi u njegovim zapisnicima."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsebnik „%@“ se je ustavil takoj po zagonu. Vzrok je običajno razviden iz dnevnikov."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ се зауставио одмах након покретања. Његови логови обично показују зашто."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ se zaustavio odmah nakon pokretanja. Njegovi logovi obično pokazuju zašto."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ sustojo iškart po paleidimo. Priežastis paprastai matoma jo žurnale."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” apstājās uzreiz pēc startēšanas. Iemesls parasti redzams tā žurnālos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ peatus kohe pärast käivitumist. Põhjus on tavaliselt näha selle logides."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Контейнер «%@» зупинився одразу після запуску. Причину зазвичай видно в його журналах."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контейнер «%@» остановился сразу после запуска. Причину обычно можно найти в его логах."
          }
        }
      }
    },
    "•": {
      "shouldTranslate": false
    },
