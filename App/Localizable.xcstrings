        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Host da ~/.ssh/config. Se ne scegli uno, i campi sottostanti vengono compilati."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
