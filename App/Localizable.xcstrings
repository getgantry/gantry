    "A host terminal needs a connected SSH host. Connect the host in the main window first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A host terminal needs a connected SSH host. Connect the host in the main window first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机终端需要已连接的 SSH 主机。请先在主窗口连接该主机。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Host-Terminal benötigt einen verbundenen SSH-Host. Verbinde dich zuerst im Hauptfenster mit dem Host."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un terminal d'hôte nécessite un hôte SSH connecté. Connectez d'abord l'hôte dans la fenêtre principale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un terminal de host necesita un host SSH conectado. Conecta primero el host en la ventana principal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un terminale host richiede un host SSH connesso. Connetti prima l'host nella finestra principale."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um terminal de host precisa de um host SSH ligado. Ligue primeiro o host na janela principal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een hostterminal vereist een verbonden SSH-host. Verbind eerst de host in het hoofdvenster."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En värdterminal kräver en ansluten SSH-värd. Anslut värden i huvudfönstret först."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En værtsterminal kræver en forbundet SSH-vært. Forbind værten i hovedvinduet først."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En vertsterminal krever en tilkoblet SSH-vert. Koble til verten i hovedvinduet først."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Isännän pääte vaatii yhdistetyn SSH-isännän. Yhdistä isäntä ensin pääikkunassa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal hosta wymaga połączonego hosta SSH. Najpierw połącz się z hostem w oknie głównym."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminál hostitele vyžaduje připojeného hostitele SSH. Nejprve hostitele připojte v hlavním okně."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminál hostiteľa vyžaduje pripojeného hostiteľa SSH. Najprv pripojte hostiteľa v hlavnom okne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gazdagép-terminálhoz csatlakoztatott SSH-gazdagép szükséges. Előbb csatlakoztassa a gazdagépet a fő ablakban."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un terminal de gazdă necesită o gazdă SSH conectată. Conectați mai întâi gazda în fereastra principală."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Терминалът на хоста изисква свързан SSH хост. Първо свържете хоста в главния прозорец."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το τερματικό host χρειάζεται συνδεδεμένο host SSH. Συνδέστε πρώτα τον host στο κύριο παράθυρο."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za terminal hosta potreban je povezani SSH host. Najprije povežite host u glavnom prozoru."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za terminal gostitelja mora biti gostitelj SSH povezan. Najprej povežite gostitelja v glavnem oknu."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Терминал хоста захтева повезан SSH хост. Најпре повежите хост у главном прозору."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal hosta zahteva povezan SSH host. Najpre povežite host u glavnom prozoru."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverio terminalui reikia prijungto SSH serverio. Pirmiausia prijunkite serverį pagrindiniame lange."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Resursdatora terminālim nepieciešams savienots SSH resursdators. Vispirms galvenajā logā izveidojiet savienojumu ar resursdatoru."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hosti terminal vajab ühendatud SSH-hosti. Ühendage host esmalt põhiaknas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для термінала хоста потрібен під’єднаний SSH-хост. Спершу під’єднайте хост у головному вікні."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для терминала хоста нужен подключённый SSH-хост. Сначала подключите хост в главном окне."
          }
        }
      }
    },
