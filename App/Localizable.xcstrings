    "The cluster context is added to this file. An existing file keeps its other contexts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cluster context is added to this file. An existing file keeps its other contexts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "集群上下文将添加到此文件。已有文件会保留其他上下文。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Clusterkontext wird zu dieser Datei hinzugefügt. Eine vorhandene Datei behält ihre anderen Kontexte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contexte du cluster est ajouté à ce fichier. Un fichier existant conserve ses autres contextes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contexto del clúster se añade a este archivo. Un archivo existente conserva sus otros contextos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contesto del cluster viene aggiunto a questo file. Un file esistente mantiene gli altri contesti."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O contexto do cluster é adicionado a este ficheiro. Um ficheiro existente mantém os outros contextos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De clustercontext wordt aan dit bestand toegevoegd. Een bestaand bestand behoudt zijn andere contexten."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klustrets kontext läggs till i den här filen. En befintlig fil behåller sina andra kontexter."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klyngens kontekst føjes til denne fil. En eksisterende fil beholder sine andre kontekster."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klyngekonteksten legges til i denne filen. En eksisterende fil beholder de andre kontekstene sine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Klusterin konteksti lisätään tähän tiedostoon. Olemassa olevan tiedoston muut kontekstit säilyvät."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontekst klastra zostanie dodany do tego pliku. Istniejący plik zachowa pozostałe konteksty."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontext clusteru se přidá do tohoto souboru. Existující soubor si ponechá své ostatní kontexty."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontext klastra sa pridá do tohto súboru. Existujúci súbor si ponechá ostatné kontexty."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A klaszter környezete bekerül ebbe a fájlba. Egy meglévő fájl többi környezete megmarad."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Contextul clusterului este adăugat în acest fișier. Un fișier existent își păstrează celelalte contexte."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Контекстът на клъстера се добавя към този файл. Ако файлът съществува, другите му контексти се запазват."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το context του cluster προστίθεται σε αυτό το αρχείο. Ένα υπάρχον αρχείο διατηρεί τα άλλα context του."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontekst klastera dodaje se u ovu datoteku. Postojeća datoteka zadržava ostale kontekste."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontekst gruče se doda v to datoteko. Obstoječa datoteka ohrani druge kontekste."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Контекст кластера се додаје у ову датотеку. Постојећа датотека задржава своје остале контексте."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontekst klastera se dodaje u ovu datoteku. Postojeća datoteka zadržava svoje ostale kontekste."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasterio kontekstas pridedamas į šį failą. Esamame faile kiti kontekstai išlieka."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klastera konteksts tiek pievienots šim failam. Esošajā failā pārējie konteksti tiek saglabāti."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klastri kontekst lisatakse sellesse faili. Olemasoleva faili teised kontekstid säilivad."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Контекст кластера буде додано до цього файлу. Наявний файл збереже інші контексти."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контекст кластера будет добавлен в этот файл. Другие контексты в существующем файле сохранятся."
          }
        }
      }
    },
