    "Volumes keep container data after the container is removed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumes keep container data after the container is removed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卷会在容器移除后保留容器数据。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumes behalten Containerdaten, nachdem der Container entfernt wurde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les volumes conservent les données d'un conteneur après sa suppression."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los volúmenes conservan los datos del contenedor después de eliminarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I volumi conservano i dati del container dopo la sua rimozione."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os volumes mantêm os dados do contentor depois de este ser removido."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumes bewaren containergegevens nadat de container is verwijderd."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Volymer behåller containerdata efter att containern tagits bort."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumes bevarer containerdata, når containeren er fjernet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumer beholder containerdata etter at containeren er fjernet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taltiot säilyttävät kontin datan kontin poistamisen jälkeen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Woluminy zachowują dane kontenera po jego usunięciu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svazky uchovávají data kontejneru i po jeho odstranění."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zväzky uchovávajú dáta kontajnera aj po jeho odstránení."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kötetek a konténer eltávolítása után is megőrzik a konténer adatait."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumele păstrează datele containerului după eliminarea acestuia."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Томовете запазват данните на контейнера, след като той бъде премахнат."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι τόμοι διατηρούν τα δεδομένα του κοντέινερ μετά την αφαίρεσή του."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumeni čuvaju podatke kontejnera nakon uklanjanja kontejnera."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nosilci ohranijo podatke vsebnika tudi po odstranitvi vsebnika."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Волумени чувају податке контејнера и након што се контејнер уклони."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumeni čuvaju podatke kontejnera i nakon što se kontejner ukloni."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomai išsaugo konteinerio duomenis ir pašalinus konteinerį."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sējumi saglabā konteinera datus arī pēc konteinera noņemšanas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Köited säilitavad konteineri andmed ka pärast konteineri eemaldamist."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Томи зберігають дані контейнера після його вилучення."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тома сохраняют данные контейнера после его удаления."
          }
        }
      }
    },
