          "stringUnit": {
            "state": "translated",
            "value": "Vælg en sektion fra en vært i indholdsoversigten."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en seksjon fra en vert i sidepanelet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse isännän osio sivupalkista."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz sekcję hosta na pasku bocznym."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte sekci hostitele v postranním panelu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte sekciu hostiteľa v bočnom paneli."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válasszon egy szakaszt egy gazdagépnél az oldalsávon."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Selectați o secțiune a unei gazde din bara laterală."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете раздел на хост в страничната лента."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε μια ενότητα ενός host στην πλαϊνή στήλη."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite odjeljak hosta u bočnoj traci."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V stranski vrstici izberite razdelek gostitelja."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Изаберите одељак хоста у бочној траци."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Izaberite odeljak hosta u bočnoj traci."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šoninėje juostoje pasirinkite serverio skyrių."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sānjoslā izvēlieties resursdatora sadaļu."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valige külgribal hosti jaotis."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть розділ хоста на боковій панелі."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите раздел хоста в боковом меню."
          }
        }
      }
    },
    "Send a macOS notification when a container crashes, runs out of memory, or fails its health check on any host. Manual stops and restarts are not reported. Click a notification to jump to the container.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a macOS notification when a container crashes, runs out of memory, or fails its health check on any host. Manual stops and restarts are not reported. Click a notification to jump to the container."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当任意主机上的容器崩溃、内存耗尽或健康检查失败时发送 macOS 通知。手动停止与重启不会报告。点击通知可跳转到该容器。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine macOS-Mitteilung senden, wenn ein Container auf einem beliebigen Host abstürzt, keinen Arbeitsspeicher mehr hat oder seine Integritätsprüfung nicht besteht. Manuelles Stoppen und Neustarten wird nicht gemeldet. Klicke auf eine Mitteilung, um zum Container zu springen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer une notification macOS lorsqu'un conteneur plante, manque de mémoire ou échoue à son contrôle d'état sur n'importe quel hôte. Les arrêts et redémarrages manuels ne sont pas signalés. Cliquez sur une notification pour accéder au conteneur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía una notificación de macOS cuando un contenedor falle, se quede sin memoria o no supere su comprobación de estado en cualquier host. No se notifican las detenciones ni los reinicios manuales. Haz clic en una notificación para ir al contenedor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia una notifica macOS quando un container si arresta in modo anomalo, esaurisce la memoria o non supera il controllo di integrità su qualsiasi host. Arresti e riavvii manuali non vengono segnalati. Fai clic su una notifica per passare al container."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar uma notificação do macOS quando um contentor falhar, ficar sem memória ou falhar a verificação de estado em qualquer host. As paragens e os reinícios manuais não são notificados. Clique numa notificação para ir para o contentor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuur een macOS-melding wanneer een container op een host crasht, geen geheugen meer heeft of de statuscontrole niet doorstaat. Handmatig stoppen en herstarten wordt niet gemeld. Klik op een melding om naar de container te gaan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skicka en macOS-notis när en container kraschar, får slut på minne eller inte klarar sin hälsokontroll på någon värd. Manuella stopp och omstarter rapporteras inte. Klicka på en notis för att gå till containern."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Send en macOS-meddelelse, når en container går ned, løber tør for hukommelse eller fejler sit sundhedstjek på en vært. Manuelle stop og genstarter rapporteres ikke. Klik på en meddelelse for at gå til containeren."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Send en macOS-varsling når en container krasjer, går tom for minne eller ikke består helsesjekken på noen av vertene. Manuelle stopp og omstarter rapporteres ikke. Klikk på en varsling for å gå til containeren."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetä macOS-ilmoitus, kun kontti kaatuu, sen muisti loppuu tai sen kuntotarkistus epäonnistuu millä tahansa isännällä. Manuaalisista pysäytyksistä ja uudelleenkäynnistyksistä ei ilmoiteta. Siirry konttiin osoittamalla ilmoitusta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyłaj powiadomienie macOS, gdy na dowolnym hoście kontener ulegnie awarii, wyczerpie pamięć lub nie przejdzie testu stanu zdrowia. Ręczne zatrzymania i ponowne uruchomienia nie są zgłaszane. Kliknij powiadomienie, aby przejść do kontenera."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odeslat oznámení macOS, když kontejner na kterémkoli hostiteli spadne, vyčerpá paměť nebo neprojde kontrolou stavu. Ruční zastavení a restarty se nehlásí. Kliknutím na oznámení přejdete ke kontejneru."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslať hlásenie macOS, keď kontajner na ktoromkoľvek hostiteľovi spadne, minie pamäť alebo neprejde kontrolou stavu. Manuálne zastavenia a reštarty sa nehlásia. Kliknutím na hlásenie prejdete na kontajner."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS-értesítés küldése, ha bármely gazdagépen egy konténer összeomlik, kifogy a memóriából, vagy nem felel meg az állapotellenőrzésnek. A kézi leállításokról és újraindításokról nem érkezik értesítés. Az értesítésre kattintva a konténerhez ugorhat."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimite o notificare macOS când un container se închide neașteptat, rămâne fără memorie sau nu trece verificarea de sănătate pe orice gazdă. Opririle și repornirile manuale nu sunt raportate. Faceți clic pe o notificare pentru a ajunge la container."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изпраща известие в macOS, когато контейнер на който и да е хост се срине, изчерпи паметта си или не премине проверката на състоянието. Ръчните спирания и рестартирания не се съобщават. Щракнете върху известие, за да отидете към контейнера."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποστολή γνωστοποίησης macOS όταν ένα κοντέινερ καταρρέει, εξαντλεί τη μνήμη ή αποτυγχάνει στον έλεγχο υγείας σε οποιονδήποτε host. Οι χειροκίνητες διακοπές και επανεκκινήσεις δεν αναφέρονται. Κάντε κλικ σε μια γνωστοποίηση για να μεταβείτε στο κοντέινερ."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Šalje macOS obavijest kad se kontejner sruši, ostane bez memorije ili ne prođe provjeru zdravlja na bilo kojem hostu. Ručna zaustavljanja i ponovna pokretanja ne prijavljuju se. Kliknite obavijest za prelazak na kontejner."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošlji obvestilo macOS, ko se vsebnik na katerem koli gostitelju sesuje, mu zmanjka pomnilnika ali ne prestane preverjanja zdravja. Ročne ustavitve in ponovni zagoni se ne sporočajo. Kliknite obvestilo, da skočite na vsebnik."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаљи macOS обавештење када се контејнер сруши, остане без меморије или не прође проверу исправности на било ком хосту. Ручна заустављања и поновна покретања се не пријављују. Кликните на обавештење да бисте прешли на контејнер."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Šalji macOS obaveštenje kada se kontejner sruši, ostane bez memorije ili ne prođe proveru ispravnosti na bilo kom hostu. Ručna zaustavljanja i ponovna pokretanja se ne prijavljuju. Kliknite na obaveštenje da biste prešli na kontejner."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Siųsti macOS pranešimą, kai bet kuriame serveryje konteineris nulūžta, jam pritrūksta atminties arba nepavyksta būsenos patikra. Apie rankinius sustabdymus ir paleidimus iš naujo nepranešama. Spustelėkite pranešimą, kad pereitumėte prie konteinerio."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sūtīt macOS paziņojumu, ja jebkurā resursdatorā konteiners avarē, tam pietrūkst atmiņas vai neizdodas tā veselības pārbaude. Par manuālu apturēšanu un restartēšanu netiek paziņots. Noklikšķiniet uz paziņojuma, lai pārietu uz konteineru."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Saada macOS-i teavitus, kui konteiner mõnes hostis jookseb kokku, mälu saab otsa või seisukontroll nurjub. Käsitsi peatamistest ja taaskäivitustest ei teavitata. Teavitusele klõpsates avaneb konteiner."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилати сповіщення macOS, коли на будь-якому хості контейнер аварійно завершує роботу, вичерпує пам’ять або не проходить перевірку стану. Про зупинки й перезапуски вручну сповіщення не надсилаються. Клацніть сповіщення, щоб перейти до контейнера."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправлять уведомление macOS, когда контейнер на любом хосте аварийно завершается, исчерпывает память или не проходит проверку работоспособности. Об остановках и перезапусках вручную уведомления не приходят. Нажмите уведомление, чтобы перейти к контейнеру."
          }
        }
      }
    },
