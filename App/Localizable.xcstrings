          "stringUnit": {
            "state": "translated",
            "value": "Välitä eri paikalliseen porttiin osoitteessa 127.0.0.1. Anna portti väliltä 1–65535."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekieruj na inny port lokalny na 127.0.0.1. Wprowadź port od 1 do 65535."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přesměrovat na jiný místní port na 127.0.0.1. Zadejte port od 1 do 65535."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Presmerovať na iný lokálny port na 127.0.0.1. Zadajte port od 1 do 65535."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Továbbítás egy másik helyi portra a 127.0.0.1 címen. Adjon meg egy portot 1 és 65535 között."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Redirecționează către alt port local pe 127.0.0.1. Introduceți un port între 1 și 65535."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пренасочване към друг локален порт на 127.0.0.1. Въведете порт от 1 до 65535."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προώθηση σε άλλη τοπική θύρα στο 127.0.0.1. Εισαγάγετε θύρα από 1 έως 65535."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proslijedi na drugi lokalni port na 127.0.0.1. Unesite port od 1 do 65535."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Posreduj na druga lokalna vrata na 127.0.0.1. Vnesite vrata od 1 do 65535."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Проследите на други локални порт на 127.0.0.1. Унесите порт од 1 до 65535."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosledite na drugi lokalni port na 127.0.0.1. Unesite port od 1 do 65535."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Persiųsti į kitą vietinį prievadą adresu 127.0.0.1. Įveskite prievadą nuo 1 iki 65535."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārsūtīt uz citu lokālo portu adresē 127.0.0.1. Ievadiet portu no 1 līdz 65535."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Suuna teise kohalikku porti aadressil 127.0.0.1. Sisestage port vahemikus 1–65535."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переадресувати на інший локальний порт на 127.0.0.1. Введіть порт від 1 до 65535."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробросить на другой локальный порт на 127.0.0.1. Введите порт от 1 до 65535."
          }
        }
      }
    },
