    "Networks connect containers to each other.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Networks connect containers to each other."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络将容器彼此连接。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netzwerke verbinden Container miteinander."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réseaux relient les conteneurs entre eux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las redes conectan los contenedores entre sí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le reti collegano i container tra loro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As redes ligam os contentores entre si."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Netwerken verbinden containers met elkaar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nätverk kopplar ihop containrar med varandra."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Netværk forbinder containere med hinanden."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettverk kobler containere til hverandre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkot yhdistävät kontit toisiinsa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieci łączą kontenery ze sobą."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sítě propojují kontejnery mezi sebou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Siete prepájajú kontajnery navzájom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hálózatok kötik össze a konténereket egymással."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rețelele conectează containerele între ele."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Мрежите свързват контейнерите помежду им."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα δίκτυα συνδέουν τα κοντέινερ μεταξύ τους."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mreže međusobno povezuju kontejnere."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omrežja povezujejo vsebnike med seboj."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Мреже повезују контејнере међусобно."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Mreže povezuju kontejnere međusobno."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinklai sujungia konteinerius tarpusavyje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tīkli savieno konteinerus savā starpā."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võrgud ühendavad konteinerid omavahel."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мережі з’єднують контейнери між собою."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сети соединяют контейнеры друг с другом."
          }
        }
      }
    },
