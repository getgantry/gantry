    "Gantry writes the value to ~/.config/container/config.toml. Restart the services to apply it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry writes the value to ~/.config/container/config.toml. Restart the services to apply it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry 会将该值写入 ~/.config/container/config.toml。重启服务后生效。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry schreibt den Wert in ~/.config/container/config.toml. Starte die Dienste neu, um ihn anzuwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry écrit la valeur dans ~/.config/container/config.toml. Redémarrez les services pour l'appliquer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry escribe el valor en ~/.config/container/config.toml. Reinicia los servicios para aplicarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry scrive il valore in ~/.config/container/config.toml. Riavvia i servizi per applicarlo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Gantry escreve o valor em ~/.config/container/config.toml. Reinicie os serviços para o aplicar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry schrijft de waarde naar ~/.config/container/config.toml. Herstart de services om deze toe te passen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry skriver värdet till ~/.config/container/config.toml. Starta om tjänsterna för att tillämpa det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry skriver værdien til ~/.config/container/config.toml. Genstart tjenesterne for at anvende den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry skriver verdien til ~/.config/container/config.toml. Start tjenestene på nytt for å ta den i bruk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry kirjoittaa arvon tiedostoon ~/.config/container/config.toml. Ota se käyttöön käynnistämällä palvelut uudelleen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry zapisuje wartość w ~/.config/container/config.toml. Aby ją zastosować, uruchom ponownie usługi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry zapíše hodnotu do ~/.config/container/config.toml. Chcete-li ji použít, restartujte služby."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry zapíše hodnotu do ~/.config/container/config.toml. Ak ju chcete použiť, reštartujte služby."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Gantry az értéket a ~/.config/container/config.toml fájlba írja. Az alkalmazásához indítsa újra a szolgáltatásokat."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry scrie valoarea în ~/.config/container/config.toml. Reporniți serviciile pentru a o aplica."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry записва стойността в ~/.config/container/config.toml. Рестартирайте услугите, за да я приложите."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Gantry γράφει την τιμή στο ~/.config/container/config.toml. Επανεκκινήστε τις υπηρεσίες για να εφαρμοστεί."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry zapisuje vrijednost u ~/.config/container/config.toml. Za primjenu ponovno pokrenite servise."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry zapiše vrednost v ~/.config/container/config.toml. Da začne veljati, znova zaženite storitve."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry уписује вредност у ~/.config/container/config.toml. Поново покрените сервисе да бисте је применили."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry upisuje vrednost u ~/.config/container/config.toml. Ponovo pokrenite servise da biste je primenili."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry įrašo reikšmę į ~/.config/container/config.toml. Kad ji būtų pritaikyta, paleiskite paslaugas iš naujo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry ieraksta vērtību failā ~/.config/container/config.toml. Lai to lietotu, restartējiet pakalpojumus."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry kirjutab väärtuse faili ~/.config/container/config.toml. Rakendamiseks taaskäivitage teenused."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry записує значення в ~/.config/container/config.toml. Щоб застосувати його, перезапустіть служби."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry записывает значение в ~/.config/container/config.toml. Чтобы применить его, перезапустите службы."
          }
        }
      }
    },
