    "Connects with Remote-SSH. The machine image must run sshd.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connects with Remote-SSH. The machine image must run sshd."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Remote-SSH 连接。机器镜像必须运行 sshd。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindet über Remote-SSH. Im Image der Maschine muss sshd laufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion avec Remote-SSH. L'image de la machine doit exécuter sshd."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conecta con Remote-SSH. La imagen de la máquina debe ejecutar sshd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si connette con Remote-SSH. L'immagine della macchina deve eseguire sshd."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga-se com Remote-SSH. A imagem da máquina tem de executar o sshd."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindt via Remote-SSH. De machine-image moet sshd uitvoeren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ansluter med Remote-SSH. Maskinens image måste köra sshd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbinder med Remote-SSH. Maskinens image skal køre sshd."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kobler til med Remote-SSH. Maskin-imaget må kjøre sshd."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistää Remote-SSH:lla. Koneen levykuvassa on oltava käynnissä sshd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łączy się przez Remote-SSH. Obraz maszyny musi uruchamiać sshd."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojuje se přes Remote-SSH. Image stroje musí spouštět sshd."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripája sa cez Remote-SSH. V obraze stroja musí bežať sshd."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote-SSH-val csatlakozik. A gép image-ében futnia kell az sshd-nek."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conectează prin Remote-SSH. Imaginea mașinii trebuie să ruleze sshd."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Свързва се чрез Remote-SSH. Образът на машината трябва да изпълнява sshd."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδέεται με Remote-SSH. Η εικόνα του μηχανήματος πρέπει να εκτελεί sshd."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povezuje se putem Remote-SSH. Slika stroja mora pokretati sshd."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poveže se prek Remote-SSH. Slika stroja mora izvajati sshd."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Повезује се преко Remote-SSH. Слика машине мора да покреће sshd."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Povezuje se preko Remote-SSH. Slika mašine mora da pokreće sshd."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jungiamasi per Remote-SSH. Mašinos atvaizde turi veikti sshd."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Savienojas ar Remote-SSH. Mašīnas attēlā jādarbojas sshd."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühendub Remote-SSH kaudu. Masina tõmmises peab töötama sshd."
          }
        },
        "uk": {
