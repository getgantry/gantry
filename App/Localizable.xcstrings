          "stringUnit": {
            "state": "translated",
            "value": "Executado em emulação: a arquitetura da imagem é diferente da do host (%@)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draait via emulatie: de architectuur van de image verschilt van die van de host (%@)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Körs med emulering: imagens arkitektur skiljer sig från värdens (%@)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kører under emulering: imagets arkitektur er forskellig fra værtens (%@)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjører med emulering: arkitekturen til imaget er forskjellig fra verten (%@)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toimii emuloituna: levykuvan arkkitehtuuri poikkeaa isännän arkkitehtuurista (%@)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa w emulacji: architektura obrazu różni się od architektury hosta (%@)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Běží v emulaci: architektura image se liší od hostitele (%@)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Beží v emulácii: architektúra obrazu sa líši od hostiteľa (%@)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Emulációval fut: az image architektúrája eltér a gazdagépétől (%@)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rulează prin emulare: arhitectura imaginii diferă de cea a gazdei (%@)."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Работи чрез емулация: архитектурата на образа се различава от тази на хоста (%@)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκτελείται σε εξομοίωση: η αρχιτεκτονική της εικόνας διαφέρει από αυτή του host (%@)."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Radi u emulaciji: arhitektura slike razlikuje se od arhitekture hosta (%@)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvaja se z emulacijo: arhitektura slike se razlikuje od gostitelja (%@)."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ради уз емулацију: архитектура слике се разликује од архитектуре хоста (%@)."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Radi uz emulaciju: arhitektura slike se razlikuje od arhitekture hosta (%@)."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Veikia emuliuojant: atvaizdo architektūra skiriasi nuo serverio (%@)."
