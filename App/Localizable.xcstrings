    "Enter a host name with an optional port, for example ghcr.io or localhost:5000. Do not include https:// or a path.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a host name with an optional port, for example ghcr.io or localhost:5000. Do not include https:// or a path."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入主机名，可带端口，例如 ghcr.io 或 localhost:5000。不要包含 https:// 或路径。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Hostnamen mit optionalem Port ein, zum Beispiel ghcr.io oder localhost:5000. Gib kein https:// und keinen Pfad an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un nom d'hôte avec un port facultatif, par exemple ghcr.io ou localhost:5000. N'incluez ni https:// ni chemin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un nombre de host con un puerto opcional, por ejemplo ghcr.io o localhost:5000. No incluyas https:// ni una ruta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un nome host con una porta facoltativa, ad esempio ghcr.io o localhost:5000. Non includere https:// né un percorso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza um nome de host com uma porta opcional, por exemplo ghcr.io ou localhost:5000. Não inclua https:// nem um caminho."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een hostnaam in met een optionele poort, bijvoorbeeld ghcr.io of localhost:5000. Voeg geen https:// of pad toe."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange ett värdnamn med valfri port, till exempel ghcr.io eller localhost:5000. Ta inte med https:// eller en sökväg."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast et værtsnavn med en valgfri port, f.eks. ghcr.io eller localhost:5000. Medtag ikke https:// eller en sti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn et vertsnavn med en valgfri port, for eksempel ghcr.io eller localhost:5000. Ikke ta med https:// eller en bane."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna isäntänimi ja valinnainen portti, esimerkiksi ghcr.io tai localhost:5000. Älä lisää https://-etuliitettä tai polkua."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź nazwę hosta z opcjonalnym portem, na przykład ghcr.io lub localhost:5000. Nie dodawaj https:// ani ścieżki."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte název hostitele s volitelným portem, například ghcr.io nebo localhost:5000. Nezadávejte https:// ani cestu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadajte názov hostiteľa s voliteľným portom, napríklad ghcr.io alebo localhost:5000. Nezadávajte https:// ani cestu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjon meg egy gazdagépnevet, opcionálisan porttal, például ghcr.io vagy localhost:5000. Ne adja meg a https:// előtagot vagy útvonalat."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduceți un nume de gazdă cu un port opțional, de exemplu ghcr.io sau localhost:5000. Nu includeți https:// sau o cale."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Въведете име на хост с незадължителен порт, например ghcr.io или localhost:5000. Не включвайте https:// или път."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε όνομα host με προαιρετική θύρα, για παράδειγμα ghcr.io ή localhost:5000. Μην συμπεριλάβετε https:// ή διαδρομή."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite naziv hosta s neobaveznim portom, na primjer ghcr.io ili localhost:5000. Ne navodite https:// ni putanju."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vnesite ime gostitelja z izbirnimi vrati, na primer ghcr.io ali localhost:5000. Ne vključite https:// ali poti."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Унесите име хоста са опционалним портом, на пример ghcr.io или localhost:5000. Не наводите https:// нити путању."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite ime hosta sa opcionalnim portom, na primer ghcr.io ili localhost:5000. Ne navodite https:// niti putanju."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įveskite serverio vardą su neprivalomu prievadu, pavyzdžiui, ghcr.io arba localhost:5000. Neįtraukite https:// ar kelio."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ievadiet resursdatora nosaukumu ar neobligātu portu, piemēram, ghcr.io vai localhost:5000. Neiekļaujiet https:// vai ceļu."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisestage hostinimi koos valikulise pordiga, näiteks ghcr.io või localhost:5000. Ärge lisage https:// ega teed."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть ім’я хоста з необов’язковим портом, наприклад ghcr.io або localhost:5000. Не додавайте https:// чи шлях."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите имя хоста и при необходимости порт, например ghcr.io или localhost:5000. Не указывайте https:// и путь."
          }
        }
      }
    },
