    "The recommended kernel comes from the kernel.url system property. Containers that are running keep their kernel until they restart.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recommended kernel comes from the kernel.url system property. Containers that are running keep their kernel until they restart."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐内核来自 kernel.url 系统属性。正在运行的容器在重启前继续使用原内核。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der empfohlene Kernel stammt aus der Systemeigenschaft kernel.url. Laufende Container behalten ihren Kernel bis zum Neustart."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le noyau recommandé provient de la propriété système kernel.url. Les conteneurs en cours d'exécution conservent leur noyau jusqu'à leur redémarrage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El kernel recomendado procede de la propiedad del sistema kernel.url. Los contenedores en ejecución conservan su kernel hasta que se reinician."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il kernel consigliato proviene dalla proprietà di sistema kernel.url. I container in esecuzione mantengono il loro kernel fino al riavvio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O kernel recomendado provém da propriedade de sistema kernel.url. Os contentores em execução mantêm o respetivo kernel até reiniciarem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aanbevolen kernel komt uit de systeemeigenschap kernel.url. Actieve containers behouden hun kernel totdat ze herstarten."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den rekommenderade kärnan kommer från systemegenskapen kernel.url. Containrar som körs behåller sin kärna tills de startar om."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den anbefalede kerne kommer fra systemegenskaben kernel.url. Kørende containere beholder deres kerne, indtil de genstarter."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den anbefalte kjernen kommer fra systemegenskapen kernel.url. Containere som kjører, beholder kjernen sin til de starter på nytt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suositeltu ydin tulee järjestelmäominaisuudesta kernel.url. Käynnissä olevat kontit käyttävät nykyistä ydintään, kunnes ne käynnistetään uudelleen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalecane jądro pochodzi z właściwości systemowej kernel.url. Uruchomione kontenery zachowują swoje jądro do ponownego uruchomienia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Doporučené jádro pochází ze systémové vlastnosti kernel.url. Spuštěné kontejnery si ponechají své jádro až do restartu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odporúčané jadro pochádza zo systémovej vlastnosti kernel.url. Spustené kontajnery si ponechajú svoje jadro, kým sa nereštartujú."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ajánlott kernel a kernel.url rendszertulajdonságból származik. A futó konténerek az újraindulásukig megtartják a kerneljüket."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Kernelul recomandat provine din proprietatea de sistem kernel.url. Containerele care rulează își păstrează kernelul până la repornire."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Препоръчаното ядро идва от системното свойство kernel.url. Работещите контейнери запазват ядрото си, докато не бъдат рестартирани."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο συνιστώμενος πυρήνας προέρχεται από την ιδιότητα συστήματος kernel.url. Τα κοντέινερ σε εκτέλεση διατηρούν τον πυρήνα τους μέχρι να επανεκκινηθούν."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preporučena jezgra dolazi iz svojstva sustava kernel.url. Pokrenuti kontejneri zadržavaju svoju jezgru do ponovnog pokretanja."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Priporočeno jedro izhaja iz sistemske lastnosti kernel.url. Vsebniki, ki se izvajajo, ohranijo svoje jedro do ponovnega zagona."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Препоручено језгро потиче из системског својства kernel.url. Покренути контејнери задржавају своје језгро до поновног покретања."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Preporučeno jezgro potiče iz sistemskog svojstva kernel.url. Pokrenuti kontejneri zadržavaju svoje jezgro do ponovnog pokretanja."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekomenduojamas branduolys nurodomas sistemos savybėje kernel.url. Veikiantys konteineriai naudoja savo branduolį, kol bus paleisti iš naujo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ieteicamais kodols tiek ņemts no sistēmas rekvizīta kernel.url. Darbojošies konteineri saglabā savu kodolu līdz restartēšanai."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Soovitatav tuum tuleb süsteemiatribuudist kernel.url. Töötavad konteinerid kasutavad oma tuuma kuni taaskäivitumiseni."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекомендоване ядро визначає системна властивість kernel.url. Запущені контейнери використовують своє ядро до перезапуску."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекомендуемое ядро берётся из системного свойства kernel.url. Работающие контейнеры используют прежнее ядро до перезапуска."
          }
        }
      }
    },
