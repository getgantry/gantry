    "Pulling the node image. This can take several minutes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulling the node image. This can take several minutes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在拉取节点镜像。这可能需要几分钟。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Node-Image wird gepullt. Das kann einige Minuten dauern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargement de l'image des nœuds. Cela peut prendre plusieurs minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargando la imagen de los nodos. Puede tardar varios minutos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Download dell'immagine dei nodi. Può richiedere diversi minuti."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A descarregar a imagem dos nós. Pode demorar vários minutos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De node-image wordt gepulld. Dit kan enkele minuten duren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämtar nodimagen. Det kan ta flera minuter."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Henter node-imaget. Det kan tage flere minutter."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Henter node-imaget. Dette kan ta flere minutter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Noudetaan solmun levykuvaa. Tämä voi kestää useita minuutteja."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobieranie obrazu węzła. Może to potrwać kilka minut."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stahuje se image uzlu. Může to trvat několik minut."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sťahuje sa obraz uzla. Môže to trvať niekoľko minút."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A csomópont-image letöltése. Ez több percig is tarthat."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se descarcă imaginea nodurilor. Poate dura câteva minute."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изтегляне на образа на възела. Това може да отнеме няколко минути."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λήψη της εικόνας κόμβου. Μπορεί να διαρκέσει αρκετά λεπτά."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povlačenje slike čvora. To može potrajati nekoliko minuta."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlečenje slike vozlišča. To lahko traja več minut."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Повлачи се слика чвора. Ово може да потраје неколико минута."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Povlači se slika čvora. Ovo može da potraje nekoliko minuta."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atsisiunčiamas mazgo atvaizdas. Tai gali užtrukti kelias minutes."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lejupielādē mezgla attēlu. Tas var aizņemt vairākas minūtes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sõlme tõmmise tõmbamine. See võib kesta mitu minutit."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отримання образу вузла. Це може тривати кілька хвилин."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скачивание образа узла. Это может занять несколько минут."
          }
        }
      }
    },
    "Pulls, builds, deploys and installs show here while they run.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulls, builds, deploys and installs show here while they run."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拉取、构建、部署和安装在运行时显示在这里。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulls, Builds, Deployments und Installationen erscheinen hier, während sie laufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les téléchargements, builds, déploiements et installations s'affichent ici pendant leur exécution."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las descargas, compilaciones, despliegues e instalaciones aparecen aquí mientras se ejecutan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Download, build, deploy e installazioni vengono mostrati qui mentre sono in corso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As descargas, compilações, implementações e instalações aparecem aqui enquanto decorrem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulls, builds, deploys en installaties worden hier weergegeven terwijl ze lopen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämtningar, byggen, driftsättningar och installationer visas här medan de pågår."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hentninger, builds, udrulninger og installationer vises her, mens de kører."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Henting, bygging, utrulling og installering vises her mens de pågår."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Noudot, koonnit, käyttöönotot ja asennukset näkyvät täällä niiden ollessa käynnissä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobieranie obrazów, budowanie, wdrażanie i instalacje są tu widoczne, dopóki trwają."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zde se zobrazují probíhající stahování, sestavení, nasazení a instalace."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sťahovania, zostavenia, nasadenia a inštalácie sa tu zobrazujú, kým prebiehajú."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A letöltések, buildek, üzembe helyezések és telepítések futás közben itt jelennek meg."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descărcările, buildurile, implementările și instalările apar aici cât timp rulează."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изтеглянията, изгражданията, внедряванията и инсталациите се показват тук, докато се изпълняват."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι λήψεις, δομήσεις, αναπτύξεις και εγκαταστάσεις εμφανίζονται εδώ όσο εκτελούνται."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povlačenja, izgradnje, implementacije i instalacije prikazuju se ovdje dok traju."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlečenja, gradnje, uvajanja in namestitve so tukaj prikazani, dokler se izvajajo."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Повлачења, изградње, примене и инсталације се приказују овде док се извршавају."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Povlačenja, izgradnje, primene i instalacije se prikazuju ovde dok se izvršavaju."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Čia rodomi vykdomi atsisiuntimai, kūrimai, išdėstymai ir diegimai."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šeit tiek rādīta lejupielāde, būvēšana, izvietošana un instalēšana, kamēr tās notiek."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõmbamised, koostamised, juurutused ja installimised kuvatakse siin nende käigus."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут показано отримання образів, збирання, розгортання й інсталяції, поки вони тривають."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь показываются выполняемые операции: скачивание образов, сборка, развёртывание и установка."
          }
        }
      }
    },
