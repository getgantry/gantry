    "The apple/container background services must be running for local containers to work.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The apple/container background services must be running for local containers to work."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地容器需要 apple/container 后台服务处于运行状态。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hintergrunddienste von apple/container müssen laufen, damit lokale Container funktionieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les services d'arrière-plan apple/container doivent être en cours d'exécution pour que les conteneurs locaux fonctionnent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los servicios en segundo plano de apple/container deben estar en ejecución para que funcionen los contenedores locales."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I servizi in background di apple/container devono essere in esecuzione perché i container locali funzionino."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os serviços em segundo plano do apple/container têm de estar em execução para os contentores locais funcionarem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De achtergrondservices van apple/container moeten actief zijn om lokale containers te laten werken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakgrundstjänsterna för apple/container måste köras för att lokala containrar ska fungera."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container-baggrundstjenesterne skal køre, for at lokale containere kan fungere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakgrunnstjenestene til apple/container må kjøre for at lokale containere skal fungere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/containerin taustapalvelujen on oltava käynnissä, jotta paikalliset kontit toimivat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby lokalne kontenery działały, usługi w tle apple/container muszą być uruchomione."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby místní kontejnery fungovaly, musí běžet služby apple/container na pozadí."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby lokálne kontajnery fungovali, musia bežať služby apple/container na pozadí."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helyi konténerek működéséhez futniuk kell az apple/container háttérszolgáltatásainak."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serviciile de fundal apple/container trebuie să ruleze pentru ca containerele locale să funcționeze."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоновите услуги на apple/container трябва да работят, за да функционират локалните контейнери."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι υπηρεσίες παρασκηνίου του apple/container πρέπει να εκτελούνται για να λειτουργούν τα τοπικά κοντέινερ."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozadinski servisi apple/container moraju raditi da bi lokalni kontejneri funkcionirali."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za delovanje lokalnih vsebnikov se morajo izvajati storitve apple/container v ozadju."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Позадински сервиси apple/container морају да раде да би локални контејнери функционисали."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozadinski servisi apple/container moraju da rade da bi lokalni kontejneri funkcionisali."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad vietiniai konteineriai veiktų, turi veikti apple/container foninės paslaugos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai lokālie konteineri darbotos, jādarbojas apple/container fona pakalpojumiem."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohalike konteinerite töötamiseks peavad apple/containeri taustateenused töötama."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб локальні контейнери працювали, мають бути запущені фонові служби apple/container."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для работы локальных контейнеров должны быть запущены фоновые службы apple/container."
          }
        }
      }
    },
    "The authenticity of host \"%@\" can't be established. Verify the fingerprint below before trusting this server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The authenticity of host \"%@\" can't be established. Verify the fingerprint below before trusting this server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认主机 “%@” 的真实性。在信任此服务器前，请核验下方指纹。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Echtheit des Hosts „%@“ kann nicht bestätigt werden. Prüfe den Fingerabdruck unten, bevor du diesem Server vertraust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'authenticité de l'hôte « %@ » ne peut pas être vérifiée. Vérifiez l'empreinte ci-dessous avant de faire confiance à ce serveur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede verificar la autenticidad del host “%@”. Comprueba la huella de abajo antes de confiar en este servidor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare l'autenticità dell'host “%@”. Controlla l'impronta qui sotto prima di considerare attendibile questo server."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível confirmar a autenticidade do host “%@”. Verifique a impressão digital abaixo antes de confiar neste servidor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De echtheid van host “%@” kan niet worden vastgesteld. Controleer de vingerafdruk hieronder voordat je deze server vertrouwt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det går inte att bekräfta äktheten hos värden ”%@”. Kontrollera fingeravtrycket nedan innan du litar på den här servern."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ægtheden af værten “%@” kan ikke fastslås. Kontrollér fingeraftrykket nedenfor, før du har tillid til denne server."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentisiteten til verten «%@» kan ikke fastslås. Kontroller fingeravtrykket nedenfor før du stoler på denne serveren."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Isännän ”%@” aitoutta ei voida varmistaa. Tarkista alla oleva sormenjälki ennen kuin luotat tähän palvelimeen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można potwierdzić autentyczności hosta „%@”. Zanim zaufasz temu serwerowi, sprawdź poniższy odcisk."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pravost hostitele „%@“ nelze ověřit. Než tomuto serveru začnete důvěřovat, ověřte otisk níže."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pravosť hostiteľa „%@“ sa nedá overiť. Pred tým, ako tomuto serveru začnete dôverovať, overte odtlačok nižšie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%@” gazdagép hitelessége nem állapítható meg. Mielőtt megbízna ebben a szerverben, ellenőrizze az alábbi ujjlenyomatot."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Autenticitatea gazdei „%@” nu poate fi stabilită. Verificați amprenta de mai jos înainte de a avea încredere în acest server."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Автентичността на хоста „%@“ не може да бъде потвърдена. Проверете пръстовия отпечатък по-долу, преди да се доверите на този сървър."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν είναι δυνατή η επαλήθευση της αυθεντικότητας του host «%@». Επαληθεύστε το παρακάτω αποτύπωμα πριν εμπιστευτείτε αυτόν τον διακομιστή."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće utvrditi autentičnost hosta „%@”. Prije nego što označite ovaj poslužitelj kao pouzdan, provjerite otisak u nastavku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pristnosti gostitelja „%@“ ni mogoče preveriti. Preden zaupate temu strežniku, preverite spodnji prstni odtis."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Аутентичност хоста „%@“ не може да се утврди. Проверите отисак испод пре него што укажете поверење овом серверу."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentičnost hosta „%@“ ne može da se utvrdi. Proverite otisak ispod pre nego što ukažete poverenje ovom serveru."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyksta nustatyti serverio „%@“ autentiškumo. Prieš pasitikėdami šiuo serveriu, patikrinkite toliau pateiktą kontrolinį kodą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Resursdatora „%@” autentiskumu nevar noteikt. Pirms uzticaties šim serverim, pārbaudiet tālāk redzamo pirkstu nospiedumu."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hosti „%@“ autentsust ei saa kindlaks teha. Enne serveri usaldamist kontrollige allolevat sõrmejälge."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неможливо встановити автентичність хоста «%@». Перш ніж довіряти цьому серверу, перевірте відбиток нижче."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удаётся проверить подлинность хоста «%@». Сверьте отпечаток ниже, прежде чем доверять этому серверу."
          }
        }
      }
    },
