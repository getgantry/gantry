        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stroj je pokrenut i bit će zaustavljen."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stroj se izvaja in bo ustavljen."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Машина је покренута и биће заустављена."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Mašina je pokrenuta i biće zaustavljena."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mašina veikia ir bus sustabdyta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mašīna darbojas, un tā tiks apturēta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Masin töötab ja see peatatakse."
          }
        },
        "uk": {
