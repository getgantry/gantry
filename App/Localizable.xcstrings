    "All nodes of the cluster and its kubeconfig context are deleted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All nodes of the cluster and its kubeconfig context are deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "集群的所有节点及其 kubeconfig 上下文将被删除。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Nodes des Clusters und sein kubeconfig-Kontext werden gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les nœuds du cluster et son contexte kubeconfig sont supprimés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan todos los nodos del clúster y su contexto de kubeconfig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i nodi del cluster e il relativo contesto kubeconfig vengono eliminati."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os nós do cluster e o respetivo contexto kubeconfig são eliminados."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle nodes van het cluster en de bijbehorende kubeconfig-context worden verwijderd."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klustrets alla noder och dess kubeconfig-kontext raderas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle noder i klyngen og dens kubeconfig-kontekst slettes."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle nodene i klyngen og kubeconfig-konteksten til klyngen slettes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki klusterin solmut ja sen kubeconfig-konteksti poistetaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie węzły klastra i jego kontekst kubeconfig zostaną usunięte."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny uzly clusteru a jeho kontext v kubeconfig budou smazány."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymažú sa všetky uzly klastra aj jeho kontext v kubeconfig."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A klaszter összes csomópontja és a kubeconfig-környezete törlődik."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate nodurile clusterului și contextul său kubeconfig sunt șterse."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всички възли на клъстера и неговият контекст в kubeconfig ще бъдат изтрити."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράφονται όλοι οι κόμβοι του cluster και το context του στο kubeconfig."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brišu se svi čvorovi klastera i njegov kubeconfig kontekst."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrisana bodo vsa vozlišča gruče in njen kontekst kubeconfig."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Сви чворови кластера и његов kubeconfig контекст се бришу."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Svi čvorovi klastera i njegov kubeconfig kontekst se brišu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bus ištrinti visi klasterio mazgai ir jo kubeconfig kontekstas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiek dzēsti visi klastera mezgli un tā kubeconfig konteksts."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kustutatakse klastri kõik sõlmed ja selle kubeconfig'i kontekst."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Буде видалено всі вузли кластера та його контекст kubeconfig."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все узлы кластера и его контекст kubeconfig будут удалены."
          }
        }
      }
    },
