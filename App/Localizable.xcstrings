    "Hosts from ~/.ssh/config. Picking one fills the fields below.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hosts from ~/.ssh/config. Picking one fills the fields below."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自 ~/.ssh/config 的主机。选择一项会填充下方字段。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hosts aus ~/.ssh/config. Eine Auswahl füllt die Felder unten aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôtes de ~/.ssh/config. En choisir un remplit les champs ci-dessous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hosts de ~/.ssh/config. Al elegir uno se rellenan los campos de abajo."
