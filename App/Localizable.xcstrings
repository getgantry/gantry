    "No Docker socket found yet. The host shows as not installed until one appears.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Docker socket found yet. The host shows as not installed until one appears."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未找到 Docker 套接字。在找到之前，此主机显示为未安装。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Docker-Socket gefunden. Der Host wird als nicht installiert angezeigt, bis einer vorhanden ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun socket Docker trouvé pour l'instant. L'hôte apparaît comme non installé jusqu'à ce qu'un socket soit détecté."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se ha encontrado ningún socket de Docker. El host aparece como no instalado hasta que aparezca uno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun socket Docker ancora trovato. L'host appare come non installato finché non ne compare uno."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não foi encontrado nenhum socket Docker. O host aparece como não instalado até surgir um."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen Docker-socket gevonden. De host wordt als niet geïnstalleerd weergegeven totdat er een verschijnt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen Docker-socket har hittats än. Värden visas som inte installerad tills en dyker upp."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er endnu ikke fundet nogen Docker-socket. Værten vises som ikke installeret, indtil der dukker en op."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ingen Docker-socket ennå. Verten vises som ikke installert til en socket dukker opp."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker-socketia ei ole vielä löytynyt. Isäntä näkyy asentamattomana, kunnes socket ilmestyy."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono jeszcze gniazda Dockera. Do czasu jego pojawienia się host jest oznaczony jako niezainstalowany."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím nebyl nalezen žádný socket Dockeru. Dokud se neobjeví, zobrazuje se hostitel jako nenainstalovaný."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Soket Dockeru sa zatiaľ nenašiel. Kým sa neobjaví, hostiteľ sa zobrazuje ako nenainštalovaný."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nem található Docker-socket. A gazdagép nem telepítettként jelenik meg, amíg egy meg nem jelenik."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu s-a găsit niciun socket Docker. Gazda apare ca neinstalată până când apare unul."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Все още не е открит сокет на Docker. Хостът се показва като неинсталиран, докато не се появи сокет."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκε ακόμη socket Docker. Ο host εμφανίζεται ως μη εγκατεστημένος μέχρι να εμφανιστεί ένα."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker utičnica još nije pronađena. Host se prikazuje kao neinstaliran dok se utičnica ne pojavi."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vtičnica Docker še ni najdena. Gostitelj je prikazan kot nenameščen, dokler se ne pojavi."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker сокет још није пронађен. Хост се приказује као неинсталиран док се сокет не појави."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker soket još nije pronađen. Host se prikazuje kao neinstaliran dok se soket ne pojavi."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker lizdas dar nerastas. Kol jis atsiras, serveris rodomas kaip neįdiegtas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker ligzda vēl nav atrasta. Kamēr tā neparādīsies, resursdators tiks rādīts kā neinstalēts."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockeri soklit pole veel leitud. Kuni seda pole, kuvatakse host installimata olekus."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сокет Docker ще не знайдено. Хост показується як неінстальований, доки сокет не з’явиться."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сокет Docker ещё не найден. До его появления хост помечается как «не установлен»."
          }
        }
      }
    },
