        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα ορίσματα εκκίνησης πυρήνα απαιτούν apple/container %@ ή νεότερο."
          }
        },
        "hr": {
          "stringUnit": {
