          "stringUnit": {
            "state": "translated",
            "value": "Palauttaa kontin lokin viimeiset rivit tekstinä (ei seuraa)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwraca ostatnie wiersze logów kontenera jako tekst (bez śledzenia)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrátí poslední řádky logů kontejneru jako text (bez sledování)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vráti posledné riadky logov kontajnera ako text (nesleduje ďalší výstup)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szövegként adja vissza egy konténer naplójának utolsó sorait (nem követi)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Returnează ultimele linii din jurnalele unui container ca text (fără urmărire)."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Връща последните редове от логовете на контейнер като текст (без следване)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιστρέφει τις τελευταίες γραμμές των αρχείων καταγραφής ενός κοντέινερ ως κείμενο (χωρίς παρακολούθηση)."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraća zadnje retke zapisnika kontejnera kao tekst (bez praćenja)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrne zadnje vrstice dnevnikov vsebnika kot besedilo (brez sledenja)."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Враћа последње редове логова контејнера као текст (без праћења)."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraća poslednje redove logova kontejnera kao tekst (bez praćenja)."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Grąžina paskutines konteinerio žurnalo eilutes kaip tekstą (nesekama)."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atgriež konteinera žurnāla pēdējās rindas kā tekstu (bez sekošanas)."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagastab konteineri logide viimased read tekstina (ei jälgi edasi)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повертає останні рядки журналу контейнера як текст (без стеження)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращает последние строки логов контейнера в виде текста (без отслеживания новых строк)."
          }
        }
      }
    },
