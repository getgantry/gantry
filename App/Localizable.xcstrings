          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilgos operacijos: atsisiuntimai, kūrimai, išdėstymai ir diegimai"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilgas darbības: lejupielāde, būvēšana, izvietošana un instalēšana"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikad toimingud: tõmbamised, koostamised, juurutused ja installimised"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тривалі операції: отримання образів, збирання, розгортання та інсталяція"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Длительные операции: скачивание образов, сборка, развёртывание и установка"
          }
        }
      }
    },
