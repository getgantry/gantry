    "Run a container from an image to see it here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run a container from an image to see it here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从镜像运行一个容器后，它会显示在这里。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe einen Container aus einem Image aus, damit er hier erscheint."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécutez un conteneur à partir d'une image pour le voir ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta un contenedor a partir de una imagen para verlo aquí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui un container da un'immagine per vederlo qui."
          }
        },
