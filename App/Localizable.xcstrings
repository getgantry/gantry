    "apple/container checks the credentials with the registry and keeps them in your keychain. Gantry does not save the password.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container checks the credentials with the registry and keeps them in your keychain. Gantry does not save the password."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container 会向镜像仓库验证凭据并将其保存在你的钥匙串中。Gantry 不会保存密码。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container prüft die Anmeldedaten bei der Registry und bewahrt sie in deinem Schlüsselbund auf. Gantry speichert das Passwort nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container vérifie les identifiants auprès du registre et les conserve dans votre trousseau. Gantry n'enregistre pas le mot de passe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container comprueba las credenciales con el registro y las guarda en tu llavero. Gantry no guarda la contraseña."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container verifica le credenziali con il registro e le conserva nel portachiavi. Gantry non salva la password."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O apple/container verifica as credenciais com o registo e guarda-as no seu porta-chaves. O Gantry não guarda a palavra-passe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container controleert de inloggegevens bij de registry en bewaart ze in je sleutelhanger. Gantry bewaart het wachtwoord niet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container kontrollerar inloggningsuppgifterna mot registret och sparar dem i din nyckelring. Gantry sparar inte lösenordet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container kontrollerer loginoplysningerne hos registryet og gemmer dem i din nøglering. Gantry gemmer ikke adgangskoden."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container kontrollerer påloggingsinformasjonen mot registeret og oppbevarer den i nøkkelringen din. Gantry lagrer ikke passordet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container tarkistaa kirjautumistiedot rekisteristä ja säilyttää ne avainnipussasi. Gantry ei tallenna salasanaa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container sprawdza dane logowania w rejestrze i przechowuje je w pęku kluczy. Gantry nie zapisuje hasła."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container ověří přihlašovací údaje u registru a uloží je do vaší Klíčenky. Gantry heslo neukládá."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container overí prihlasovacie údaje v registri a uchová ich vo vašej Kľúčenke. Gantry heslo neukladá."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az apple/container ellenőrzi a hitelesítő adatokat a registryvel, és a Kulcskarikában tárolja őket. A Gantry nem menti a jelszót."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container verifică datele de autentificare cu registrul și le păstrează în portchei. Gantry nu salvează parola."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container проверява идентификационните данни в регистъра и ги съхранява във вашия Ключодържател. Gantry не запазва паролата."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το apple/container ελέγχει τα διαπιστευτήρια με το μητρώο και τα διατηρεί στην Κλειδοθήκη σας. Το Gantry δεν αποθηκεύει το συνθηματικό."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container provjerava vjerodajnice s registrom i čuva ih u vašem privjesku ključeva. Gantry ne sprema lozinku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container preveri poverilnice pri registru in jih shrani v vaš obesek za ključe. Gantry gesla ne shrani."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container проверава акредитиве код регистра и чува их у вашем привеску за кључеве. Gantry не чува лозинку."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container proverava akreditive kod registra i čuva ih u vašem privesku za ključeve. Gantry ne čuva lozinku."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container patikrina prisijungimo duomenis registre ir saugo juos jūsų raktinėje. Gantry slaptažodžio neišsaugo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container pārbauda akreditācijas datus reģistrā un glabā tos jūsu atslēgu piekariņā. Gantry paroli nesaglabā."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container kontrollib mandaate registris ja hoiab neid teie võtmerõngas. Gantry parooli ei salvesta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container перевіряє облікові дані в реєстрі та зберігає їх у вашій в’язці ключів. Gantry не зберігає пароль."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container проверяет учётные данные в реестре и хранит их в вашей Связке ключей. Gantry не сохраняет пароль."
          }
        }
      }
    },
