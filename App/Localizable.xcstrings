    "Homebrew (without `container machine`) is also available: install [Homebrew](https://brew.sh), then run `brew %@ %@`.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew (without `container machine`) is also available: install [Homebrew](https://brew.sh), then run `brew %@ %@`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也可以使用 Homebrew（不含 `container machine`）：安装 [Homebrew](https://brew.sh)，然后运行 `brew %@ %@`。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew (ohne `container machine`) ist ebenfalls verfügbar: Installiere [Homebrew](https://brew.sh) und führe dann `brew %@ %@` aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew (sans `container machine`) est aussi disponible : installez [Homebrew](https://brew.sh), puis exécutez `brew %@ %@`."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew (sin `container machine`) también está disponible: instala [Homebrew](https://brew.sh) y luego ejecuta `brew %@ %@`."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È disponibile anche Homebrew (senza `container machine`): installa [Homebrew](https://brew.sh), quindi esegui `brew %@ %@`."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Homebrew (sem `container machine`) também está disponível: instale o [Homebrew](https://brew.sh) e, em seguida, execute `brew %@ %@`."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew (zonder `container machine`) is ook beschikbaar: installeer [Homebrew](https://brew.sh) en voer daarna `brew %@ %@` uit."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew (utan `container machine`) finns också: installera [Homebrew](https://brew.sh) och kör sedan `brew %@ %@`."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew (uden `container machine`) er også tilgængelig: installer [Homebrew](https://brew.sh), og kør derefter `brew %@ %@`."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew (uten `container machine`) er også tilgjengelig: installer [Homebrew](https://brew.sh), og kjør deretter `brew %@ %@`."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Myös Homebrew (ilman komentoa `container machine`) on käytettävissä: asenna [Homebrew](https://brew.sh) ja suorita `brew %@ %@`."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostępny jest też Homebrew (bez `container machine`): zainstaluj [Homebrew](https://brew.sh), a potem wykonaj `brew %@ %@`."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K dispozici je také Homebrew (bez `container machine`): nainstalujte [Homebrew](https://brew.sh) a spusťte `brew %@ %@`."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "K dispozícii je aj Homebrew (bez `container machine`): nainštalujte [Homebrew](https://brew.sh) a potom spustite `brew %@ %@`."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Homebrew is elérhető (`container machine` nélkül): telepítse a [Homebrew-t](https://brew.sh), majd futtassa a `brew %@ %@` parancsot."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este disponibil și Homebrew (fără `container machine`): instalați [Homebrew](https://brew.sh), apoi rulați `brew %@ %@`."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Има и вариант чрез Homebrew (без `container machine`): инсталирайте [Homebrew](https://brew.sh), след което изпълнете `brew %@ %@`."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διατίθεται επίσης μέσω Homebrew (χωρίς `container machine`): εγκαταστήστε το [Homebrew](https://brew.sh) και εκτελέστε `brew %@ %@`."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostupan je i Homebrew (bez `container machine`): instalirajte [Homebrew](https://brew.sh), zatim pokrenite `brew %@ %@`."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na voljo je tudi Homebrew (brez `container machine`): namestite [Homebrew](https://brew.sh) in zaženite `brew %@ %@`."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступан је и Homebrew (без `container machine`): инсталирајте [Homebrew](https://brew.sh), па покрените `brew %@ %@`."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostupan je i Homebrew (bez `container machine`): instalirajte [Homebrew](https://brew.sh), pa pokrenite `brew %@ %@`."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Taip pat galima naudoti Homebrew (be `container machine`): įdiekite [Homebrew](https://brew.sh) ir paleiskite `brew %@ %@`."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieejams arī Homebrew (bez `container machine`): instalējiet [Homebrew](https://brew.sh) un pēc tam palaidiet `brew %@ %@`."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Saadaval on ka Homebrew (ilma `container machine`’ita): installige [Homebrew](https://brew.sh) ja käivitage `brew %@ %@`."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Також доступний Homebrew (без `container machine`): інсталюйте [Homebrew](https://brew.sh), а потім виконайте `brew %@ %@`."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Также можно установить через Homebrew (без `container machine`): установите [Homebrew](https://brew.sh), затем выполните `brew %@ %@`."
          }
        }
      }
    },
