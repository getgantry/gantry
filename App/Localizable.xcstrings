    "Stop and start the services. Running containers stop.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop and start the services. Running containers stop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止并启动服务。正在运行的容器将停止。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dienste stoppen und erneut starten. Laufende Container werden gestoppt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter et redémarrer les services. Les conteneurs en cours d'exécution s'arrêtent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener e iniciar los servicios. Los contenedores en ejecución se detienen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arresta e riavvia i servizi. I container in esecuzione si arrestano."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar e iniciar os serviços. Os contentores em execução param."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop en start de services. Actieve containers worden gestopt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppa och starta tjänsterna. Containrar som körs stoppas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop og start tjenesterne. Kørende containere stopper."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopp og start tjenestene. Kjørende containere stoppes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pysäytä ja käynnistä palvelut. Käynnissä olevat kontit pysähtyvät."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymaj i uruchom usługi. Uruchomione kontenery zostaną zatrzymane."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastaví a znovu spustí služby. Spuštěné kontejnery se zastaví."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastaviť a znova spustiť služby. Spustené kontajnery sa zastavia."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szolgáltatások leállítása és elindítása. A futó konténerek leállnak."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprește și pornește serviciile. Containerele în execuție se opresc."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Спиране и стартиране на услугите. Работещите контейнери ще бъдат спрени."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διακοπή και έναρξη των υπηρεσιών. Τα κοντέινερ σε εκτέλεση διακόπτονται."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaustavlja i ponovno pokreće servise. Pokrenuti kontejneri se zaustavljaju."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustavi in znova zaženi storitve. Vsebniki, ki se izvajajo, se ustavijo."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Зауставља и поново покреће сервисе. Покренути контејнери се заустављају."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaustavlja i ponovo pokreće servise. Pokrenuti kontejneri se zaustavljaju."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustabdyti ir paleisti paslaugas. Veikiantys konteineriai sustabdomi."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apturēt un startēt pakalpojumus. Darbojošies konteineri tiek apturēti."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Peata ja käivita teenused. Töötavad konteinerid peatuvad."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупинити й запустити служби. Запущені контейнери буде зупинено."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановить и запустить службы. Работающие контейнеры остановятся."
          }
        }
      }
    },
    "The CLI and the API server run different versions. Restart the services after an update.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The CLI and the API server run different versions. Restart the services after an update."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 与 API 服务器的版本不同。更新后请重启服务。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI und API-Server laufen mit unterschiedlichen Versionen. Starte die Dienste nach einem Update neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La CLI et le serveur API ne sont pas à la même version. Redémarrez les services après une mise à jour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La CLI y el servidor API ejecutan versiones distintas. Reinicia los servicios después de una actualización."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La CLI e il server API eseguono versioni diverse. Riavvia i servizi dopo un aggiornamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A CLI e o servidor API executam versões diferentes. Reinicie os serviços após uma atualização."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De CLI en de API-server draaien verschillende versies. Herstart de services na een update."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI:et och API-servern kör olika versioner. Starta om tjänsterna efter en uppdatering."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI'en og API-serveren kører forskellige versioner. Genstart tjenesterne efter en opdatering."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI-en og API-serveren kjører forskjellige versjoner. Start tjenestene på nytt etter en oppdatering."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI ja API-palvelin ovat eri versioita. Käynnistä palvelut uudelleen päivityksen jälkeen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI i serwer API działają w różnych wersjach. Po uaktualnieniu uruchom ponownie usługi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI a server API běží v různých verzích. Po aktualizaci restartujte služby."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI a server API majú rozdielne verzie. Po aktualizácii reštartujte služby."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A CLI és az API-szerver eltérő verziót futtat. Frissítés után indítsa újra a szolgáltatásokat."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI-ul și serverul API rulează versiuni diferite. Reporniți serviciile după o actualizare."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI и API сървърът са с различни версии. Рестартирайте услугите след актуализация."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το CLI και ο διακομιστής API εκτελούν διαφορετικές εκδόσεις. Επανεκκινήστε τις υπηρεσίες μετά από ενημέρωση."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI i API poslužitelj imaju različite verzije. Nakon ažuriranja ponovno pokrenite servise."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Različici CLI in strežnika API se ne ujemata. Po posodobitvi znova zaženite storitve."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI и API сервер раде у различитим верзијама. Поново покрените сервисе након ажурирања."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI i API server rade u različitim verzijama. Ponovo pokrenite servise nakon ažuriranja."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI ir API serveris veikia skirtingomis versijomis. Po atnaujinimo paleiskite paslaugas iš naujo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI un API serverim ir dažādas versijas. Pēc atjaunināšanas restartējiet pakalpojumus."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI ja API-server töötavad erinevate versioonidega. Taaskäivitage teenused pärast uuendamist."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI та API-сервер мають різні версії. Перезапустіть служби після оновлення."
          }
        },
        "ru": {
          "stringUnit": {
