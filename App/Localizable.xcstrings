    "Restart ${container} on ${host}": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart ${container} on ${host}"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重启 ${host} 上的 ${container}"
          }
        },
