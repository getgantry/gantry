    "Process information is only available while the container is running.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Process information is only available while the container is running."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在容器运行时可查看进程信息。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prozessinformationen sind nur verfügbar, während der Container läuft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations sur les processus ne sont disponibles que lorsque le conteneur est en cours d'exécution."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La información de procesos solo está disponible mientras el contenedor está en ejecución."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le informazioni sui processi sono disponibili solo mentre il container è in esecuzione."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As informações dos processos só estão disponíveis enquanto o contentor está em execução."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Procesinformatie is alleen beschikbaar terwijl de container actief is."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Processinformation är bara tillgänglig medan containern körs."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Procesoplysninger er kun tilgængelige, mens containeren kører."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosessinformasjon er bare tilgjengelig mens containeren kjører."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosessitiedot ovat saatavilla vain, kun kontti on käynnissä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Informacje o procesach są dostępne tylko wtedy, gdy kontener działa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Informace o procesech jsou k dispozici, jen když kontejner běží."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Informácie o procesoch sú dostupné, iba keď je kontajner spustený."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A folyamatadatok csak akkor érhetők el, ha a konténer fut."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Informațiile despre procese sunt disponibile doar cât timp containerul rulează."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Информация за процесите е достъпна само докато контейнерът работи."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι πληροφορίες διεργασιών είναι διαθέσιμες μόνο όσο εκτελείται το κοντέινερ."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaci o procesima dostupni su samo dok je kontejner pokrenut."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podatki o procesih so na voljo samo, ko se vsebnik izvaja."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Подаци о процесима су доступни само док је контејнер покренут."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaci o procesima su dostupni samo dok je kontejner pokrenut."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Procesų informacija pasiekiama tik tada, kai konteineris veikia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Informācija par procesiem pieejama tikai tad, kad konteiners darbojas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Protsesside teave on saadaval ainult siis, kui konteiner töötab."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відомості про процеси доступні, лише поки контейнер працює."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сведения о процессах доступны, только пока контейнер работает."
          }
        }
      }
    },
