          "stringUnit": {
            "state": "translated",
            "value": "Uudelleenkoonneista jääneet tagittomat levykuvakerrokset."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Warstwy obrazów bez tagu pozostałe po ponownym budowaniu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrstvy imagů bez tagu, které zůstaly po opětovných sestaveních."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Neoznačené vrstvy obrazov, ktoré zostali po opätovných zostaveniach."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Újrabuildelésekből visszamaradt, címke nélküli image-rétegek."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Straturi de imagine fără tag rămase de la reconstruiri."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Слоеве на образи без таг, останали от повторни изграждания."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίπεδα εικόνων χωρίς ετικέτα που απέμειναν από επαναδομήσεις."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slojevi slika bez oznake preostali nakon ponovnih izgradnji."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neoznačene plasti slik, ki so ostale po ponovnih gradnjah."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Слојеви слика без ознаке који су остали након поновних изградњи."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Slojevi slika bez oznake koji su ostali nakon ponovnih izgradnji."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepažymėti atvaizdų sluoksniai, likę po perkūrimų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Attēlu slāņi bez taga, kas palikuši pēc atkārtotas būvēšanas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Uuesti koostamisest järele jäänud sildita tõmmise kihid."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шари образів без тегів, що лишилися після повторних збірок."
