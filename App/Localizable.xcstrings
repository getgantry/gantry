    "Creating pulls the image and boots a long-lived Linux environment.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creating pulls the image and boots a long-lived Linux environment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建时会拉取镜像并启动长期运行的 Linux 环境。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Erstellen wird das Image gepullt und eine dauerhafte Linux-Umgebung gestartet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La création télécharge l'image et démarre un environnement Linux durable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al crearla se descarga la imagen y se inicia un entorno Linux duradero."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La creazione scarica l'immagine e avvia un ambiente Linux persistente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A criação descarrega a imagem e arranca um ambiente Linux duradouro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij het aanmaken wordt de image gepulld en een blijvende Linux-omgeving opgestart."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När maskinen skapas hämtas imagen och en långlivad Linux-miljö startas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprettelsen henter imaget og starter et varigt Linux-miljø."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprettingen henter imaget og starter et varig Linux-miljø."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luonti noutaa levykuvan ja käynnistää pysyvän Linux-ympäristön."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tworzenie pobiera obraz i uruchamia trwałe środowisko Linux."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při vytvoření se stáhne image a spustí se dlouhodobé linuxové prostředí."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri vytváraní sa stiahne obraz a spustí sa dlhodobé linuxové prostredie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A létrehozás letölti az image-et, és elindít egy hosszú életű Linux-környezetet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Crearea descarcă imaginea și pornește un mediu Linux de lungă durată."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "При създаването образът се изтегля и се стартира дълготрайна Linux среда."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η δημιουργία κάνει λήψη της εικόνας και εκκινεί ένα μόνιμο περιβάλλον Linux."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stvaranje povlači sliku i pokreće trajno Linux okruženje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustvarjanje povleče sliko in zažene trajno okolje Linux."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Креирање повлачи слику и покреће трајно Linux окружење."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreiranje povlači sliku i pokreće trajno Linux okruženje."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuriant atsisiunčiamas atvaizdas ir paleidžiama ilgalaikė Linux aplinka."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izveidojot tiek lejupielādēts attēls un sāknēta ilgstoša Linux vide."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loomisel tõmmatakse tõmmis ja buutitakse püsiv Linuxi keskkond."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час створення буде отримано образ і запущено постійне середовище Linux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При создании Gantry скачивает образ и запускает постоянную среду Linux."
          }
        }
      }
    },
    "Creating pulls the node image and can take several minutes. The progress shows in the cluster list. The cluster context is added to ~/.kube/config.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creating pulls the node image and can take several minutes. The progress shows in the cluster list. The cluster context is added to ~/.kube/config."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建时会拉取节点镜像，可能需要几分钟。进度显示在集群列表中。集群上下文将添加到 ~/.kube/config。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Erstellen wird das Node-Image gepullt; das kann einige Minuten dauern. Der Fortschritt erscheint in der Clusterliste. Der Clusterkontext wird zu ~/.kube/config hinzugefügt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La création télécharge l'image des nœuds et peut prendre plusieurs minutes. La progression s'affiche dans la liste des clusters. Le contexte du cluster est ajouté à ~/.kube/config."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al crearlo se descarga la imagen de los nodos, lo que puede tardar varios minutos. El progreso se muestra en la lista de clústeres. El contexto del clúster se añade a ~/.kube/config."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La creazione scarica l'immagine dei nodi e può richiedere diversi minuti. L'avanzamento è visibile nell'elenco dei cluster. Il contesto del cluster viene aggiunto a ~/.kube/config."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A criação descarrega a imagem dos nós e pode demorar vários minutos. O progresso é mostrado na lista de clusters. O contexto do cluster é adicionado a ~/.kube/config."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij het aanmaken wordt de node-image gepulld; dit kan enkele minuten duren. De voortgang staat in de clusterlijst. De clustercontext wordt toegevoegd aan ~/.kube/config."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När klustret skapas hämtas nodimagen, vilket kan ta flera minuter. Förloppet visas i klusterlistan. Klustrets kontext läggs till i ~/.kube/config."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprettelsen henter node-imaget og kan tage flere minutter. Status vises i klyngelisten. Klyngens kontekst føjes til ~/.kube/config."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprettingen henter node-imaget og kan ta flere minutter. Fremdriften vises i klyngelisten. Klyngekonteksten legges til i ~/.kube/config."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luonti noutaa solmun levykuvan ja voi kestää useita minuutteja. Edistyminen näkyy klusteriluettelossa. Klusterin konteksti lisätään tiedostoon ~/.kube/config."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tworzenie pobiera obraz węzła i może potrwać kilka minut. Postęp jest widoczny na liście klastrów. Kontekst klastra zostanie dodany do ~/.kube/config."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při vytvoření se stáhne image uzlu, což může trvat několik minut. Průběh se zobrazuje v seznamu clusterů. Kontext clusteru se přidá do ~/.kube/config."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri vytváraní sa stiahne obraz uzla, čo môže trvať niekoľko minút. Priebeh sa zobrazuje v zozname klastrov. Kontext klastra sa pridá do ~/.kube/config."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A létrehozás letölti a csomópont-image-et, és több percig is tarthat. A folyamat a klaszterlistában látható. A klaszter környezete bekerül a ~/.kube/config fájlba."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Crearea descarcă imaginea nodurilor și poate dura câteva minute. Progresul apare în lista de clustere. Contextul clusterului este adăugat în ~/.kube/config."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "При създаването се изтегля образът на възела, което може да отнеме няколко минути. Напредъкът се показва в списъка с клъстери. Контекстът на клъстера се добавя в ~/.kube/config."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η δημιουργία κάνει λήψη της εικόνας κόμβου και μπορεί να διαρκέσει αρκετά λεπτά. Η πρόοδος εμφανίζεται στη λίστα των cluster. Το context του cluster προστίθεται στο ~/.kube/config."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stvaranje povlači sliku čvora i može potrajati nekoliko minuta. Napredak se prikazuje na popisu klastera. Kontekst klastera dodaje se u ~/.kube/config."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustvarjanje povleče sliko vozlišča in lahko traja več minut. Napredek je prikazan na seznamu gruč. Kontekst gruče se doda v ~/.kube/config."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Креирање повлачи слику чвора и може да потраје неколико минута. Напредак се види у листи кластера. Контекст кластера се додаје у ~/.kube/config."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreiranje povlači sliku čvora i može da potraje nekoliko minuta. Napredak se vidi u listi klastera. Kontekst klastera se dodaje u ~/.kube/config."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuriant atsisiunčiamas mazgo atvaizdas; tai gali užtrukti kelias minutes. Eiga rodoma klasterių sąraše. Klasterio kontekstas pridedamas į ~/.kube/config."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izveidojot tiek lejupielādēts mezgla attēls, un tas var aizņemt vairākas minūtes. Progress redzams klasteru sarakstā. Klastera konteksts tiek pievienots failam ~/.kube/config."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loomisel tõmmatakse sõlme tõmmis ja see võib kesta mitu minutit. Edenemist näete klastrite loendis. Klastri kontekst lisatakse faili ~/.kube/config."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час створення буде отримано образ вузла; це може тривати кілька хвилин. Перебіг показано в списку кластерів. Контекст кластера буде додано до ~/.kube/config."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При создании Gantry скачивает образ узла — это может занять несколько минут. Ход создания виден в списке кластеров. Контекст кластера добавляется в ~/.kube/config."
          }
        }
      }
    },
