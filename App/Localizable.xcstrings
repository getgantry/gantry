    "No builder container exists yet. `container build` creates one on first use, or start it here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No builder container exists yet. `container build` creates one on first use, or start it here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无构建器容器。`container build` 首次使用时会创建一个，也可以在此启动。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt noch keinen Builder-Container. `container build` erstellt ihn bei der ersten Verwendung, oder du startest ihn hier."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun conteneur builder n'existe encore. `container build` en crée un à la première utilisation, ou vous pouvez le démarrer ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no existe ningún contenedor del builder. `container build` crea uno la primera vez que se usa; también puedes iniciarlo aquí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non esiste ancora alcun container del builder. `container build` ne crea uno al primo utilizzo, oppure puoi avviarlo da qui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não existe nenhum contentor do builder. O `container build` cria um na primeira utilização, ou pode iniciá-lo aqui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er bestaat nog geen buildercontainer. `container build` maakt er een aan bij het eerste gebruik, of start hem hier."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns ingen byggarcontainer än. `container build` skapar en vid första användningen, eller så kan du starta den här."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der findes endnu ingen builder-container. `container build` opretter en ved første brug, eller du kan starte den her."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finnes ingen bygger-container ennå. `container build` oppretter en ved første bruk, eller du kan starte den her."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koontityökalun konttia ei ole vielä olemassa. `container build` luo sen ensimmäisellä käyttökerralla, tai voit käynnistää sen täällä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontener buildera jeszcze nie istnieje. `container build` utworzy go przy pierwszym użyciu albo możesz go uruchomić tutaj."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontejner builderu zatím neexistuje. `container build` ho vytvoří při prvním použití, nebo ho spusťte zde."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontajner buildera zatiaľ neexistuje. `container build` ho vytvorí pri prvom použití, alebo ho spustite tu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs builder-konténer. A `container build` az első használatkor létrehoz egyet, vagy itt is elindíthatja."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu există niciun container builder. `container build` creează unul la prima utilizare sau îl puteți porni de aici."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Все още няма контейнер на билдъра. `container build` създава такъв при първото използване, но можете да го стартирате и тук."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει ακόμη κοντέινερ builder. Το `container build` δημιουργεί ένα στην πρώτη χρήση, ή ξεκινήστε το εδώ."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontejner buildera još ne postoji. `container build` stvara ga pri prvoj upotrebi, a možete ga pokrenuti i ovdje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsebnik graditelja še ne obstaja. `container build` ga ustvari ob prvi uporabi, lahko pa ga zaženete tukaj."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Контејнер билдера још не постоји. `container build` га креира при првој употреби, или га покрените овде."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontejner bildera još ne postoji. `container build` ga kreira pri prvoj upotrebi, ili ga pokrenite ovde."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kūrimo įrankio konteinerio dar nėra. `container build` jį sukuria pirmą kartą naudojant, arba galite jį paleisti čia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Būvētāja konteiners vēl nepastāv. `container build` to izveido pirmajā lietošanas reizē, vai arī startējiet to šeit."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Koostaja konteinerit veel pole. `container build` loob selle esimesel kasutamisel või käivitage see siin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Контейнера збирача ще немає. `container build` створить його під час першого використання, або ви можете запустити його тут."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контейнера сборщика ещё нет. Его создаст `container build` при первом использовании, или его можно запустить здесь."
          }
        }
      }
    },
