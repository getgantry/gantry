    "It's the only build with the **Machines** backend (`container machine`). Download the `.pkg`, then run it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's the only build with the **Machines** backend (`container machine`). Download the `.pkg`, then run it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是唯一包含 **Machines** 后端（`container machine`）的构建。下载 `.pkg` 后运行即可。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur dieser Build enthält das **Machines**-Backend (`container machine`). Lade das `.pkg` herunter und führe es aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est la seule version qui inclut le backend **Machines** (`container machine`). Téléchargez le `.pkg`, puis exécutez-le."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es la única versión con el backend **Machines** (`container machine`). Descarga el `.pkg` y ejecútalo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È l'unica build con il backend **Machines** (`container machine`). Scarica il `.pkg`, quindi eseguilo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É a única versão com o backend **Machines** (`container machine`). Descarregue o `.pkg` e, em seguida, execute-o."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is de enige build met de **Machines**-backend (`container machine`). Download het `.pkg`-bestand en voer het daarna uit."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är den enda versionen med **Machines**-backend (`container machine`). Hämta `.pkg`-filen och kör den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er den eneste build med **Machines**-backenden (`container machine`). Download `.pkg`-filen, og kør den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er den eneste versjonen med **Machines**-backenden (`container machine`). Last ned `.pkg`-filen, og kjør den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on ainoa versio, jossa on **Machines**-taustajärjestelmä (`container machine`). Lataa `.pkg` ja suorita se."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To jedyna kompilacja z backendem **Maszyny** (`container machine`). Pobierz plik `.pkg` i uruchom go."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to jediné sestavení s backendem **Machines** (`container machine`). Stáhněte balíček `.pkg` a spusťte ho."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to jediné zostavenie s backendom **Stroje** (`container machine`). Stiahnite súbor `.pkg` a potom ho spustite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az egyetlen build a **Machines** háttérrendszerrel (`container machine`). Töltse le a `.pkg` fájlt, majd futtassa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este singura versiune cu backendul **Machines** (`container machine`). Descărcați fișierul `.pkg`, apoi rulați-l."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това е единствената версия с бекенда **Машини** (`container machine`). Изтеглете `.pkg` файла и го стартирайте."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι η μόνη έκδοση με το backend **Μηχανήματα** (`container machine`). Κάντε λήψη του `.pkg` και εκτελέστε το."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "To je jedina verzija s pozadinskim sustavom **Machines** (`container machine`). Preuzmite `.pkg` i zatim ga pokrenite."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To je edina različica z zaledjem **Stroji** (`container machine`). Prenesite datoteko `.pkg` in jo zaženite."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "То је једина верзија са позадинским системом **Машине** (`container machine`). Преузмите `.pkg`, па га покрените."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "To je jedina verzija sa pozadinskim sistemom **Mašine** (`container machine`). Preuzmite `.pkg`, pa ga pokrenite."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik šiame leidime yra **Machines** posistemė (`container machine`). Atsisiųskite `.pkg` ir paleiskite jį."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tikai šajā būvējumā ir **Machines** aizmugursistēma (`container machine`). Lejupielādējiet `.pkg` un palaidiet to."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See on ainus järk, millel on **Machines**-taustsüsteem (`container machine`). Laadige alla `.pkg` ja käivitage see."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
