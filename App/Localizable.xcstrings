    "%lld containers use this image. Use Force Remove to remove it anyway.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld containers use this image. Use Force Remove to remove it anyway."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个容器使用此镜像。可使用强制移除仍将其移除。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Container verwenden dieses Image. Wähle „Entfernen erzwingen“, um es trotzdem zu entfernen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
