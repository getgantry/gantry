    "Bind-mount a macOS folder into the container at create time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bind-mount a macOS folder into the container at create time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建时将 macOS 文件夹绑定挂载到容器中。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
