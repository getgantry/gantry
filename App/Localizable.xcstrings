    "Writes the YAML to the file, then uses it for Up.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writes the YAML to the file, then uses it for Up."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 YAML 写入文件，然后用于启动。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibt das YAML in die Datei und verwendet es dann zum Starten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrit le YAML dans le fichier, puis l'utilise pour Up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe el YAML en el archivo y luego lo usa con “Levantar”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrive lo YAML nel file, quindi lo usa con Avvia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreve o YAML no ficheiro e, em seguida, utiliza-o para o Up."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijft de YAML naar het bestand en gebruikt het daarna voor “Start”."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriver YAML-koden till filen och använder den sedan för Compose Up."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriver YAML til filen og starter derefter projektet med den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriver YAML-en til filen og bruker den deretter til å starte prosjektet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoittaa YAMLin tiedostoon ja käyttää sitä käynnistyksessä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuje YAML do pliku, a następnie używa go przy uruchamianiu (Up)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapíše YAML do souboru a pak ho použije pro Up."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapíše YAML do súboru a potom ho použije pri spustení."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A YAML-t a fájlba írja, majd azt használja az indításhoz."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrie YAML-ul în fișier, apoi îl folosește pentru Up."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Записва YAML във файла и след това го използва за стартирането."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γράφει το YAML στο αρχείο και μετά το χρησιμοποιεί για την «Εκκίνηση»."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuje YAML u datoteku, a zatim ga koristi za pokretanje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapiše YAML v datoteko in ga nato uporabi za zagon."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Уписује YAML у датотеку, а затим је користи за Compose Up."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Upisuje YAML u datoteku, a zatim je koristi za Compose Up."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
