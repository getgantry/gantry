    "Containers can no longer use this local domain.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Containers can no longer use this local domain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "容器将无法再使用此本地域名。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Container können diese lokale Domain nicht mehr verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les conteneurs ne peuvent plus utiliser ce domaine local."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los contenedores ya no pueden usar este dominio local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I container non possono più usare questo dominio locale."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os contentores deixam de poder utilizar este domínio local."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Containers kunnen dit lokale domein niet meer gebruiken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Containrar kan inte längre använda den här lokala domänen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Containere kan ikke længere bruge dette lokale domæne."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Containere kan ikke lenger bruke dette lokale domenet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontit eivät voi enää käyttää tätä paikallista verkkotunnusta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontenery nie mogą już używać tej domeny lokalnej."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontejnery již nemohou tuto místní doménu používat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontajnery už nemôžu používať túto lokálnu doménu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A konténerek többé nem használhatják ezt a helyi tartományt."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Containerele nu mai pot folosi acest domeniu local."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Контейнерите вече не могат да използват този локален домейн."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα κοντέινερ δεν μπορούν πλέον να χρησιμοποιούν αυτόν τον τοπικό τομέα."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontejneri više ne mogu koristiti ovu lokalnu domenu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsebniki ne morejo več uporabljati te lokalne domene."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Контејнери више не могу да користе овај локални домен."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontejneri više ne mogu da koriste ovaj lokalni domen."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Konteineriai nebegalės naudoti šio vietinio domeno."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Konteineri vairs nevar izmantot šo lokālo domēnu."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Konteinerid ei saa seda kohalikku domeeni enam kasutada."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Контейнери більше не можуть використовувати цей локальний домен."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контейнеры больше не смогут использовать этот локальный домен."
          }
        }
      }
    },
    "Containers cannot run until the services start again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Containers cannot run until the services start again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在服务重新启动之前，容器无法运行。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Container können erst wieder laufen, wenn die Dienste erneut gestartet sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les conteneurs ne peuvent pas s'exécuter tant que les services ne redémarrent pas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los contenedores no pueden ejecutarse hasta que los servicios vuelvan a iniciarse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I container non possono essere eseguiti finché i servizi non vengono riavviati."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os contentores não podem ser executados até os serviços voltarem a iniciar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Containers kunnen pas weer draaien als de services opnieuw zijn gestart."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Containrar kan inte köras förrän tjänsterna startar igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Containere kan ikke køre, før tjenesterne starter igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Containere kan ikke kjøre før tjenestene starter igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontteja ei voi suorittaa, ennen kuin palvelut käynnistyvät uudelleen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontenery nie mogą działać, dopóki usługi nie zostaną ponownie uruchomione."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontejnery nelze spustit, dokud se služby znovu nespustí."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontajnery nemôžu bežať, kým sa služby znova nespustia."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A konténerek nem futhatnak, amíg a szolgáltatások újra el nem indulnak."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Containerele nu pot rula până când serviciile nu pornesc din nou."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Контейнерите не могат да работят, докато услугите не бъдат стартирани отново."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα κοντέινερ δεν μπορούν να εκτελεστούν μέχρι να ξεκινήσουν ξανά οι υπηρεσίες."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontejneri se ne mogu pokretati dok se servisi ponovno ne pokrenu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsebnikov ni mogoče zagnati, dokler se storitve znova ne zaženejo."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Контејнери не могу да се покрену док се сервиси поново не покрену."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontejneri ne mogu da se pokrenu dok se servisi ponovo ne pokrenu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Konteinerių nebus galima paleisti, kol paslaugos nebus vėl paleistos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Konteinerus nevar palaist, kamēr pakalpojumi nav atkal startēti."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Konteinerid ei saa töötada enne, kui teenused uuesti käivituvad."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Контейнери не можуть працювати, доки служби не запустяться знову."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контейнеры не смогут работать, пока службы снова не запустятся."
          }
        }
      }
    },
    "Containers that have exited and aren't coming back on their own.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Containers that have exited and aren't coming back on their own."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已退出且不会自行恢复的容器。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Container, die beendet wurden und nicht von selbst neu starten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conteneurs qui se sont arrêtés et ne redémarreront pas d'eux-mêmes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenedores que han finalizado y no volverán a iniciarse por sí solos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Container terminati che non ripartiranno da soli."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Contentores que terminaram e não vão voltar a iniciar sozinhos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Containers die zijn afgesloten en niet vanzelf terugkomen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Containrar som har avslutats och inte startar igen av sig själva."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Containere, der er afsluttet og ikke starter igen af sig selv."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Containere som er avsluttet og ikke starter igjen av seg selv."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontit, jotka ovat päättyneet eivätkä käynnisty itsestään uudelleen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontenery, które zakończyły działanie i nie uruchomią się ponownie same."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontejnery, které skončily a samy se znovu nespustí."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontajnery, ktoré skončili a samy sa znova nespustia."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilépett konténerek, amelyek maguktól nem indulnak újra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Containere care s-au oprit și nu vor reporni singure."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Контейнери, които са приключили и няма да се стартират отново сами."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κοντέινερ που έχουν τερματιστεί και δεν θα επανέλθουν μόνα τους."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontejneri koji su završili s radom i neće se sami ponovno pokrenuti."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsebniki, ki so se končali in se ne bodo sami znova zagnali."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Контејнери који су завршили рад и неће се сами поново покренути."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontejneri koji su završili rad i neće se sami ponovo pokrenuti."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Konteineriai, kurie baigė darbą ir patys nebus paleisti iš naujo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Konteineri, kas ir beiguši darbu un paši vairs netiks startēti."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Konteinerid, mis on väljunud ega käivitu ise uuesti."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Контейнери, що завершили роботу й не перезапустяться самі."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контейнеры, которые завершили работу и сами не перезапустятся."
          }
        }
      }
    },
