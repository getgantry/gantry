        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ob ustvarjanju vsebnika vanj vezno priklopi mapo iz sistema macOS."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Монтирајте macOS фасциклу у контејнер приликом креирања."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Montirajte macOS fasciklu u kontejner prilikom kreiranja."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuriant konteinerį prijungti macOS aplanką kaip susietąjį prijungimą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izveides brīdī piesaistīt konteinerā macOS mapi (bind mount)."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Haagi macOS-i kaust loomisel konteinerisse (bind mount)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змонтувати папку macOS у контейнер під час створення."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключить папку macOS в контейнер через bind-монтирование при создании."
          }
        }
      }
    },
