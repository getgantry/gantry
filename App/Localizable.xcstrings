    "Reach it directly at the IP above. Assign a DNS name below to also use %@.<domain> (name resolution needs a default DNS domain configured in apple/container).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reach it directly at the IP above. Assign a DNS name below to also use %@.<domain> (name resolution needs a default DNS domain configured in apple/container)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可直接通过上方 IP 访问。在下方分配 DNS 名称后也可使用 %@.<domain>（名称解析需要在 apple/container 中配置默认 DNS 域名）。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du erreichst ihn direkt über die IP-Adresse oben. Weise unten einen DNS-Namen zu, um auch %@.<domain> zu verwenden (die Namensauflösung erfordert eine in apple/container konfigurierte Standard-DNS-Domain)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accédez-y directement à l'adresse IP ci-dessus. Attribuez un nom DNS ci-dessous pour utiliser aussi %@.<domaine> (la résolution de noms nécessite un domaine DNS par défaut configuré dans apple/container)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Accede directamente a través de la IP de arriba. Asigna un nombre DNS abajo para usar también %@.<dominio> (la resolución de nombres necesita un dominio DNS predeterminado configurado en apple/container)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raggiungilo direttamente tramite l'IP qui sopra. Assegna un nome DNS qui sotto per usare anche %@.<dominio> (la risoluzione dei nomi richiede un dominio DNS predefinito configurato in apple/container)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceda diretamente através do IP acima. Atribua um nome DNS abaixo para utilizar também %@.<domínio> (a resolução de nomes precisa de um domínio DNS predefinido configurado no apple/container)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereik de container direct via het IP-adres hierboven. Wijs hieronder een DNS-naam toe om ook %@.<domein> te gebruiken (naamresolutie vereist een standaard-DNS-domein dat in apple/container is geconfigureerd)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nå den direkt via IP-adressen ovan. Tilldela ett DNS-namn nedan för att även kunna använda %@.<domän> (namnuppslagning kräver att en standard-DNS-domän är konfigurerad i apple/container)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nå den direkte på IP-adressen ovenfor. Tildel et DNS-navn nedenfor for også at bruge %@.<domæne> (navneopslag kræver, at der er konfigureret et standard-DNS-domæne i apple/container)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nå den direkte på IP-adressen ovenfor. Tildel et DNS-navn nedenfor for også å bruke %@.<domene> (navneoppslag krever at et standard DNS-domene er konfigurert i apple/container)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavoitat sen suoraan yllä olevasta IP-osoitteesta. Määritä alla DNS-nimi, niin voit käyttää myös osoitetta %@.<verkkotunnus> (nimenselvitys vaatii, että apple/containeriin on määritetty oletus-DNS-verkkotunnus)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz się bezpośrednio przez powyższy adres IP. Przypisz poniżej nazwę DNS, aby używać także %@.<domena> (rozwiązywanie nazw wymaga domyślnej domeny DNS skonfigurowanej w apple/container)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostupný přímo na IP adrese výše. Přiřaďte níže název DNS, abyste mohli použít i %@.<doména> (překlad názvů vyžaduje výchozí doménu DNS nastavenou v apple/container)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontajner je priamo dostupný na IP adrese vyššie. Ak priradíte názov DNS nižšie, môžete použiť aj %@.<doména> (preklad názvov vyžaduje predvolenú doménu DNS nastavenú v apple/container)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Közvetlenül a fenti IP-címen érhető el. Ha lent DNS-nevet rendel hozzá, a(z) %@.<domain> név is használható (a névfeloldáshoz alapértelmezett DNS-tartományt kell beállítani az apple/containerben)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesați-l direct la IP-ul de mai sus. Atribuiți un nume DNS mai jos pentru a folosi și %@.<domeniu> (rezolvarea numelor necesită un domeniu DNS implicit configurat în apple/container)."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Достъпвайте го директно на IP адреса по-горе. Задайте DNS име по-долу, за да използвате и %@.<домейн> (разрешаването на имена изисква конфигуриран DNS домейн по подразбиране в apple/container)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσπελάστε το απευθείας στην παραπάνω IP. Αναθέστε ένα όνομα DNS παρακάτω για να χρησιμοποιείτε επίσης το %@.<domain> (η ανάλυση ονομάτων χρειάζεται προεπιλεγμένο τομέα DNS ρυθμισμένο στο apple/container)."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pristupite mu izravno na gornjoj IP adresi. Dodijelite DNS naziv ispod kako biste koristili i %@.<domain> (razrješavanje naziva zahtijeva zadanu DNS domenu konfiguriranu u apple/container)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do njega dostopate neposredno na zgornjem naslovu IP. Spodaj dodelite ime DNS, da boste lahko uporabljali tudi %@.<domena> (razreševanje imen zahteva privzeto domeno DNS, nastavljeno v apple/container)."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Приступите му директно на IP адреси изнад. Доделите DNS име испод да бисте користили и %@.<домен> (за разрешавање имена потребан је подразумевани DNS домен подешен у apple/container)."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pristupite mu direktno na IP adresi iznad. Dodelite DNS ime ispod da biste koristili i %@.<domen> (za razrešavanje imena potreban je podrazumevani DNS domen podešen u apple/container)."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasiekite jį tiesiogiai aukščiau nurodytu IP adresu. Priskirkite DNS vardą žemiau, kad galėtumėte naudoti ir %@.<domain> (vardų nustatymui apple/container turi būti sukonfigūruotas numatytasis DNS domenas)."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Piekļūstiet tam tieši, izmantojot iepriekš norādīto IP adresi. Piešķiriet DNS nosaukumu tālāk, lai izmantotu arī %@.<domēns> (nosaukumu atrisināšanai apple/container jābūt konfigurētam noklusējuma DNS domēnam)."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pöörduge otse ülaltoodud IP-aadressile. Määrake allpool DNS-nimi, et kasutada ka nime %@.<domeen> (nimelahendus vajab apple/containeris seadistatud DNS-vaikedomeeni)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звертайтеся до нього безпосередньо за IP-адресою вище. Призначте DNS-ім’я нижче, щоб також використовувати %@.<домен> (для розпізнавання імен потрібен типовий DNS-домен, налаштований в apple/container)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обращайтесь к нему напрямую по IP-адресу выше. Назначьте DNS-имя ниже, чтобы также использовать %@.<домен> (для разрешения имён в apple/container должен быть настроен DNS-домен по умолчанию)."
          }
        }
      }
    },
