    "A digest is required for a remote archive. apple/container checks the download against it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A digest is required for a remote archive. apple/container checks the download against it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程归档必须提供摘要。apple/container 会用它校验下载内容。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für ein entferntes Archiv ist ein Digest erforderlich. apple/container prüft den Download damit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un condensat est requis pour une archive distante. apple/container vérifie le téléchargement à l'aide de celui-ci."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere un digest para un archivo comprimido remoto. apple/container comprueba la descarga con él."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per un archivio remoto è necessario un digest. apple/container verifica il download in base a esso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessário um digest para um arquivo remoto. O apple/container verifica a descarga com base nele."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor een extern archief is een digest vereist. apple/container controleert de download hiermee."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En kontrollsumma krävs för ett fjärrarkiv. apple/container kontrollerar hämtningen mot den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et digest er påkrævet for et fjernarkiv. apple/container kontrollerer det downloadede mod det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En digest er påkrevd for et eksternt arkiv. apple/container kontrollerer nedlastingen mot den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Etäarkistolle vaaditaan tiiviste. apple/container tarkistaa latauksen sitä vasten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdalne archiwum wymaga skrótu (digest). apple/container sprawdza z nim pobrany plik."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro vzdálený archiv je vyžadován digest. apple/container podle něj ověří stažený soubor."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre vzdialený archív je digest povinný. apple/container podľa neho overí stiahnutý súbor."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Távoli archívumhoz kivonat szükséges. Az apple/container ezzel ellenőrzi a letöltést."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru o arhivă la distanță este necesar un digest. apple/container verifică descărcarea pe baza acestuia."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За отдалечен архив е необходима контролна сума. apple/container проверява изтегления файл спрямо нея."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για απομακρυσμένο αρχείο συμπίεσης απαιτείται digest. Το apple/container ελέγχει τη λήψη με βάση αυτό."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za udaljenu arhivu potreban je sažetak (digest). apple/container prema njemu provjerava preuzimanje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za oddaljeni arhiv je potreben izvleček. apple/container z njim preveri prenos."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "За удаљену архиву потребан је хеш. apple/container њиме проверава преузимање."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Za udaljenu arhivu potreban je heš. apple/container njime proverava preuzimanje."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuotoliniam archyvui būtina santrauka. apple/container pagal ją patikrina atsisiųstą failą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Attālam arhīvam nepieciešama kontrolsumma. apple/container pārbauda lejupielādi pret to."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaugarhiivi jaoks on räsi kohustuslik. apple/container kontrollib allalaaditud faili selle järgi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для віддаленого архіву потрібен дайджест. apple/container перевіряє за ним завантажений файл."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для удалённого архива нужен дайджест. apple/container сверяет с ним скачанный файл."
          }
        }
      }
    },
    "This apple/container version cannot check an archive digest. Update to 1.2 or later to verify downloads.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This apple/container version cannot check an archive digest. Update to 1.2 or later to verify downloads."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 apple/container 版本无法校验归档摘要。请更新到 1.2 或更高版本以校验下载。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese apple/container-Version kann keinen Archiv-Digest prüfen. Aktualisiere auf 1.2 oder neuer, um Downloads zu verifizieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version d'apple/container ne peut pas vérifier le condensat d'une archive. Passez à la version 1.2 ou ultérieure pour vérifier les téléchargements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de apple/container no puede comprobar el digest de un archivo comprimido. Actualiza a la 1.2 o posterior para verificar las descargas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione di apple/container non può verificare il digest di un archivio. Aggiorna alla 1.2 o successiva per verificare i download."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão do apple/container não consegue verificar o digest de um arquivo. Atualize para a 1.2 ou posterior para verificar as descargas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze versie van apple/container kan de digest van een archief niet controleren. Werk bij naar 1.2 of nieuwer om downloads te verifiëren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här versionen av apple/container kan inte kontrollera ett arkivs kontrollsumma. Uppdatera till 1.2 eller senare för att verifiera hämtningar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne version af apple/container kan ikke kontrollere et arkivs digest. Opdater til 1.2 eller nyere for at bekræfte downloads."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne versjonen av apple/container kan ikke kontrollere en arkiv-digest. Oppdater til 1.2 eller nyere for å verifisere nedlastinger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä apple/container-versio ei voi tarkistaa arkiston tiivistettä. Päivitä versioon 1.2 tai uudempaan, jotta lataukset voidaan varmistaa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta wersja apple/container nie może sprawdzić skrótu archiwum. Aby weryfikować pobrane pliki, uaktualnij do wersji 1.2 lub nowszej."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato verze apple/container neumí ověřit digest archivu. Chcete-li ověřovat stažené soubory, aktualizujte na verzi 1.2 nebo novější."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto verzia apple/container nedokáže overiť digest archívu. Ak chcete overovať stiahnuté súbory, aktualizujte na verziu 1.2 alebo novšiu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az apple/container verzió nem tudja ellenőrizni az archívum kivonatát. A letöltések ellenőrzéséhez frissítsen 1.2-es vagy újabb verzióra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această versiune apple/container nu poate verifica digestul unei arhive. Actualizați la 1.2 sau o versiune ulterioară pentru a verifica descărcările."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази версия на apple/container не може да проверява контролна сума на архив. Актуализирайте до 1.2 или по-нова версия, за да проверявате изтеглянията."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η έκδοση του apple/container δεν μπορεί να ελέγξει το digest αρχείου συμπίεσης. Ενημερώστε σε 1.2 ή νεότερη για επαλήθευση των λήψεων."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova verzija apple/container ne može provjeriti sažetak arhive. Ažurirajte na 1.2 ili noviju za provjeru preuzimanja."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta različica apple/container ne more preveriti izvlečka arhiva. Za preverjanje prenosov posodobite na 1.2 ali novejšo."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ова верзија apple/container не може да провери хеш архиве. Ажурирајте на 1.2 или новију да бисте проверавали преузимања."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova verzija apple/container ne može da proveri heš arhive. Ažurirajte na 1.2 ili noviju da biste proveravali preuzimanja."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ši apple/container versija negali patikrinti archyvo santraukos. Atnaujinkite į 1.2 ar naujesnę versiją, kad atsisiuntimai būtų tikrinami."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šī apple/container versija nevar pārbaudīt arhīva kontrolsummu. Lai pārbaudītu lejupielādes, atjauniniet uz 1.2 vai jaunāku versiju."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See apple/containeri versioon ei saa arhiivi räsi kontrollida. Allalaadimiste kontrollimiseks uuendage versioonile 1.2 või uuemale."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця версія apple/container не може перевірити дайджест архіву. Оновіть її до 1.2 або новішої, щоб перевіряти завантаження."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта версия apple/container не может проверить дайджест архива. Чтобы проверять скачанные файлы, обновите apple/container до версии 1.2 или новее."
          }
        }
      }
    },
