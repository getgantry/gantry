    "Install [Homebrew](https://brew.sh) and run `brew install %@`, or follow Cloudflare's [download guide](%@).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install [Homebrew](https://brew.sh) and run `brew install %@`, or follow Cloudflare's [download guide](%@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装 [Homebrew](https://brew.sh) 并运行 `brew install %@`，或按照 Cloudflare 的[下载指南](%@)操作。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere [Homebrew](https://brew.sh) und führe `brew install %@` aus oder folge der [Download-Anleitung](%@) von Cloudflare."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez [Homebrew](https://brew.sh) et exécutez `brew install %@`, ou suivez le [guide de téléchargement](%@) de Cloudflare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala [Homebrew](https://brew.sh) y ejecuta `brew install %@`, o sigue la [guía de descarga](%@) de Cloudflare."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa [Homebrew](https://brew.sh) ed esegui `brew install %@`, oppure segui la [guida al download](%@) di Cloudflare."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale o [Homebrew](https://brew.sh) e execute `brew install %@`, ou siga o [guia de transferência](%@) do Cloudflare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeer [Homebrew](https://brew.sh) en voer `brew install %@` uit, of volg de [downloadhandleiding](%@) van Cloudflare."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Installera [Homebrew](https://brew.sh) och kör `brew install %@`, eller följ Cloudflares [hämtningsguide](%@)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer [Homebrew](https://brew.sh), og kør `brew install %@`, eller følg Cloudflares [installationsvejledning](%@)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer [Homebrew](https://brew.sh), og kjør `brew install %@`, eller følg [nedlastingsveiledningen](%@) fra Cloudflare."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asenna [Homebrew](https://brew.sh) ja suorita `brew install %@` tai noudata Cloudflaren [latausohjetta](%@)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainstaluj [Homebrew](https://brew.sh) i wykonaj `brew install %@` albo postępuj zgodnie z [instrukcją pobierania](%@) Cloudflare."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nainstalujte [Homebrew](https://brew.sh) a spusťte `brew install %@`, nebo postupujte podle [návodu ke stažení](%@) od Cloudflare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nainštalujte [Homebrew](https://brew.sh) a spustite `brew install %@` alebo postupujte podľa [návodu na stiahnutie](%@) od Cloudflare."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Telepítse a [Homebrew-t](https://brew.sh), és futtassa a `brew install %@` parancsot, vagy kövesse a Cloudflare [letöltési útmutatóját](%@)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalați [Homebrew](https://brew.sh) și rulați `brew install %@` sau urmați [ghidul de descărcare](%@) Cloudflare."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Инсталирайте [Homebrew](https://brew.sh) и изпълнете `brew install %@` или следвайте [ръководството за изтегляне](%@) на Cloudflare."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εγκαταστήστε το [Homebrew](https://brew.sh) και εκτελέστε `brew install %@` ή ακολουθήστε τον [οδηγό λήψης](%@) του Cloudflare."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalirajte [Homebrew](https://brew.sh) i pokrenite `brew install %@` ili slijedite Cloudflareov [vodič za preuzimanje](%@)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Namestite [Homebrew](https://brew.sh) in zaženite `brew install %@` ali sledite Cloudflarovemu [vodniku za prenos](%@)."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Инсталирајте [Homebrew](https://brew.sh) и покрените `brew install %@` или пратите Cloudflare [упутство за преузимање](%@)."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalirajte [Homebrew](https://brew.sh) i pokrenite `brew install %@` ili pratite Cloudflare [uputstvo za preuzimanje](%@)."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įdiekite [Homebrew](https://brew.sh) ir paleiskite `brew install %@` arba vadovaukitės Cloudflare [atsisiuntimo instrukcija](%@)."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalējiet [Homebrew](https://brew.sh) un palaidiet `brew install %@` vai izpildiet Cloudflare [lejupielādes norādījumus](%@)."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Installige [Homebrew](https://brew.sh) ja käivitage `brew install %@` või järgige Cloudflare'i [allalaadimisjuhendit](%@)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інсталюйте [Homebrew](https://brew.sh) і виконайте `brew install %@` або скористайтеся [інструкцією із завантаження](%@) від Cloudflare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите [Homebrew](https://brew.sh) и выполните `brew install %@` или следуйте [инструкции по установке](%@) от Cloudflare."
          }
        }
      }
    },
    "Install Apple's container CLI to manage its services and local DNS domains here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install Apple's container CLI to manage its services and local DNS domains here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装 Apple 的 container CLI，以便在此管理其服务与本地 DNS 域名。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere Apples container-CLI, um hier die Dienste und lokalen DNS-Domains zu verwalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez la CLI container d'Apple pour gérer ses services et ses domaines DNS locaux ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala la CLI container de Apple para gestionar aquí sus servicios y sus dominios DNS locales."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa la CLI container di Apple per gestire qui i suoi servizi e i domini DNS locali."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale a CLI container da Apple para gerir aqui os respetivos serviços e domínios DNS locais."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeer de container-CLI van Apple om de services en lokale DNS-domeinen hier te beheren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Installera Apples container-CLI för att hantera dess tjänster och lokala DNS-domäner här."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer Apples container-CLI for at administrere dens tjenester og lokale DNS-domæner her."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer Apples container-CLI for å administrere tjenestene og de lokale DNS-domenene her."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asenna Applen container-CLI, niin voit hallita sen palveluja ja paikallisia DNS-verkkotunnuksia täällä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainstaluj CLI container od Apple, aby zarządzać tutaj jego usługami i lokalnymi domenami DNS."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li zde spravovat služby a místní domény DNS, nainstalujte Apple container CLI."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nainštalujte CLI container od Apple, aby ste tu mohli spravovať jeho služby a lokálne domény DNS."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Telepítse az Apple container CLI-t, hogy itt kezelhesse a szolgáltatásait és a helyi DNS-tartományait."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalați CLI-ul container de la Apple pentru a-i gestiona aici serviciile și domeniile DNS locale."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Инсталирайте CLI на container от Apple, за да управлявате тук неговите услуги и локални DNS домейни."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εγκαταστήστε το CLI container της Apple για να διαχειρίζεστε εδώ τις υπηρεσίες του και τους τοπικούς τομείς DNS."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalirajte Appleov container CLI kako biste ovdje upravljali njegovim servisima i lokalnim DNS domenama."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Namestite Applov CLI container, da tukaj upravljate njegove storitve in lokalne domene DNS."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Инсталирајте Apple-ов container CLI да бисте овде управљали његовим сервисима и локалним DNS доменима."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalirajte Apple-ov container CLI da biste ovde upravljali njegovim servisima i lokalnim DNS domenima."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įdiekite Apple container CLI, kad čia galėtumėte valdyti jo paslaugas ir vietinius DNS domenus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalējiet Apple container CLI, lai šeit pārvaldītu tā pakalpojumus un lokālos DNS domēnus."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Installige Apple'i container CLI, et hallata siin selle teenuseid ja kohalikke DNS-domeene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інсталюйте Apple container CLI, щоб керувати тут його службами та локальними DNS-доменами."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите CLI container от Apple, чтобы управлять здесь его службами и локальными DNS-доменами."
          }
        }
      }
    },
