    "1 container uses this image. Use Force Remove to remove it anyway.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 container uses this image. Use Force Remove to remove it anyway."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 个容器使用此镜像。可使用强制移除仍将其移除。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Container verwendet dieses Image. Wähle „Entfernen erzwingen“, um es trotzdem zu entfernen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 conteneur utilise cette image. Utilisez Forcer la suppression pour la supprimer quand même."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 contenedor usa esta imagen. Usa Forzar eliminación para eliminarla de todos modos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1 container usa questa immagine. Usa Forza rimozione per rimuoverla comunque."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "1 contentor utiliza esta imagem. Utilize Forçar remoção para a remover mesmo assim."
