    "Unix socket mount — containers that run as a non-root user need apple/container %@ or newer to use it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unix socket mount — containers that run as a non-root user need apple/container %@ or newer to use it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Unix 套接字挂载 — 以非 root 用户运行的容器需要 apple/container %@ 或更高版本才能使用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unix-Socket-Mount – Container, die als Nicht-Root-Benutzer laufen, benötigen apple/container %@ oder neuer, um ihn zu verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montage de socket Unix — les conteneurs exécutés par un utilisateur non root nécessitent apple/container %@ ou une version ultérieure pour l'utiliser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Montaje de socket Unix: los contenedores que se ejecutan con un usuario no root necesitan apple/container %@ o posterior para usarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Montaggio di socket Unix: i container eseguiti come utente non root richiedono apple/container %@ o versione successiva per usarlo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Montagem de socket Unix — os contentores executados como utilizador não root precisam do apple/container %@ ou posterior para a utilizar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppeling van unix-socket — containers die als niet-rootgebruiker draaien, hebben apple/container %@ of nieuwer nodig om deze te gebruiken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Unix-socket-montering – containrar som körs som en användare utan root-behörighet kräver apple/container %@ eller senare för att använda den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Unix-socket-mount — containere, der kører som en bruger uden root-rettigheder, kræver apple/container %@ eller nyere for at bruge den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Unix-socket-montering — containere som kjører som en bruker uten root-rettigheter, krever apple/container %@ eller nyere for å bruke den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Unix-socket-liitos – konttien, jotka toimivat muuna kuin root-käyttäjänä, on käytettävä apple/containerin versiota %@ tai uudempaa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Montowanie gniazda unix — kontenery działające jako użytkownik inny niż root wymagają apple/container %@ lub nowszego."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojení unixového socketu – kontejnery, které běží pod jiným uživatelem než root, ho mohou používat až s apple/container %@ nebo novějším."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripojenie unixového soketu – kontajnery, ktoré bežia pod používateľom iným ako root, potrebujú na jeho použitie apple/container %@ alebo novší."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Unix socket csatolása – a nem root felhasználóként futó konténereknek ehhez apple/container %@ vagy újabb kell."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Montare socket Unix — containerele care rulează ca utilizator non-root necesită apple/container %@ sau o versiune ulterioară pentru a o folosi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Монтиране на unix сокет — контейнерите, които работят като потребител без root права, изискват apple/container %@ или по-нова версия, за да го използват."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσάρτηση unix socket — τα κοντέινερ που εκτελούνται ως χρήστης χωρίς δικαιώματα root χρειάζονται apple/container %@ ή νεότερο για να τη χρησιμοποιήσουν."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montiranje unix utičnice — kontejneri koji rade kao korisnik koji nije root zahtijevaju apple/container %@ ili noviji."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Priklop vtičnice unix – vsebniki, ki se izvajajo kot uporabnik brez pravic root, za uporabo potrebujejo apple/container %@ ali novejši."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Монтирање unix сокета — контејнерима који раде као корисник који није root потребан је apple/container %@ или новији да би га користили."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Montiranje unix soketa — kontejnerima koji rade kao korisnik koji nije root potreban je apple/container %@ ili noviji da bi ga koristili."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Unix lizdo prijungimas – konteineriams, veikiantiems ne root naudotojo teisėmis, reikia apple/container %@ arba naujesnės versijos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Unix ligzdas montējums — konteineriem, kas darbojas kā lietotājs, kurš nav root, tā izmantošanai nepieciešams apple/container %@ vai jaunāka versija."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Unix-sokli haakimine — mitte-root-kasutajana töötavad konteinerid vajavad selle kasutamiseks apple/containeri versiooni %@ või uuemat."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Монтування unix-сокета — контейнерам, що працюють від імені користувача без прав root, для цього потрібен apple/container версії %@ або новішої."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Монтирование unix-сокета — контейнерам, которые работают не от root, нужен apple/container %@ или новее."
          }
        }
      }
    },
    "Unix socket mount — permissions are propagated into the container, including when it runs as a non-root user.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unix socket mount — permissions are propagated into the container, including when it runs as a non-root user."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Unix 套接字挂载 — 权限会传入容器，包括以非 root 用户运行时。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unix-Socket-Mount – Berechtigungen werden in den Container übernommen, auch wenn er als Nicht-Root-Benutzer läuft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montage de socket Unix — les autorisations sont propagées dans le conteneur, y compris lorsqu'il s'exécute avec un utilisateur non root."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Montaje de socket Unix: los permisos se propagan al contenedor, también cuando se ejecuta con un usuario no root."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Montaggio di socket Unix: i permessi vengono propagati nel container, anche quando viene eseguito come utente non root."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Montagem de socket Unix — as permissões são propagadas para o contentor, incluindo quando é executado como utilizador não root."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppeling van unix-socket — rechten worden doorgegeven aan de container, ook als deze als niet-rootgebruiker draait."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Unix-socket-montering – behörigheter förs vidare in i containern, även när den körs som en användare utan root-behörighet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Unix-socket-mount — tilladelser overføres til containeren, også når den kører som en bruger uden root-rettigheder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Unix-socket-montering — tillatelser videreføres til containeren, også når den kjører som en bruker uten root-rettigheter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Unix-socket-liitos – oikeudet välitetään konttiin myös silloin, kun se toimii muuna kuin root-käyttäjänä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Montowanie gniazda unix — uprawnienia są przenoszone do kontenera, także gdy działa jako użytkownik inny niż root."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojení unixového socketu – oprávnění se přenášejí do kontejneru, i když běží pod jiným uživatelem než root."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripojenie unixového soketu – oprávnenia sa prenášajú do kontajnera, aj keď beží pod používateľom iným ako root."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Unix socket csatolása – a jogosultságok átkerülnek a konténerbe, akkor is, ha nem root felhasználóként fut."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Montare socket Unix — permisiunile sunt propagate în container, inclusiv când rulează ca utilizator non-root."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Монтиране на unix сокет — правата се пренасят в контейнера, включително когато той работи като потребител без root права."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσάρτηση unix socket — τα δικαιώματα μεταφέρονται στο κοντέινερ, ακόμη και όταν εκτελείται ως χρήστης χωρίς δικαιώματα root."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montiranje unix utičnice — dozvole se prenose u kontejner, uključujući kad radi kao korisnik koji nije root."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Priklop vtičnice unix – dovoljenja se prenesejo v vsebnik, tudi ko se izvaja kot uporabnik brez pravic root."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Монтирање unix сокета — дозволе се преносе у контејнер, укључујући и када ради као корисник који није root."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Montiranje unix soketa — dozvole se prenose u kontejner, uključujući i kada radi kao korisnik koji nije root."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Unix lizdo prijungimas – teisės perduodamos į konteinerį, net jei jis veikia ne root naudotojo teisėmis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Unix ligzdas montējums — atļaujas tiek nodotas konteinerā, arī tad, ja tas darbojas kā lietotājs, kurš nav root."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Unix-sokli haakimine — õigused antakse konteinerisse edasi, ka siis, kui see töötab mitte-root-kasutajana."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Монтування unix-сокета — дозволи передаються в контейнер, зокрема коли він працює від імені користувача без прав root."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Монтирование unix-сокета — права доступа передаются в контейнер, в том числе когда он работает не от root."
          }
        }
      }
    },
