    "Only trust this key if it matches the fingerprint you expect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only trust this key if it matches the fingerprint you expect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当你确认指纹符合预期时才信任此密钥。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertraue diesem Schlüssel nur, wenn er dem erwarteten Fingerabdruck entspricht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne faites confiance à cette clé que si elle correspond à l'empreinte attendue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confía en esta clave solo si coincide con la huella que esperas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Considera attendibile questa chiave solo se corrisponde all'impronta prevista."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Confie nesta chave apenas se corresponder à impressão digital que espera."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertrouw deze sleutel alleen als deze overeenkomt met de vingerafdruk die je verwacht."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lita bara på den här nyckeln om den matchar fingeravtrycket du förväntar dig."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hav kun tillid til denne nøgle, hvis den svarer til det fingeraftryk, du forventer."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Godkjenn denne nøkkelen bare hvis den samsvarer med fingeravtrykket du forventer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luota tähän avaimeen vain, jos se vastaa odottamaasi sormenjälkeä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ufaj temu kluczowi tylko wtedy, gdy jego odcisk zgadza się z oczekiwanym."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomuto klíči důvěřujte, jen pokud odpovídá očekávanému otisku."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomuto kľúču dôverujte, iba ak sa zhoduje s odtlačkom, ktorý očakávate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak akkor bízzon meg ebben a kulcsban, ha egyezik a várt ujjlenyomattal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aveți încredere în această cheie doar dacă se potrivește cu amprenta așteptată."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Доверете се на този ключ само ако отговаря на очаквания пръстов отпечатък."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμπιστευτείτε αυτό το κλειδί μόνο αν ταιριάζει με το αποτύπωμα που περιμένετε."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vjerujte ovom ključu samo ako odgovara otisku koji očekujete."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Temu ključu zaupajte samo, če se ujema s pričakovanim prstnim odtisom."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Верујте овом кључу само ако се подудара са отиском који очекујете."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Verujte ovom ključu samo ako se podudara sa otiskom koji očekujete."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasitikėkite šiuo raktu tik tada, jei jis atitinka laukiamą kontrolinį kodą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzticieties šai atslēgai tikai tad, ja tā atbilst gaidītajam pirkstu nospiedumam."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Usaldage seda võtit ainult siis, kui see vastab oodatud sõrmejäljele."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Довіряйте цьому ключу, лише якщо він збігається з очікуваним відбитком."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доверяйте этому ключу, только если его отпечаток совпадает с ожидаемым."
          }
        }
      }
    },
