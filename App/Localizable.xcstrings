    "Connect to the host to see its overview.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to the host to see its overview."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接主机以查看概览。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde dich mit dem Host, um seine Übersicht zu sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à l'hôte pour voir son aperçu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate al host para ver su resumen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connettiti all'host per vederne la panoramica."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue-se ao host para ver a respetiva vista geral."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak verbinding met de host om het overzicht te zien."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut till värden för att se dess översikt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbind til værten for at se dens oversigt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til verten for å se oversikten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä isäntään nähdäksesi sen yleiskatsauksen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz się z hostem, aby zobaczyć jego przegląd."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li zobrazit přehled, připojte se k hostiteli."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete zobraziť prehľad hostiteľa, pripojte sa k nemu."
          }
        },
        "hu": {
