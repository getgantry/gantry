    "Downloading and installing. This can take a few minutes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading and installing. This can take a few minutes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在下载并安装，可能需要几分钟。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird heruntergeladen und installiert. Das kann einige Minuten dauern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargement et installation en cours. Cela peut prendre quelques minutes."
          }
        },
