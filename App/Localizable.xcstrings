    "Values in bold are set in your config.toml. The others are package defaults. Clear a value to go back to the default.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Values in bold are set in your config.toml. The others are package defaults. Clear a value to go back to the default."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粗体值来自你的 config.toml，其他为安装包默认值。清除某个值即可恢复默认。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fett gedruckte Werte sind in deiner config.toml festgelegt. Die anderen sind Standardwerte des Pakets. Leere einen Wert, um zum Standard zurückzukehren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs en gras sont définies dans votre config.toml. Les autres sont les valeurs par défaut du paquet. Effacez une valeur pour revenir à la valeur par défaut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores en negrita están definidos en tu config.toml. Los demás son los valores predeterminados del paquete. Borra un valor para volver al predeterminado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I valori in grassetto sono impostati nel tuo config.toml. Gli altri sono i valori predefiniti del pacchetto. Cancella un valore per tornare a quello predefinito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os valores a negrito estão definidos no seu config.toml. Os outros são predefinições do pacote. Limpe um valor para voltar à predefinição."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetgedrukte waarden zijn ingesteld in je config.toml. De andere zijn standaardwaarden van het pakket. Wis een waarde om terug te gaan naar de standaard."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Värden i fetstil är angivna i din config.toml. De andra är paketets standardvärden. Rensa ett värde för att återgå till standard."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Værdier med fed skrift er angivet i din config.toml. De andre er pakkens standardværdier. Ryd en værdi for at gå tilbage til standarden."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdier i fet skrift er angitt i config.toml. De andre er standardverdier fra pakken. Tøm en verdi for å gå tilbake til standarden."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihavoidut arvot on asetettu config.toml-tiedostossasi. Muut ovat paketin oletuksia. Palaa oletukseen tyhjentämällä arvo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartości pogrubione są ustawione w pliku config.toml. Pozostałe to wartości domyślne pakietu. Wyczyść wartość, aby przywrócić domyślną."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodnoty tučně jsou nastaveny ve vašem config.toml. Ostatní jsou výchozí hodnoty balíčku. Vymazáním hodnoty se vrátíte k výchozí."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodnoty tučným písmom sú nastavené vo vašom config.toml. Ostatné sú predvolené hodnoty balíka. Ak chcete obnoviť predvolenú hodnotu, vymažte ju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A félkövér értékek a config.toml fájlban vannak beállítva. A többi a csomag alapértéke. Az alapértékhez való visszatéréshez törölje az értéket."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Valorile îngroșate sunt setate în config.toml. Celelalte sunt valorile implicite ale pachetului. Ștergeți o valoare pentru a reveni la valoarea implicită."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Стойностите в удебелен шрифт са зададени във вашия config.toml. Останалите са стойности по подразбиране на пакета. Изчистете стойност, за да се върнете към стойността по подразбиране."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι τιμές με έντονη γραφή έχουν οριστεί στο config.toml σας. Οι υπόλοιπες είναι προεπιλογές του πακέτου. Απαλείψτε μια τιμή για να επιστρέψετε στην προεπιλογή."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podebljane vrijednosti postavljene su u vašoj datoteci config.toml. Ostale su zadane vrijednosti paketa. Obrišite vrijednost za povratak na zadanu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krepko izpisane vrednosti so nastavljene v vaši datoteki config.toml. Druge so privzete vrednosti paketa. Če vrednost počistite, se vrne na privzeto."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Подебљане вредности су подешене у вашем config.toml. Остале су подразумеване вредности пакета. Избришите вредност да бисте се вратили на подразумевану."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Podebljane vrednosti su podešene u vašem config.toml. Ostale su podrazumevane vrednosti paketa. Izbrišite vrednost da biste se vratili na podrazumevanu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Paryškintos reikšmės nustatytos jūsų config.toml. Kitos – paketo numatytosios. Išvalykite reikšmę, kad grįžtumėte prie numatytosios."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Treknrakstā norādītās vērtības ir iestatītas jūsu config.toml. Pārējās ir pakotnes noklusējumi. Notīriet vērtību, lai atgrieztos pie noklusējuma."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paksus kirjas väärtused on määratud teie failis config.toml. Ülejäänud on paketi vaikeväärtused. Vaikeväärtuse taastamiseks tühjendage väärtus."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Значення, виділені жирним, задано у вашому config.toml. Інші — типові значення пакета. Очистьте значення, щоб повернути типове."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значения, выделенные жирным, заданы в вашем config.toml. Остальные — значения пакета по умолчанию. Очистите значение, чтобы вернуться к значению по умолчанию."
          }
        }
      }
    },
    "Running containers stop while the services restart.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running containers stop while the services restart."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务重启期间，正在运行的容器将停止。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laufende Container werden gestoppt, während die Dienste neu starten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les conteneurs en cours d'exécution s'arrêtent pendant le redémarrage des services."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los contenedores en ejecución se detienen mientras se reinician los servicios."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I container in esecuzione si arrestano durante il riavvio dei servizi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os contentores em execução param enquanto os serviços reiniciam."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Actieve containers worden gestopt terwijl de services herstarten."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Containrar som körs stoppas medan tjänsterna startar om."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kørende containere stopper, mens tjenesterne genstarter."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjørende containere stoppes mens tjenestene starter på nytt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käynnissä olevat kontit pysähtyvät, kun palvelut käynnistyvät uudelleen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas ponownego uruchamiania usług uruchomione kontenery zostaną zatrzymane."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Během restartu služeb se spuštěné kontejnery zastaví."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počas reštartu služieb sa spustené kontajnery zastavia."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A futó konténerek leállnak, amíg a szolgáltatások újraindulnak."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Containerele în execuție se opresc cât timp serviciile repornesc."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Работещите контейнери ще бъдат спрени, докато услугите се рестартират."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα κοντέινερ σε εκτέλεση διακόπτονται όσο επανεκκινούνται οι υπηρεσίες."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokrenuti kontejneri zaustavljaju se dok se servisi ponovno pokreću."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsebniki, ki se izvajajo, se med ponovnim zagonom storitev ustavijo."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Покренути контејнери се заустављају док се сервиси поново покрећу."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokrenuti kontejneri se zaustavljaju dok se servisi ponovo pokreću."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kol paslaugos paleidžiamos iš naujo, veikiantys konteineriai sustabdomi."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamēr pakalpojumi restartējas, darbojošies konteineri tiek apturēti."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teenuste taaskäivitamise ajal töötavad konteinerid peatuvad."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запущені контейнери зупиняться на час перезапуску служб."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока службы перезапускаются, работающие контейнеры остановятся."
          }
        }
      }
    },
