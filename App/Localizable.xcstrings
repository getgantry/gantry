    "Changes take effect the next time the machine starts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes take effect the next time the machine starts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改将在下次启动机器时生效。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen werden beim nächsten Start der Maschine wirksam."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications prennent effet au prochain démarrage de la machine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios se aplican la próxima vez que se inicie la máquina."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche avranno effetto al prossimo avvio della macchina."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações têm efeito no próximo arranque da máquina."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigingen worden van kracht wanneer de machine de volgende keer start."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändringarna börjar gälla nästa gång maskinen startar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændringerne træder i kraft, næste gang maskinen starter."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endringene trer i kraft neste gang maskinen starter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutokset tulevat voimaan, kun kone käynnistetään seuraavan kerran."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany zaczną obowiązywać przy następnym uruchomieniu maszyny."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změny se projeví při příštím spuštění stroje."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmeny sa prejavia pri ďalšom spustení stroja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A módosítások a gép következő indításakor lépnek érvénybe."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificările intră în vigoare la următoarea pornire a mașinii."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Промените влизат в сила при следващото стартиране на машината."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αλλαγές ισχύουν στην επόμενη εκκίνηση του μηχανήματος."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promjene stupaju na snagu pri sljedećem pokretanju stroja."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremembe začnejo veljati ob naslednjem zagonu stroja."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Измене ступају на снагу при следећем покретању машине."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Izmene stupaju na snagu pri sledećem pokretanju mašine."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakeitimai įsigalios kitą kartą paleidus mašiną."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izmaiņas stāsies spēkā nākamajā mašīnas startēšanas reizē."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Muudatused jõustuvad masina järgmisel käivitamisel."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни наберуть чинності під час наступного запуску машини."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения вступят в силу при следующем запуске машины."
          }
        }
      }
    },
