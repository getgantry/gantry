    "Boot arguments are appended to the kernel command line. The CLI's own defaults still apply unless an argument overrides the same key.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boot arguments are appended to the kernel command line. The CLI's own defaults still apply unless an argument overrides the same key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动参数会追加到内核命令行。除非参数覆盖同一键，否则 CLI 的默认值仍然生效。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Boot-Argumente werden an die Kernel-Befehlszeile angehängt. Die Standardwerte der CLI gelten weiterhin, sofern kein Argument denselben Schlüssel überschreibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les arguments de démarrage sont ajoutés à la ligne de commande du noyau. Les valeurs par défaut de la CLI s'appliquent toujours, sauf si un argument remplace la même clé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los argumentos de arranque se añaden a la línea de comandos del kernel. Los valores predeterminados de la CLI se siguen aplicando, salvo que un argumento sustituya la misma clave."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli argomenti di avvio vengono aggiunti alla riga di comando del kernel. I valori predefiniti della CLI restano validi, a meno che un argomento non sovrascriva la stessa chiave."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os argumentos de arranque são acrescentados à linha de comandos do kernel. As predefinições da CLI continuam a aplicar-se, salvo se um argumento substituir a mesma chave."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opstartargumenten worden aan de kernelopdrachtregel toegevoegd. De eigen standaardwaarden van de CLI blijven gelden, tenzij een argument dezelfde sleutel overschrijft."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Startargument läggs till i kärnans kommandorad. CLI:ets egna standardvärden gäller fortfarande om inte ett argument åsidosätter samma nyckel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Startargumenter føjes til kernens kommandolinje. CLI'ens egne standardværdier gælder stadig, medmindre et argument tilsidesætter den samme nøgle."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppstartsargumenter legges til i kommandolinjen til kjernen. Standardverdiene til CLI-en gjelder fortsatt, med mindre et argument overstyrer den samme nøkkelen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käynnistysargumentit lisätään ytimen komentoriville. CLI:n omat oletukset ovat yhä voimassa, ellei argumentti ohita samaa avainta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Argumenty rozruchu są dopisywane do wiersza poleceń jądra. Domyślne ustawienia CLI nadal obowiązują, chyba że argument nadpisuje ten sam klucz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spouštěcí argumenty se připojí k příkazovému řádku jádra. Výchozí hodnoty CLI platí dál, pokud argument nepřepíše stejný klíč."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spúšťacie argumenty sa pridajú do príkazového riadka jadra. Predvolené hodnoty CLI ostávajú v platnosti, ak argument neprepíše ten istý kľúč."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rendszerindítási argumentumok a kernel parancssorához fűződnek. A CLI saját alapértelmezései továbbra is érvényesek, hacsak egy argumentum felül nem írja ugyanazt a kulcsot."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Argumentele de pornire sunt adăugate la linia de comandă a kernelului. Valorile implicite ale CLI se aplică în continuare, cu excepția cazului în care un argument suprascrie aceeași cheie."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аргументите за зареждане се добавят към командния ред на ядрото. Стойностите по подразбиране на CLI остават в сила, освен ако някой аргумент не замени същия ключ."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα ορίσματα εκκίνησης προστίθενται στη γραμμή εντολών του πυρήνα. Οι προεπιλογές του CLI εξακολουθούν να ισχύουν, εκτός αν ένα όρισμα παρακάμπτει το ίδιο κλειδί."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Argumenti pokretanja dodaju se u naredbeni redak jezgre. Zadane vrijednosti CLI-ja i dalje vrijede osim ako argument ne nadjača isti ključ."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zagonski argumenti se dodajo v ukazno vrstico jedra. Privzete nastavitve vmesnika CLI še vedno veljajo, razen če argument preglasi isti ključ."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Аргументи покретања се додају на командну линију језгра. Подразумеване вредности CLI-ја и даље важе, осим ако аргумент не замени исти кључ."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Argumenti pokretanja se dodaju na komandnu liniju jezgra. Podrazumevane vrednosti CLI-ja i dalje važe, osim ako argument ne zameni isti ključ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Paleidimo argumentai pridedami prie branduolio komandinės eilutės. Numatytieji CLI argumentai vis tiek taikomi, nebent argumentas perrašo tą patį raktą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sāknēšanas argumenti tiek pievienoti kodola komandrindai. CLI noklusējumi joprojām ir spēkā, ja vien kāds arguments neaizstāj to pašu atslēgu."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Buutimisargumendid lisatakse tuuma käsureale. CLI enda vaikeväärtused kehtivad, kui argument sama võtit üle ei kirjuta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметри завантаження додаються до командного рядка ядра. Типові значення CLI діють і далі, якщо параметр не перевизначає той самий ключ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аргументы загрузки добавляются в командную строку ядра. Значения CLI по умолчанию по-прежнему действуют, если аргумент не переопределяет тот же ключ."
          }
        }
      }
    },
    "Brings a docker-compose file up on an Apple Container host — building images, creating networks and volumes, and starting every service.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brings a docker-compose file up on an Apple Container host — building images, creating networks and volumes, and starting every service."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Apple Container 主机上启动 docker-compose 文件 — 构建镜像、创建网络与卷，并启动所有服务。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet eine docker-compose-Datei auf einem Apple-Container-Host – erstellt Images, Netzwerke und Volumes und startet alle Dienste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance un fichier docker-compose sur un hôte Apple Container : construit les images, crée les réseaux et les volumes, puis démarre chaque service."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta un archivo docker-compose en un host de Apple Container: crea las imágenes, las redes y los volúmenes, e inicia todos los servicios."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia un file docker-compose su un host Apple Container: crea le immagini, le reti e i volumi e avvia tutti i servizi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Executa um ficheiro docker-compose num host Apple Container — compila imagens, cria redes e volumes e inicia todos os serviços."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start een docker-compose-bestand op een Apple Container-host — bouwt images, maakt netwerken en volumes aan en start elke service."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kör en docker-compose-fil på en Apple Container-värd – bygger images, skapar nätverk och volymer och startar alla tjänster."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Starter en docker-compose-fil på en Apple Container-vært — bygger images, opretter netværk og volumes og starter alle tjenester."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Starter en docker-compose-fil på en Apple Container-vert — bygger images, oppretter nettverk og volumer og starter alle tjenestene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käynnistää docker-compose-tiedoston Apple Container -isännällä: koostaa levykuvat, luo verkot ja taltiot ja käynnistää kaikki palvelut."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchamia plik docker-compose na hoście Apple Container — buduje obrazy, tworzy sieci i woluminy oraz uruchamia wszystkie usługi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spustí soubor docker-compose na hostiteli Apple Container – sestaví image, vytvoří sítě a svazky a spustí všechny služby."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spustí súbor docker-compose na hostiteľovi Apple Container – zostaví obrazy, vytvorí siete a zväzky a spustí všetky služby."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elindít egy docker-compose fájlt egy Apple Container-gazdagépen: buildeli az image-eket, létrehozza a hálózatokat és a köteteket, és elindítja az összes szolgáltatást."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rulează un fișier docker-compose pe o gazdă Apple Container — construiește imaginile, creează rețelele și volumele și pornește fiecare serviciu."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Стартира файл docker-compose на хост на Apple Container — изгражда образите, създава мрежите и томовете и стартира всяка услуга."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκκινεί ένα αρχείο docker-compose σε host Apple Container — δομεί εικόνες, δημιουργεί δίκτυα και τόμους και ξεκινά όλες τις υπηρεσίες."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokreće docker-compose datoteku na Apple Container hostu — gradi slike, stvara mreže i volumene te pokreće sve servise."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zažene datoteko docker-compose na gostitelju Apple Container – zgradi slike, ustvari omrežja in nosilce ter zažene vse storitve."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Покреће docker-compose датотеку на Apple Container хосту — гради слике, креира мреже и волумене и покреће сваки сервис."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokreće docker-compose datoteku na Apple Container hostu — gradi slike, kreira mreže i volumene i pokreće svaki servis."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Paleidžia docker-compose failą Apple Container serveryje: sukuria atvaizdus, tinklus ir tomus ir paleidžia visas paslaugas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Palaiž docker-compose failu Apple Container resursdatorā — būvē attēlus, izveido tīklus un sējumus un startē visus pakalpojumus."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Käivitab docker-compose faili Apple Containeri hostis: koostab tõmmised, loob võrgud ja köited ning käivitab kõik teenused."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускає файл docker-compose на хості Apple Container: збирає образи, створює мережі й томи та запускає кожну службу."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускает файл docker-compose на хосте Apple Container: собирает образы, создаёт сети и тома и запускает все сервисы."
          }
        }
      }
    },
