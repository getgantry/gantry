    "This permanently removes every stopped container. Running containers are not affected.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes every stopped container. Running containers are not affected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久移除所有已停止的容器。正在运行的容器不受影响。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle gestoppten Container dauerhaft entfernt. Laufende Container sind nicht betroffen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprime définitivement tous les conteneurs arrêtés. Les conteneurs en cours d'exécution ne sont pas concernés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción elimina de forma permanente todos los contenedores detenidos. Los contenedores en ejecución no se ven afectados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione rimuove definitivamente tutti i container arrestati. I container in esecuzione non vengono toccati."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação remove permanentemente todos os contentores parados. Os contentores em execução não são afetados."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden alle gestopte containers permanent verwijderd. Actieve containers worden niet beïnvloed."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla stoppade containrar tas bort permanent. Containrar som körs påverkas inte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner permanent alle stoppede containere. Kørende containere påvirkes ikke."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner alle stoppede containere for godt. Kjørende containere påvirkes ikke."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa pysyvästi kaikki pysäytetyt kontit. Käynnissä oleviin kontteihin tämä ei vaikuta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie zatrzymane kontenery zostaną trwale usunięte. Nie dotyczy to uruchomionych kontenerów."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trvale odstraní všechny zastavené kontejnery. Spuštěné kontejnery nejsou ovlivněny."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Natrvalo sa odstránia všetky zastavené kontajnery. Spustených kontajnerov sa to netýka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez véglegesen eltávolítja az összes leállított konténert. A futó konténereket nem érinti."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această acțiune elimină definitiv toate containerele oprite. Containerele în execuție nu sunt afectate."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това премахва завинаги всеки спрян контейнер. Работещите контейнери не се засягат."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαιρεί οριστικά κάθε σταματημένο κοντέινερ. Τα κοντέινερ σε εκτέλεση δεν επηρεάζονται."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo trajno uklanja sve zaustavljene kontejnere. Pokrenuti kontejneri nisu zahvaćeni."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S tem bodo trajno odstranjeni vsi ustavljeni vsebniki. Na vsebnike, ki se izvajajo, to ne vpliva."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ово трајно уклања сваки заустављени контејнер. Покренути контејнери нису погођени."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo trajno uklanja svaki zaustavljeni kontejner. Pokrenuti kontejneri nisu pogođeni."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Visam laikui pašalinami visi sustabdyti konteineriai. Veikiantiems konteineriams tai neturi įtakos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šī darbība neatgriezeniski noņem visus apturētos konteinerus. Darbojošos konteinerus tas neietekmē."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See eemaldab jäädavalt kõik peatatud konteinerid. Töötavaid konteinereid see ei mõjuta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі зупинені контейнери буде вилучено назавжди. Запущених контейнерів це не стосується."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все остановленные контейнеры будут удалены безвозвратно. Работающие контейнеры не затрагиваются."
          }
        }
      }
    },
