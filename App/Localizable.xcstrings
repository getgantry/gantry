          "stringUnit": {
            "state": "translated",
            "value": "Maszyna jest uruchomiona i zostanie zatrzymana."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stroj běží a bude zastaven."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stroj je spustený a zastaví sa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gép fut, és leáll."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mașina rulează și se va opri."
          }
        },
        "bg": {
