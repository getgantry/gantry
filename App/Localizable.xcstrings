    "The Homebrew build of apple/container has no machine API server. Install the signed package from Apple to use machines.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Homebrew build of apple/container has no machine API server. Install the signed package from Apple to use machines."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 版本的 apple/container 不包含虚拟机 API 服务器。要使用虚拟机，请安装 Apple 签名的安装包。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Homebrew-Build von apple/container hat keinen Machine-API-Server. Installiere das signierte Paket von Apple, um Maschinen zu verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version Homebrew d'apple/container n'a pas de serveur API pour les machines. Installez le paquet signé d'Apple pour utiliser les machines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión de Homebrew de apple/container no tiene servidor API de máquinas. Instala el paquete firmado de Apple para usar máquinas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione Homebrew di apple/container non include il server API delle macchine. Installa il pacchetto firmato di Apple per usare le macchine."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão Homebrew do apple/container não tem o servidor API de máquinas. Instale o pacote assinado da Apple para utilizar máquinas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Homebrew-build van apple/container heeft geen API-server voor machines. Installeer het ondertekende pakket van Apple om machines te gebruiken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew-versionen av apple/container har ingen API-server för maskiner. Installera det signerade paketet från Apple för att använda maskiner."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew-buildet af apple/container har ingen API-server til maskiner. Installer den signerede pakke fra Apple for at bruge maskiner."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew-versjonen av apple/container har ingen API-server for maskiner. Installer den signerte pakken fra Apple for å bruke maskiner."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/containerin Homebrew-versiossa ei ole koneiden API-palvelinta. Asenna Applen allekirjoitettu paketti, jotta voit käyttää koneita."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersja apple/container z Homebrew nie ma serwera API maszyn. Aby używać maszyn, zainstaluj podpisany pakiet od Apple."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Verze apple/container z Homebrew nemá server API pro stroje. Chcete-li používat stroje, nainstalujte podepsaný balíček od Applu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostavenie apple/container z Homebrew nemá API server pre stroje. Ak chcete používať stroje, nainštalujte podpísaný balík od Apple."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az apple/container Homebrew-buildjében nincs gép-API-szerver. A gépek használatához telepítse az Apple aláírt csomagját."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiunea Homebrew a apple/container nu are server API pentru mașini. Instalați pachetul semnat de la Apple pentru a folosi mașinile."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Версията на apple/container от Homebrew няма API сървър за машини. Инсталирайте подписания пакет от Apple, за да използвате машини."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η έκδοση Homebrew του apple/container δεν έχει διακομιστή API μηχανημάτων. Εγκαταστήστε το υπογεγραμμένο πακέτο της Apple για να χρησιμοποιήσετε μηχανήματα."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew verzija apple/container nema API poslužitelj za strojeve. Za upotrebu strojeva instalirajte Appleov potpisani paket."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Različica apple/container iz Homebrew nima strežnika API za stroje. Za uporabo strojev namestite podpisani paket podjetja Apple."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew верзија apple/container нема API сервер за машине. Инсталирајте потписани пакет компаније Apple да бисте користили машине."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew verzija apple/container nema API server za mašine. Instalirajte potpisani paket kompanije Apple da biste koristili mašine."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Per Homebrew įdiegtame apple/container nėra mašinų API serverio. Norėdami naudoti mašinas, įdiekite pasirašytą Apple paketą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container Homebrew būvējumā nav mašīnu API servera. Lai izmantotu mašīnas, instalējiet Apple parakstīto pakotni."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/containeri Homebrew-järgul pole masinate API-serverit. Masinate kasutamiseks installige Apple'i allkirjastatud pakett."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У збірці apple/container з Homebrew немає API-сервера машин. Щоб користуватися машинами, інсталюйте підписаний пакет від Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В сборке apple/container из Homebrew нет API-сервера машин. Чтобы использовать машины, установите подписанный пакет от Apple."
          }
        }
      }
    },
