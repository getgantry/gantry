    "Require Touch ID (or your login password) before removing a container or deleting a host.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Require Touch ID (or your login password) before removing a container or deleting a host."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在移除容器或删除主机前要求 Touch ID（或登录密码）。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID (oder dein Anmeldepasswort) anfordern, bevor ein Container entfernt oder ein Host gelöscht wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exiger Touch ID (ou votre mot de passe de session) avant de supprimer un conteneur ou un hôte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitar Touch ID (o tu contraseña de inicio de sesión) antes de eliminar un contenedor o un host."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiedi Touch ID (o la password di login) prima di rimuovere un container o eliminare un host."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Exigir o Touch ID (ou a palavra-passe de início de sessão) antes de remover um contentor ou eliminar um host."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vereis Touch ID (of je inlogwachtwoord) voordat een container wordt verwijderd of een host wordt gewist."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kräv Touch ID (eller ditt inloggningslösenord) innan en container tas bort eller en värd raderas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kræv Touch ID (eller din login-adgangskode), før en container fjernes, eller en vært slettes."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Krev Touch ID (eller påloggingspassordet ditt) før en container fjernes eller en vert slettes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaadi Touch ID (tai kirjautumissalasana) ennen kontin tai isännän poistamista."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymagaj Touch ID (lub hasła logowania) przed usunięciem kontenera lub hosta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před odstraněním kontejneru nebo smazáním hostitele vyžadovat Touch ID (nebo přihlašovací heslo)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred odstránením kontajnera alebo vymazaním hostiteľa vyžadovať Touch ID (alebo prihlasovacie heslo)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID (vagy a bejelentkezési jelszó) megkövetelése konténer eltávolítása vagy gazdagép törlése előtt."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicită Touch ID (sau parola de autentificare) înainte de eliminarea unui container sau ștergerea unei gazde."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изисквай Touch ID (или паролата за вход) преди премахване на контейнер или изтриване на хост."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απαίτηση Touch ID (ή του συνθηματικού σύνδεσής σας) πριν από την αφαίρεση κοντέινερ ή τη διαγραφή host."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahtijevaj Touch ID (ili lozinku za prijavu) prije uklanjanja kontejnera ili brisanja hosta."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred odstranitvijo vsebnika ali brisanjem gostitelja zahtevaj Touch ID (ali geslo za prijavo)."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Захтевај Touch ID (или лозинку за пријаву) пре уклањања контејнера или брисања хоста."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahtevaj Touch ID (ili lozinku za prijavu) pre uklanjanja kontejnera ili brisanja hosta."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prieš šalinant konteinerį ar trinant serverį reikalauti Touch ID (arba prisijungimo slaptažodžio)."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieprasīt Touch ID (vai jūsu pieteikšanās paroli) pirms konteinera noņemšanas vai resursdatora dzēšanas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Nõua Touch ID-d (või sisselogimisparooli) enne konteineri eemaldamist või hosti kustutamist."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимагати Touch ID (або пароль входу) перед вилученням контейнера чи видаленням хоста."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрашивать Touch ID (или пароль для входа) перед удалением контейнера или хоста."
          }
        }
      }
    },
