    "The builder container and its build cache are removed. The next build creates a new builder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The builder container and its build cache are removed. The next build creates a new builder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "构建器容器及其构建缓存将被移除。下次构建时会创建新的构建器。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Builder-Container und sein Build-Cache werden entfernt. Der nächste Build erstellt einen neuen Builder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le conteneur du builder et son cache de build sont supprimés. Le prochain build crée un nouveau builder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan el contenedor del builder y su caché de compilación. La próxima compilación crea un builder nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il container del builder e la relativa cache di build vengono rimossi. La prossima build crea un nuovo builder."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O contentor do builder e a respetiva cache de compilação são removidos. A próxima compilação cria um novo builder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De buildercontainer en de buildcache ervan worden verwijderd. De volgende build maakt een nieuwe builder aan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byggarens container och dess byggcache tas bort. Nästa bygge skapar en ny byggare."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Builder-containeren og dens build-cache fjernes. Det næste build opretter en ny builder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bygger-containeren og byggebufferen dens fjernes. Neste bygging oppretter en ny bygger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koontityökalun kontti ja sen koontivälimuisti poistetaan. Seuraava koonti luo uuden koontityökalun."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontener buildera i jego pamięć podręczna budowania zostaną usunięte. Następne budowanie utworzy nowy builder."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontejner builderu a jeho mezipaměť sestavení budou odstraněny. Při příštím sestavení se vytvoří nový builder."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontajner buildera a jeho vyrovnávacia pamäť zostavení sa odstránia. Pri ďalšom zostavení sa vytvorí nový builder."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A builder-konténer és a build-gyorsítótára törlődik. A következő build új buildert hoz létre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Containerul builderului și cache-ul său de build sunt eliminate. Următorul build creează un builder nou."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Контейнерът на билдъра и неговият кеш на изграждането ще бъдат премахнати. При следващото изграждане ще бъде създаден нов билдър."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κοντέινερ του builder και η cache δόμησής του αφαιρούνται. Η επόμενη δόμηση δημιουργεί νέο builder."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklanjaju se kontejner buildera i njegova predmemorija izgradnje. Sljedeća izgradnja stvara novi builder."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsebnik graditelja in njegov predpomnilnik gradnje bosta odstranjena. Naslednja gradnja ustvari novega graditelja."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Контејнер билдера и његов кеш изградње се уклањају. Следећа изградња креира нови билдер."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontejner bildera i njegov keš izgradnje se uklanjaju. Sledeća izgradnja kreira novi bilder."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pašalinamas kūrimo įrankio konteineris ir jo kūrimo podėlis. Kito kūrimo metu bus sukurtas naujas kūrimo įrankis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Būvētāja konteiners un tā būvēšanas kešatmiņa tiek noņemti. Nākamā būvēšana izveidos jaunu būvētāju."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Koostaja konteiner ja selle koostamise vahemälu eemaldatakse. Järgmine koostamine loob uue koostaja."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Контейнер збирача та його кеш збірки буде вилучено. Під час наступної збірки буде створено новий збирач."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контейнер сборщика и его кэш сборки будут удалены. При следующей сборке будет создан новый сборщик."
          }
        }
      }
    },
