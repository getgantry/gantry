          "stringUnit": {
            "state": "translated",
            "value": "Влезте в регистър, за да качвате образи и да изтегляте частни образи с apple/container."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεθείτε σε ένα μητρώο για αποστολή εικόνων και λήψη ιδιωτικών εικόνων με το apple/container."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se u registar kako biste slali slike i povlačili privatne slike pomoću apple/container."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se v register, da boste lahko z apple/container potiskali slike in vlekli zasebne slike."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Пријавите се на регистар да бисте слали слике и повлачили приватне слике помоћу apple/container."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se na registar da biste slali slike i povlačili privatne slike pomoću apple/container."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisijunkite prie registro, kad galėtumėte išsiųsti atvaizdus ir atsisiųsti privačius atvaizdus su apple/container."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Piesakieties reģistrā, lai ar apple/container augšupielādētu attēlus un lejupielādētu privātus attēlus."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Logige registrisse sisse, et apple/containeriga tõmmiseid lükata ja privaatseid tõmmiseid tõmmata."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть у реєстр, щоб надсилати образи й отримувати приватні образи за допомогою apple/container."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в реестр, чтобы отправлять образы и скачивать частные образы с помощью apple/container."
          }
        }
      }
    },
