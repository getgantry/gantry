        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "1 container använder den här imagen. Använd Tvinga borttagning för att ta bort den ändå."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "1 container bruger dette image. Brug Tvangsfjern for at fjerne det alligevel."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "1 container bruker dette imaget. Bruk Tving fjerning for å fjerne det likevel."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "1 kontti käyttää tätä levykuvaa. Poista se silti valitsemalla Pakota poisto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten obraz jest używany przez 1 kontener. Aby mimo to go usunąć, użyj opcji Wymuś usunięcie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento image používá 1 kontejner. Chcete-li ho přesto odstranit, použijte „Vynutit odstranění“."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento obraz používa 1 kontajner. Ak ho chcete aj tak odstrániť, použite Vynútene odstrániť."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "1 konténer használja ezt az image-et. A „Kényszerített eltávolítás” gombbal így is eltávolíthatja."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "1 container folosește această imagine. Folosiți Elimină forțat pentru a o elimina oricum."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "1 контейнер използва този образ. Използвайте „Премахни принудително“, за да го премахнете въпреки това."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "1 κοντέινερ χρησιμοποιεί αυτή την εικόνα. Χρησιμοποιήστε την «Αναγκαστική αφαίρεση» για να την αφαιρέσετε ούτως ή άλλως."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovu sliku koristi 1 kontejner. Za uklanjanje svejedno upotrijebite Prisilno ukloni."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To sliko uporablja 1 vsebnik. Če jo želite kljub temu odstraniti, uporabite Prisilno odstrani."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 контејнер користи ову слику. Користите „Принудно уклони“ да бисте је ипак уклонили."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "1 kontejner koristi ovu sliku. Koristite „Prinudno ukloni“ da biste je ipak uklonili."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šį atvaizdą naudoja 1 konteineris. Norėdami vis tiek jį pašalinti, naudokite „Pašalinti priverstinai“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šo attēlu izmanto 1 konteiners. Lai to tomēr noņemtu, izmantojiet „Noņemt piespiedu kārtā”."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seda tõmmist kasutab 1 konteiner. Eemaldamiseks valige „Sundeemalda“."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей образ використовує 1 контейнер. Щоб усе одно вилучити його, виберіть «Вилучити примусово»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот образ использует 1 контейнер. Чтобы всё равно удалить образ, выберите «Удалить принудительно»."
          }
        }
      }
    },
