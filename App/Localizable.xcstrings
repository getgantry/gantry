            "value": "Suorita kontti levykuvasta, niin se näkyy täällä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchom kontener z obrazu, aby go tu zobaczyć."
          }
        },
        "cs": {
