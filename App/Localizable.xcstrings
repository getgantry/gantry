    "Use as the default domain — new containers resolve as name.%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use as the default domain — new containers resolve as name.%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用作默认域名 — 新容器将解析为 名称.%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Standarddomain verwenden – neue Container werden als name.%@ aufgelöst"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser comme domaine par défaut — les nouveaux conteneurs sont résolus en nom.%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar como dominio predeterminado: los contenedores nuevos se resuelven como nombre.%@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa come dominio predefinito: i nuovi container vengono risolti come nome.%@"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizar como domínio predefinido — os novos contentores são resolvidos como nome.%@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik als standaarddomein — nieuwe containers zijn bereikbaar als naam.%@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd som standarddomän – nya containrar kan nås som namn.%@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug som standarddomæne — nye containere slås op som navn.%@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk som standarddomene — nye containere kan nås som navn.%@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä oletusverkkotunnuksena – uudet kontit ovat tavoitettavissa muodossa nimi.%@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj jako domeny domyślnej — nowe kontenery będą rozwiązywane jako nazwa.%@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použít jako výchozí doménu – nové kontejnery se překládají jako název.%@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použiť ako predvolenú doménu – nové kontajnery budú dostupné ako názov.%@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használat alapértelmezett tartományként – az új konténerek név.%@ formában oldhatók fel"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește ca domeniu implicit — containerele noi sunt rezolvate ca nume.%@"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Използвай като домейн по подразбиране — новите контейнери се разрешават като име.%@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρήση ως προεπιλεγμένου τομέα — τα νέα κοντέινερ επιλύονται ως όνομα.%@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristi kao zadanu domenu — novi kontejneri razrješavaju se kao naziv.%@"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabi kot privzeto domeno – novi vsebniki se razrešujejo kot ime.%@"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Користи као подразумевани домен — нови контејнери се разрешавају као име.%@"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristi kao podrazumevani domen — novi kontejneri se razrešavaju kao ime.%@"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Naudoti kaip numatytąjį domeną – nauji konteineriai pasiekiami kaip vardas.%@"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izmantot kā noklusējuma domēnu — jaunie konteineri tiek atrisināti kā nosaukums.%@"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasuta vaikedomeenina — uued konteinerid lahenduvad kujul nimi.%@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовувати як типовий домен — нові контейнери розпізнаються як ім’я.%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать как домен по умолчанию — новые контейнеры будут доступны как имя.%@"
          }
        }
      }
    },
    "Use letters, digits, hyphens, dots and underscores.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use letters, digits, hyphens, dots and underscores."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用字母、数字、连字符、点和下划线。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende Buchstaben, Ziffern, Bindestriche, Punkte und Unterstriche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez des lettres, des chiffres, des traits d'union, des points et des traits de soulignement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa letras, dígitos, guiones, puntos y guiones bajos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa lettere, cifre, trattini, punti e trattini bassi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilize letras, algarismos, hífenes, pontos e sublinhados."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik letters, cijfers, koppeltekens, punten en underscores."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd bokstäver, siffror, bindestreck, punkter och understreck."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug bogstaver, cifre, bindestreger, punktummer og understregninger."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk bokstaver, sifre, bindestreker, punktum og understreker."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä kirjaimia, numeroita, yhdysmerkkejä, pisteitä ja alaviivoja."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj liter, cyfr, łączników, kropek i podkreśleń."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte písmena, číslice, spojovníky, tečky a podtržítka."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použite písmená, číslice, spojovníky, bodky a podčiarkovníky."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használjon betűket, számjegyeket, kötőjelet, pontot és aláhúzást."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosiți litere, cifre, cratime, puncte și liniuțe de subliniere."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Използвайте букви, цифри, тирета, точки и долни черти."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε γράμματα, ψηφία, παύλες, τελείες και κάτω παύλες."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristite slova, znamenke, crtice, točke i podvlake."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabite črke, števke, vezaje, pike in podčrtaje."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Користите слова, цифре, цртице, тачке и доње црте."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristite slova, cifre, crtice, tačke i donje crte."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Naudokite raides, skaitmenis, brūkšnelius, taškus ir pabraukimo brūkšnius."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izmantojiet burtus, ciparus, defises, punktus un pasvītras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasutage tähti, numbreid, sidekriipse, punkte ja allkriipse."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте літери, цифри, дефіси, крапки та підкреслення."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте буквы, цифры, дефисы, точки и подчёркивания."
          }
        }
      }
    },
