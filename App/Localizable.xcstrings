    "Nothing to clean or not permitted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to clean or not permitted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可清理的内容，或没有权限。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts zu bereinigen oder keine Berechtigung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à nettoyer ou opération non autorisée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada que limpiar o no está permitido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente da pulire o operazione non consentita."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada para limpar ou operação não permitida."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets om op te schonen of geen toestemming."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget att rensa, eller behörighet saknas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet at rydde op, eller ingen tilladelse."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting å rydde opp, eller ikke tillatt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei siivottavaa tai ei oikeuksia."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma nic do wyczyszczenia lub brak uprawnień."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není co čistit, nebo to není povoleno."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie je čo vyčistiť alebo to nie je povolené."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs mit takarítani, vagy nem engedélyezett."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic de curățat sau operațiune nepermisă."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма нищо за почистване или действието не е разрешено."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα για καθαρισμό ή δεν επιτρέπεται."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema ničega za čišćenje ili radnja nije dopuštena."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni ničesar za čiščenje ali dejanje ni dovoljeno."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Нема шта да се очисти или радња није дозвољена."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema šta da se očisti ili radnja nije dozvoljena."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nėra ką išvalyti arba neleidžiama."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nav ko iztīrīt vai darbība nav atļauta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pole midagi puhastada või puudub luba."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає чого очищати, або дію не дозволено."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нечего очищать или нет прав."
          }
        }
      }
    },
