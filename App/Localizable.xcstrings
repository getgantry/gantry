    "Kernel boot arguments need apple/container %@ or newer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kernel boot arguments need apple/container %@ or newer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内核启动参数需要 apple/container %@ 或更高版本。"
          }
