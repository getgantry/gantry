    "Hide the Dock icon to run Gantry as a menu-bar-only app. One of the two icons always stays on so the app remains reachable.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide the Dock icon to run Gantry as a menu-bar-only app. One of the two icons always stays on so the app remains reachable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏 Dock 图标可将 Gantry 仅作为菜单栏应用运行。两个图标中始终会保留一个，以便仍能打开应用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blende das Dock-Symbol aus, um Gantry nur in der Menüleiste auszuführen. Eines der beiden Symbole bleibt immer sichtbar, damit die App erreichbar bleibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquez l'icône du Dock pour utiliser Gantry uniquement depuis la barre des menus. L'une des deux icônes reste toujours affichée pour que l'app reste accessible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta el icono del Dock para usar Gantry solo desde la barra de menús. Uno de los dos iconos siempre permanece visible para que se pueda acceder a la app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi l'icona del Dock per usare Gantry solo dalla barra dei menu. Una delle due icone resta sempre attiva, così l'app rimane raggiungibile."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculte o ícone do Dock para utilizar o Gantry apenas na barra de menus. Um dos dois ícones fica sempre visível para que a app continue acessível."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verberg het Dock-symbool om Gantry alleen in de menubalk te gebruiken. Een van de twee symbolen blijft altijd aan, zodat de app bereikbaar blijft."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Göm Dock-symbolen för att köra Gantry som en app som bara finns i menyraden. En av de två symbolerna visas alltid så att appen förblir åtkomlig."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjul symbolet i Dock for at køre Gantry som en app kun i menulinjen. Et af de to symboler er altid slået til, så appen forbliver tilgængelig."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjul Dock-symbolet for å kjøre Gantry bare i menylinjen. Ett av de to symbolene er alltid på, slik at appen forblir tilgjengelig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piilota Dockin kuvake, niin Gantry toimii vain valikkorivillä. Toinen kuvakkeista on aina näkyvissä, jotta appiin pääsee käsiksi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryj ikonę w Docku, aby Gantry działał tylko na pasku menu. Jedna z dwóch ikon jest zawsze włączona, żeby aplikacja pozostała dostępna."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skryjte ikonu v Docku, aby Gantry běžela jen v řádku nabídek. Jedna z obou ikon vždy zůstane zapnutá, aby byla aplikace dostupná."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skryte ikonu v Docku, ak chcete Gantry používať iba z lišty menu. Jedna z dvoch ikon ostane vždy zapnutá, aby bola aplikácia dostupná."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Dock-ikon elrejtésével a Gantry csak a menüsorban fut. A két ikon közül az egyik mindig látható marad, hogy az app elérhető legyen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascundeți pictograma din Dock pentru a folosi Gantry doar din bara de meniu. Una dintre cele două pictograme rămâne mereu activă, ca aplicația să fie accesibilă."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрийте иконата в Dock, за да работи Gantry само в лентата с менюта. Едната от двете икони винаги остава включена, за да е достъпно приложението."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποκρύψτε το εικονίδιο του Dock για να εκτελείτε το Gantry μόνο από τη γραμμή μενού. Ένα από τα δύο εικονίδια μένει πάντα ενεργό, ώστε η εφαρμογή να είναι προσβάσιμη."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakrijte ikonu u Docku kako bi Gantry radio samo u traci s izbornicima. Jedna od dviju ikona uvijek ostaje uključena kako bi aplikacija bila dostupna."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrijte ikono v Docku, da Gantry deluje samo v menijski vrstici. Ena od obeh ikon ostane vedno vklopljena, da je aplikacija dosegljiva."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Сакријте иконицу у Dock-у да би Gantry радио само у траци менија. Једна од две иконице увек остаје укључена да би апликација била доступна."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakrijte ikonicu u Dock-u da bi Gantry radio samo u traci menija. Jedna od dve ikonice uvek ostaje uključena da bi aplikacija bila dostupna."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Paslėpkite Dock piktogramą, kad Gantry veiktų tik meniu juostoje. Viena iš dviejų piktogramų visada lieka įjungta, kad programa būtų pasiekiama."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Paslēpiet Dock ikonu, lai Gantry darbotos tikai izvēļņu joslā. Viena no abām ikonām vienmēr paliek ieslēgta, lai lietotne būtu sasniedzama."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Peida Docki ikoon, et Gantry töötaks ainult menüüribal. Üks kahest ikoonist jääb alati sisse, et rakendus oleks kättesaadav."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сховайте піктограму в Dock, щоб Gantry працювала лише в смузі меню. Одна з двох піктограм завжди лишається ввімкненою, щоб програма була доступна."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скройте значок в Dock, чтобы Gantry работал только в строке меню. Один из двух значков всегда остаётся включённым, чтобы приложение было доступно."
          }
        }
      }
    },
