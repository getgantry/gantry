    "apple/container removes the saved credentials for “%@” from the keychain.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container removes the saved credentials for “%@” from the keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container 将从钥匙串中移除“%@”的已保存凭据。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container entfernt die gespeicherten Anmeldedaten für „%@“ aus dem Schlüsselbund."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container supprime du trousseau les identifiants enregistrés pour « %@ »."
          }
