    "No local domains yet. Add one below to reach this container by name.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No local domains yet. Add one below to reach this container by name."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有本地域名。在下方添加一个即可按名称访问此容器。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine lokalen Domains. Füge unten eine hinzu, um diesen Container über seinen Namen zu erreichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun domaine local pour l'instant. Ajoutez-en un ci-dessous pour joindre ce conteneur par son nom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay dominios locales. Añade uno abajo para acceder a este contenedor por su nombre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun dominio locale. Aggiungine uno qui sotto per raggiungere questo container tramite il nome."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há domínios locais. Adicione um abaixo para aceder a este contentor pelo nome."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen lokale domeinen. Voeg er hieronder een toe om deze container op naam te bereiken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga lokala domäner än. Lägg till en nedan för att nå den här containern via namn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen lokale domæner endnu. Tilføj et nedenfor for at nå denne container ved navn."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen lokale domener ennå. Legg til et nedenfor for å nå denne containeren via navn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä paikallisia verkkotunnuksia. Lisää sellainen alla, niin tavoitat tämän kontin nimellä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak domen lokalnych. Dodaj domenę poniżej, aby łączyć się z tym kontenerem po nazwie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné místní domény. Přidejte níže doménu, abyste se k tomuto kontejneru dostali podle názvu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ žiadne lokálne domény. Pridajte doménu nižšie, aby bol tento kontajner dostupný podľa názvu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincsenek helyi tartományok. Adjon hozzá egyet lent, hogy név alapján elérje ezt a konténert."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu există domenii locale. Adăugați unul mai jos pentru a accesa acest container după nume."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Все още няма локални домейни. Добавете домейн по-долу, за да достъпвате този контейнер по име."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν ακόμη τοπικοί τομείς. Προσθέστε έναν παρακάτω για πρόσβαση σε αυτό το κοντέινερ μέσω ονόματος."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nema lokalnih domena. Dodajte domenu ispod kako biste kontejneru pristupali po nazivu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalnih domen še ni. Spodaj dodajte domeno, da boste do tega vsebnika dostopali po imenu."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Још нема локалних домена. Додајте један испод да бисте овом контејнеру приступали по имену."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nema lokalnih domena. Dodajte jedan ispod da biste ovom kontejneru pristupali po imenu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vietinių domenų dar nėra. Pridėkite domeną žemiau, kad šį konteinerį pasiektumėte pagal vardą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vēl nav lokālo domēnu. Pievienojiet domēnu tālāk, lai šim konteineram piekļūtu pēc nosaukuma."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohalikke domeene veel pole. Lisage allpool domeen, et selle konteineri poole nime järgi pöörduda."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальних доменів ще немає. Додайте домен нижче, щоб звертатися до цього контейнера за назвою."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальных доменов пока нет. Добавьте домен ниже, чтобы обращаться к этому контейнеру по имени."
          }
        }
      }
    },
