    "Without a CNI, the nodes stay NotReady until you apply one.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a CNI, the nodes stay NotReady until you apply one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有 CNI 时，节点会保持 NotReady，直到你应用一个 CNI。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne CNI bleiben die Nodes im Zustand NotReady, bis du eines anwendest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans CNI, les nœuds restent NotReady jusqu'à ce que vous en appliquiez un."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin un CNI, los nodos permanecen en NotReady hasta que apliques uno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza un CNI, i nodi restano NotReady finché non ne applichi uno."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem um CNI, os nós ficam em NotReady até aplicar um."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder CNI blijven de nodes NotReady totdat je er een toepast."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan ett CNI förblir noderna NotReady tills du tillämpar ett."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden en CNI forbliver noderne NotReady, indtil du anvender en."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uten en CNI forblir nodene NotReady til du tar i bruk en."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilman CNI:tä solmut pysyvät NotReady-tilassa, kunnes otat sellaisen käyttöön."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez CNI węzły pozostają w stanie NotReady, dopóki go nie zastosujesz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez CNI zůstanou uzly ve stavu NotReady, dokud nějaké CNI nepoužijete."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez CNI zostanú uzly v stave NotReady, kým nejaké nepoužijete."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "CNI nélkül a csomópontok NotReady állapotban maradnak, amíg nem alkalmaz egyet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără un CNI, nodurile rămân NotReady până când aplicați unul."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Без CNI възлите остават в състояние NotReady, докато не приложите такъв."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς CNI, οι κόμβοι παραμένουν NotReady μέχρι να εφαρμόσετε ένα."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez CNI-ja čvorovi ostaju u stanju NotReady dok ga ne primijenite."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brez CNI ostanejo vozlišča v stanju NotReady, dokler ga ne uporabite."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Без CNI-ја чворови остају у стању NotReady док га не примените."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez CNI-ja čvorovi ostaju u stanju NotReady dok ga ne primenite."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Be CNI mazgai lieka NotReady būsenos, kol jo nepritaikysite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez CNI mezgli paliek stāvoklī NotReady, līdz to lietojat."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilma CNI-ta jäävad sõlmed olekusse NotReady, kuni rakendate mõne CNI."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без CNI вузли залишаються в стані NotReady, доки ви його не застосуєте."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без CNI узлы остаются в состоянии NotReady, пока вы не примените CNI."
          }
        }
      }
    },
