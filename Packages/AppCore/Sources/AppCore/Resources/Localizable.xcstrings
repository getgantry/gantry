      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a memory size, for example 512m or 2g."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine Speichergröße ein, zum Beispiel 512m oder 2g."
          }
