          }
        }
      }
    },
    "“%@” is not a valid period. Use a number with an optional m, h or d suffix, for example 30m.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is not a valid period. Use a number with an optional m, h or d suffix, for example 30m."
