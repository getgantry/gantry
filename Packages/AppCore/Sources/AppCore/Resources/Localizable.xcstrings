    "A digest (sha256:…) is required for a remote archive.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A digest (sha256:…) is required for a remote archive."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程归档文件需要提供摘要（sha256:…）。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für ein entferntes Archiv ist ein Digest (sha256:…) erforderlich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un condensat (sha256:…) est requis pour une archive distante."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere un digest (sha256:…) para un archivo comprimido remoto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per un archivio remoto è necessario un digest (sha256:…)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessário um digest (sha256:…) para um arquivo remoto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor een extern archief is een digest (sha256:…) vereist."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En kontrollsumma (sha256:…) krävs för ett fjärrarkiv."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et digest (sha256:…) er påkrævet for et fjernarkiv."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En digest (sha256:…) er påkrevd for et eksternt arkiv."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Etäarkistolle vaaditaan tiiviste (sha256:…)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdalne archiwum wymaga skrótu (sha256:…)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro vzdálený archiv je vyžadován digest (sha256:…)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre vzdialený archív je potrebný digest (sha256:…)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Távoli archívumhoz kivonat (sha256:…) szükséges."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru o arhivă la distanță este necesar un digest (sha256:…)."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За отдалечен архив е необходима контролна сума (sha256:…)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για απομακρυσμένο αρχείο συμπίεσης απαιτείται digest (sha256:…)."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za udaljenu arhivu potreban je sažetak (sha256:…)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za oddaljeni arhiv je potreben izvleček (sha256:…)."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "За удаљену архиву потребан је хеш (sha256:…)."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Za udaljenu arhivu potreban je heš (sha256:…)."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuotoliniam archyvui būtina santrauka (sha256:…)."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Attālam arhīvam nepieciešama kontrolsumma (sha256:…)."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaugarhiivi jaoks on räsi (sha256:…) kohustuslik."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для віддаленого архіву потрібен дайджест (sha256:…)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для удалённого архива нужен дайджест (sha256:…)."
          }
        }
      }
    },
