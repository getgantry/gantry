    "No saved SSH password for %@. Connect once from the Gantry app to store it in the Keychain.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No saved SSH password for %@. Connect once from the Gantry app to store it in the Keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有为 %@ 保存 SSH 密码。请先在 Gantry App 中连接一次，将其存入钥匙串。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein gespeichertes SSH-Passwort für %@. Verbinde dich einmal über die Gantry-App, um es im Schlüsselbund zu speichern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun mot de passe SSH enregistré pour %@. Connectez-vous une fois depuis l'app Gantry pour l'enregistrer dans le trousseau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna contraseña SSH guardada para %@. Conéctate una vez desde la app Gantry para guardarla en el llavero."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna password SSH salvata per %@. Connettiti una volta dall'app Gantry per salvarla nel portachiavi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não existe nenhuma palavra-passe SSH guardada para %@. Ligue-se uma vez a partir da app Gantry para a guardar no porta-chaves."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen bewaard SSH-wachtwoord voor %@. Maak eenmaal verbinding vanuit de Gantry-app om het in de sleutelhanger te bewaren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget SSH-lösenord är sparat för %@. Anslut en gång från Gantry-appen för att spara det i nyckelringen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ingen gemt SSH-adgangskode til %@. Opret forbindelse én gang fra Gantry-appen for at gemme den i nøgleringen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen lagret SSH-passord for %@. Koble til én gang fra Gantry-appen for å lagre det i nøkkelringen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Isännälle %@ ei ole tallennettu SSH-salasanaa. Yhdistä kerran Gantry-apista, niin salasana tallennetaan Avainnippuun."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak zapisanego hasła SSH dla %@. Połącz się raz z aplikacji Gantry, aby zapisać je w pęku kluczy."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro hostitele %@ není uloženo heslo SSH. Jednou se připojte z aplikace Gantry, aby se uložilo do Klíčenky."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre %@ nie je uložené žiadne heslo SSH. Raz sa pripojte z aplikácie Gantry, aby sa uložilo do Kľúčenky."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs mentett SSH-jelszó a(z) %@ gazdagéphez. Csatlakozzon egyszer a Gantry appból, hogy a jelszó a Kulcskarikába kerüljön."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există nicio parolă SSH salvată pentru %@. Conectați-vă o dată din aplicația Gantry pentru a o salva în portchei."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма запазена SSH парола за %@. Свържете се веднъж от приложението Gantry, за да я запазите в Ключодържателя."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει αποθηκευμένο συνθηματικό SSH για τον host %@. Συνδεθείτε μία φορά από την εφαρμογή Gantry για να αποθηκευτεί στην Κλειδοθήκη."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema spremljene SSH lozinke za %@. Povežite se jednom iz aplikacije Gantry kako biste je spremili u Privjesak ključeva."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za %@ ni shranjenega gesla SSH. Enkrat se povežite iz aplikacije Gantry, da ga shranite v obesek za ključe."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Нема сачуване SSH лозинке за %@. Повежите се једном из апликације Gantry да бисте је сачували у привеску за кључеве."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema sačuvane SSH lozinke za %@. Povežite se jednom iz aplikacije Gantry da biste je sačuvali u privesku za ključeve."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
