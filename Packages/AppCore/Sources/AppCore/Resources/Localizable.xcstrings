            "state": "translated",
            "value": "Não foi possível ler “%@” como ficheiro normal, pelo que nada foi guardado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” kan niet worden gelezen als gewoon bestand, dus er is niets bewaard."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” kunde inte läsas som en vanlig fil, så inget sparades."
          }
        },
        "da": {
