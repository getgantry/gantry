          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro hostitele %@ není uloženo heslo SSH. Jednou se připojte z aplikace Gantry, aby se uložilo do Klíčenky."
          }
        },
        "sk": {
          "stringUnit": {
