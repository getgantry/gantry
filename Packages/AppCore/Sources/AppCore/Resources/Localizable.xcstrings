    "The text has more than one command. Only the first command is used.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text has more than one command. Only the first command is used."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text enthält mehr als einen Befehl. Nur der erste Befehl wird verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte contient plusieurs commandes. Seule la première est utilisée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto tiene más de un comando. Solo se usa el primero."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo contiene più di un comando. Viene usato solo il primo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto tem mais do que um comando. Só é utilizado o primeiro comando."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tekst bevat meer dan één commando. Alleen het eerste commando wordt gebruikt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Texten innehåller mer än ett kommando. Bara det första kommandot används."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksten indeholder mere end én kommando. Kun den første kommando bruges."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksten inneholder mer enn én kommando. Bare den første kommandoen brukes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstissä on useampi kuin yksi komento. Vain ensimmäistä komentoa käytetään."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst zawiera więcej niż jedno polecenie. Używane jest tylko pierwsze polecenie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Text obsahuje více než jeden příkaz. Použije se jen první příkaz."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Text obsahuje viac ako jeden príkaz. Použije sa iba prvý príkaz."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szöveg több parancsot tartalmaz. A Gantry csak az első parancsot használja."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Textul conține mai multe comenzi. Se folosește doar prima comandă."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Текстът съдържа повече от една команда. Използва се само първата команда."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κείμενο περιέχει περισσότερες από μία εντολές. Χρησιμοποιείται μόνο η πρώτη εντολή."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst sadrži više od jedne naredbe. Koristi se samo prva naredba."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Besedilo vsebuje več kot en ukaz. Uporabi se samo prvi ukaz."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст садржи више од једне команде. Користи се само прва команда."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst sadrži više od jedne komande. Koristi se samo prva komanda."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekste yra daugiau nei viena komanda. Naudojama tik pirmoji komanda."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstā ir vairāk nekā viena komanda. Tiek izmantota tikai pirmā komanda."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstis on rohkem kui üks käsk. Kasutatakse ainult esimest käsku."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У тексті більше ніж одна команда. Використовується лише перша."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В тексте больше одной команды. Используется только первая."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本中有多个命令。仅使用第一个命令。"
          }
        }
      }
    },
    "Global options are not used. Gantry uses the selected host.": {
