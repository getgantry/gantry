          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Нема сачуване SSH лозинке за %@. Повежите се једном из апликације Gantry да бисте је сачували у привеску за кључеве."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema sačuvane SSH lozinke za %@. Povežite se jednom iz aplikacije Gantry da biste je sačuvali u privesku za ključeve."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveriui %@ nėra išsaugoto SSH slaptažodžio. Vieną kartą prisijunkite per Gantry programą, kad jis būtų įrašytas į raktinę."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Resursdatoram %@ nav saglabātas SSH paroles. Vienreiz izveidojiet savienojumu no lietotnes Gantry, lai to saglabātu atslēgu piekariņā."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hosti %@ jaoks pole SSH-parooli salvestatud. Selle võtmerõngasse salvestamiseks looge üks kord ühendus rakendusest Gantry."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для %@ немає збереженого пароля SSH. Під’єднайтеся один раз із програми Gantry, щоб зберегти його у В’язці ключів."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет сохранённого пароля SSH для %@. Подключитесь один раз из приложения Gantry, чтобы сохранить его в Связке ключей."
          }
        }
      }
    },
