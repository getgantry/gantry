    "This apple/container version cannot verify a digest. Update to 1.2 or later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This apple/container version cannot verify a digest. Update to 1.2 or later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的 apple/container 无法校验摘要。请更新到 1.2 或更高版本。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese apple/container-Version kann keinen Digest prüfen. Aktualisiere auf 1.2 oder neuer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version d'apple/container ne peut pas vérifier de condensat. Passez à la version 1.2 ou ultérieure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de apple/container no puede verificar un digest. Actualiza a la 1.2 o posterior."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione di apple/container non può verificare un digest. Aggiorna alla 1.2 o successiva."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão do apple/container não consegue verificar um digest. Atualize para a 1.2 ou posterior."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze versie van apple/container kan geen digest verifiëren. Werk bij naar 1.2 of nieuwer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här versionen av apple/container kan inte verifiera en kontrollsumma. Uppdatera till 1.2 eller senare."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne version af apple/container kan ikke bekræfte et digest. Opdater til 1.2 eller nyere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne versjonen av apple/container kan ikke verifisere en digest. Oppdater til 1.2 eller nyere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä apple/container-versio ei voi tarkistaa tiivistettä. Päivitä versioon 1.2 tai uudempaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta wersja apple/container nie może zweryfikować skrótu. Uaktualnij do wersji 1.2 lub nowszej."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato verze apple/container neumí ověřit digest. Aktualizujte na verzi 1.2 nebo novější."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto verzia apple/container nedokáže overiť digest. Aktualizujte na verziu 1.2 alebo novšiu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az apple/container verzió nem tudja ellenőrizni a kivonatot. Frissítsen 1.2-es vagy újabb verzióra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această versiune apple/container nu poate verifica un digest. Actualizați la 1.2 sau o versiune ulterioară."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази версия на apple/container не може да проверява контролна сума. Актуализирайте до 1.2 или по-нова версия."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η έκδοση του apple/container δεν μπορεί να επαληθεύσει digest. Ενημερώστε σε 1.2 ή νεότερη."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
