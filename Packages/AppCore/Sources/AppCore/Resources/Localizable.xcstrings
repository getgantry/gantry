            "state": "translated",
            "value": "%#@containers@ running across %#@hosts@."
          },
          "substitutions": {
            "containers": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
