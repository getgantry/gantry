            "state": "translated",
            "value": "顶层不是映射"
          }
        }
      }
    },
    "Use letters, digits, “_”, “.” and “-”, starting with a letter or digit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use letters, digits, “_”, “.” and “-”, starting with a letter or digit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能使用字母、数字、“_”、“.”和“-”，并以字母或数字开头。"
          }
        }
      }
    },
    "“%@” could not be read as a regular file, so nothing was saved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” could not be read as a regular file, so nothing was saved."
          }
