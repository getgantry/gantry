          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta različica apple/container ne more preveriti izvlečka. Posodobite na 1.2 ali novejšo."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ова верзија apple/container не може да провери хеш. Ажурирајте на 1.2 или новију."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova verzija apple/container ne može da proveri heš. Ažurirajte na 1.2 ili noviju."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ši apple/container versija negali patikrinti santraukos. Atnaujinkite į 1.2 ar naujesnę versiją."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šī apple/container versija nevar pārbaudīt kontrolsummu. Atjauniniet uz 1.2 vai jaunāku versiju."
          }
        },
        "et": {
