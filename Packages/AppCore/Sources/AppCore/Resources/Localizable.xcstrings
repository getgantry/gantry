          "stringUnit": {
            "state": "translated",
            "value": "此文件没有 `services:`，看起来不是 Compose 文件。"
          }
        }
      }
    },
    "This Mac can't run nested virtualization (it needs Apple silicon M3 or newer on macOS 15+).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac can't run nested virtualization (it needs Apple silicon M3 or newer on macOS 15+)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 无法运行嵌套虚拟化（需要 M3 或更新的 Apple 芯片，并运行 macOS 15 或更高版本）。"
          }
        }
      }
    },
    "This port isn't published, so it can't be shared.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This port isn't published, so it can't be shared."
