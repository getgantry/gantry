{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@ can't open a debug shell. It needs a Docker engine — apple/container runs each container in its own VM and offers no way to share namespaces with it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can't open a debug shell. It needs a Docker engine — apple/container runs each container in its own VM and offers no way to share namespaces with it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 无法打开调试 Shell。它需要 Docker 引擎：apple/container 将每个容器运行在独立的虚拟机中，无法与其共享命名空间。"
          }
        }
      }
    },
    "%@ on %@ exited with code %lld.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on %@ exited with code %lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 上的 %1$@ 已退出，退出码为 %3$lld。"
          }
        }
      }
    },
    "%@ on %@ failed its health check.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on %@ failed its health check."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（%@）健康检查失败。"
          }
        }
      }
    },
    "%@ on %@ was killed after running out of memory.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on %@ was killed after running out of memory."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（%@）因内存不足被终止。"
          }
        }
      }
    },
    "%@ was killed by signal %lld.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was killed by signal %lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 被信号 %2$lld 终止。"
          }
        }
      }
    },
    "%@ was killed by signal %lld. Last output: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was killed by signal %lld. Last output: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 被信号 %2$lld 终止。最后的输出：%3$@"
          }
        }
      }
    },
    "%@: `user:` is not yet applied and was ignored.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: `user:` is not yet applied and was ignored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：暂不支持 `user:`，已忽略。"
          }
        }
      }
    },
    "%@: bind-mount host paths must exist on the remote server, not your Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: bind-mount host paths must exist on the remote server, not your Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：绑定挂载的主机路径必须存在于远程服务器上，而不是你的 Mac 上。"
          }
        }
      }
    },
    "%@: joins multiple networks; apple/container attaches only `%@`.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: joins multiple networks; apple/container attaches only `%@`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：加入了多个网络；apple/container 只会连接 `%2$@`。"
          }
        }
      }
    },
    "%@: restart policy `%@` is not supported on apple/container and was ignored.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: restart policy `%@` is not supported on apple/container and was ignored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：apple/container 不支持重启策略 `%2$@`，已忽略。"
          }
        }
      }
    },
    "%lld containers": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
