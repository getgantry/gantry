    "No local Docker socket was found. Make sure Docker is running.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No local Docker socket was found. Make sure Docker is running."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到本地 Docker 套接字。请确认 Docker 正在运行。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde kein lokaler Docker-Socket gefunden. Stelle sicher, dass Docker läuft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun socket Docker local trouvé. Assurez-vous que Docker est en cours d'exécution."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado ningún socket de Docker local. Asegúrate de que Docker está en ejecución."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun socket Docker locale trovato. Assicurati che Docker sia in esecuzione."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi encontrado nenhum socket Docker local. Certifique-se de que o Docker está em execução."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen lokale Docker-socket gevonden. Zorg ervoor dat Docker actief is."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen lokal Docker-socket hittades. Kontrollera att Docker körs."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke fundet nogen lokal Docker-socket. Sørg for, at Docker kører."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ingen lokal Docker-socket. Kontroller at Docker kjører."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikallista Docker-socketia ei löytynyt. Varmista, että Docker on käynnissä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono lokalnego gniazda Dockera. Upewnij się, że Docker działa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebyl nalezen žádný místní socket Dockeru. Ujistěte se, že Docker běží."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenašiel sa žiadny lokálny soket Dockeru. Skontrolujte, či Docker beží."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem található helyi Docker-socket. Ellenőrizze, hogy fut-e a Docker."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a găsit niciun socket Docker local. Asigurați-vă că Docker rulează."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не е намерен локален сокет на Docker. Уверете се, че Docker работи."
          }
        },
        "el": {
          "stringUnit": {
