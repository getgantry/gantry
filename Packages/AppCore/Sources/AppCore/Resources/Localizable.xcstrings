          "stringUnit": {
            "state": "translated",
            "value": "“%@”不是有效的 IP 地址。"
          }
        }
      }
    },
    "“%@” is not a valid memory size. Use a number with an optional K, M, G, T or P suffix, for example 4g.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
