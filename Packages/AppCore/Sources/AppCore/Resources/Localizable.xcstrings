    "%@: bind-mount host paths must exist on the remote server, not your Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: bind-mount host paths must exist on the remote server, not your Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：绑定挂载的主机路径必须存在于远程服务器上，而不是你的 Mac 上。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Host-Pfade für Bind-Mounts müssen auf dem entfernten Server vorhanden sein, nicht auf deinem Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : les chemins d'hôte des montages liés doivent exister sur le serveur distant, pas sur votre Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: las rutas de host de los montajes enlazados deben existir en el servidor remoto, no en tu Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: i percorsi host dei bind mount devono esistere sul server remoto, non sul Mac."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: os caminhos de host das montagens de associação têm de existir no servidor remoto, não no seu Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: hostpaden voor bind mounts moeten op de externe server bestaan, niet op je Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: sökvägar på värden för bindningsmonteringar måste finnas på fjärrservern, inte på din Mac."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: værtsstier til bind-mounts skal findes på fjernserveren, ikke på din Mac."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: vertsbaner for bind-monteringer må finnes på den eksterne serveren, ikke på Macen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: sidosliitosten isäntäpolkujen on oltava olemassa etäpalvelimella, ei Macissasi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: ścieżki hosta w montowaniach katalogów muszą istnieć na serwerze zdalnym, a nie na Macu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: cesty bind mountů na hostiteli musí existovat na vzdáleném serveru, ne na vašem Macu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: cesty hostiteľa pre bind mount musia existovať na vzdialenom serveri, nie vo vašom Macu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: a bind mount gazdagépbeli útvonalainak a távoli szerveren kell létezniük, nem a Macen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: căile de gazdă ale montărilor bind trebuie să existe pe serverul la distanță, nu pe Mac-ul dvs."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: пътищата на хоста за bind монтиране трябва да съществуват на отдалечения сървър, а не на вашия Mac."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: οι διαδρομές host για bind mount πρέπει να υπάρχουν στον απομακρυσμένο διακομιστή, όχι στο Mac σας."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: putanje hosta za bind mount moraju postojati na udaljenom poslužitelju, a ne na vašem Macu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: poti gostitelja za vezne priklope morajo obstajati na oddaljenem strežniku, ne v vašem Macu."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: путање хоста за bind mount морају да постоје на удаљеном серверу, а не на вашем Mac рачунару."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: putanje hosta za bind mount moraju da postoje na udaljenom serveru, a ne na vašem Mac računaru."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: susietojo prijungimo serverio keliai turi būti nuotoliniame serveryje, o ne jūsų „Mac“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: bind montējuma resursdatora ceļiem jāpastāv attālajā serverī, nevis jūsu Mac datorā."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: bind mount'i hostiteed peavad olemas olema kaugserveris, mitte teie Macis."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: шляхи хоста для bind-монтування мають існувати на віддаленому сервері, а не на вашому Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: пути хоста для bind-монтирования должны существовать на удалённом сервере, а не на вашем Mac."
          }
        }
      }
    },
