    "Use letters, digits, “_”, “.” and “-”, starting with a letter or digit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use letters, digits, “_”, “.” and “-”, starting with a letter or digit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能使用字母、数字、“_”、“.”和“-”，并以字母或数字开头。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende Buchstaben, Ziffern, „_“, „.“ und „-“, beginnend mit einem Buchstaben oder einer Ziffer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez des lettres, des chiffres, « _ », « . » et « - », en commençant par une lettre ou un chiffre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa letras, dígitos, “_”, “.” y “-”, empezando por una letra o un dígito."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa lettere, cifre, “_”, “.” e “-”, iniziando con una lettera o una cifra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilize letras, algarismos, “_”, “.” e “-”, a começar por uma letra ou algarismo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik letters, cijfers, “_”, “.” en “-”, beginnend met een letter of cijfer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd bokstäver, siffror, ”_”, ”.” och ”-”, och börja med en bokstav eller siffra."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug bogstaver, cifre, “_”, “.” og “-”, og start med et bogstav eller et ciffer."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk bokstaver, sifre, «_», «.» og «-», og begynn med en bokstav eller et siffer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä kirjaimia, numeroita, ”_”, ”.” ja ”-”. Alussa on oltava kirjain tai numero."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj liter, cyfr, „_”, „.” i „-”, zaczynając od litery lub cyfry."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte písmena, číslice, „_“, „.“ a „-“, na začátku písmeno nebo číslici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použite písmená, číslice, „_“, „.“ a „-“, na začiatku písmeno alebo číslica."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használjon betűket, számjegyeket, „_”, „.” és „-” karaktert, betűvel vagy számjeggyel kezdve."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosiți litere, cifre, „_”, „.” și „-”, începând cu o literă sau o cifră."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Използвайте букви, цифри, „_“, „.“ и „-“, като името започва с буква или цифра."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε γράμματα, ψηφία, «_», «.» και «-», με πρώτο χαρακτήρα γράμμα ή ψηφίο."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristite slova, znamenke, „_”, „.” i „-”, s početnim slovom ili znamenkom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabite črke, števke, „_“, „.“ in „-“, na začetku črko ali števko."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Користите слова, цифре, „_“, „.“ и „-“, почевши словом или цифром."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristite slova, cifre, „_“, „.“ i „-“, počevši slovom ili cifrom."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Naudokite raides, skaitmenis, „_“, „.“ ir „-“, pradedant raide arba skaitmeniu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izmantojiet burtus, ciparus, „_”, „.” un „-”, sākot ar burtu vai ciparu."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasutage tähti, numbreid, „_“, „.“ ja „-“, alguses täht või number."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте літери, цифри, «_», «.» і «-»; першим символом має бути літера чи цифра."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте буквы, цифры, «_», «.» и «-», первый символ — буква или цифра."
          }
        }
      }
    },
    "“%@” could not be read as a regular file, so nothing was saved.": {
      "localizations": {
