    "Homebrew isn't installed. Install it from https://brew.sh, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew isn't installed. Install it from https://brew.sh, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未安装 Homebrew。请从 https://brew.sh 安装后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew ist nicht installiert. Installiere es von https://brew.sh und versuche es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew n'est pas installé. Installez-le depuis https://brew.sh, puis réessayez."
          }
