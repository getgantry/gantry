    "Use letters, digits, “_”, “.” and “-”, starting with a letter or digit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use letters, digits, “_”, “.” and “-”, starting with a letter or digit."
