    "The SSH key at %@ is passphrase-protected and no passphrase is saved for %@. Connect once from the Gantry app to store it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SSH key at %@ is passphrase-protected and no passphrase is saved for %@. Connect once from the Gantry app to store it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位于 %1$@ 的 SSH 密钥受密码短语保护，但没有为 %2$@ 保存密码短语。请先在 Gantry App 中连接一次以保存它。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der SSH-Schlüssel unter %@ ist mit einer Passphrase geschützt, und für %@ ist keine Passphrase gespeichert. Verbinde dich einmal über die Gantry-App, um sie zu speichern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé SSH située dans %@ est protégée par une phrase secrète, et aucune phrase secrète n'est enregistrée pour %@. Connectez-vous une fois depuis l'app Gantry pour l'enregistrer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave SSH de %@ está protegida con una frase de contraseña y no hay ninguna guardada para %@. Conéctate una vez desde la app Gantry para guardarla."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave SSH in %@ è protetta da passphrase e non è salvata alcuna passphrase per %@. Connettiti una volta dall'app Gantry per salvarla."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave SSH em %@ está protegida por frase-passe e não existe nenhuma frase-passe guardada para %@. Ligue-se uma vez a partir da app Gantry para a guardar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De SSH-sleutel op %@ is beveiligd met een wachtwoordzin en er is geen wachtwoordzin bewaard voor %@. Maak eenmaal verbinding vanuit de Gantry-app om deze te bewaren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH-nyckeln i %@ är skyddad med lösenfras och ingen lösenfras är sparad för %@. Anslut en gång från Gantry-appen för att spara den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH-nøglen i %@ er beskyttet med et adgangsudtryk, og der er ikke gemt noget adgangsudtryk til %@. Opret forbindelse én gang fra Gantry-appen for at gemme det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH-nøkkelen i %@ er beskyttet med passordfrase, og ingen passordfrase er lagret for %@. Koble til én gang fra Gantry-appen for å lagre den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH-avain sijainnissa %@ on suojattu tunnuslauseella, eikä isännälle %@ ole tallennettu tunnuslausetta. Tallenna se yhdistämällä kerran Gantry-apista."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz SSH w %@ jest chroniony hasłem, a dla %@ nie zapisano hasła. Połącz się raz z aplikacji Gantry, aby je zapisać."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klíč SSH v %1$@ je chráněn heslem a pro hostitele %2$@ není uloženo žádné heslo ke klíči. Jednou se připojte z aplikace Gantry, aby se uložilo."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kľúč SSH v %@ je chránený prístupovou frázou a pre %@ nie je uložená žiadna prístupová fráza. Raz sa pripojte z aplikácie Gantry, aby sa uložila."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ helyen lévő SSH-kulcs jelmondattal védett, és nincs mentett jelmondat a(z) %@ gazdagéphez. Csatlakozzon egyszer a Gantry appból a mentéshez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheia SSH de la %@ este protejată cu frază de acces și nu este salvată nicio frază de acces pentru %@. Conectați-vă o dată din aplicația Gantry pentru a o salva."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH ключът в %@ е защитен с парола, а за %@ няма запазена парола за ключа. Свържете се веднъж от приложението Gantry, за да я запазите."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κλειδί SSH στο %1$@ προστατεύεται με φράση πρόσβασης και δεν έχει αποθηκευτεί φράση πρόσβασης για τον host %2$@. Συνδεθείτε μία φορά από την εφαρμογή Gantry για να αποθηκευτεί."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH ključ na lokaciji %@ zaštićen je lozinkom, a za %@ nije spremljena lozinka. Povežite se jednom iz aplikacije Gantry kako biste je spremili."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ključ SSH na poti %@ je zaščiten z geslom, za %@ pa geslo ni shranjeno. Enkrat se povežite iz aplikacije Gantry, da ga shranite."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH кључ на %@ је заштићен приступном фразом, а за %@ није сачувана приступна фраза. Повежите се једном из апликације Gantry да бисте је сачували."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH ključ na %@ je zaštićen pristupnom frazom, a za %@ nije sačuvana pristupna fraza. Povežite se jednom iz aplikacije Gantry da biste je sačuvali."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH raktas %@ apsaugotas slaptafraze, o serveriui %@ slaptafrazė neišsaugota. Vieną kartą prisijunkite per Gantry programą, kad ji būtų įrašyta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH atslēga %@ ir aizsargāta ar ieejas frāzi, un resursdatoram %@ nav saglabāta ieejas frāze. Vienreiz izveidojiet savienojumu no lietotnes Gantry, lai to saglabātu."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH-võti asukohas %1$@ on parooliga kaitstud ja hosti %2$@ jaoks pole parooli salvestatud. Salvestamiseks looge üks kord ühendus rakendusest Gantry."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ SSH у %@ захищено парольною фразою, а для %@ парольну фразу не збережено. Під’єднайтеся один раз із програми Gantry, щоб зберегти її."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH-ключ %1$@ защищён парольной фразой, а для %2$@ парольная фраза не сохранена. Подключитесь один раз из приложения Gantry, чтобы сохранить её."
          }
        }
      }
    },
    "This apple/container version cannot verify a digest. Update to 1.2 or later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This apple/container version cannot verify a digest. Update to 1.2 or later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的 apple/container 无法校验摘要。请更新到 1.2 或更高版本。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese apple/container-Version kann keinen Digest prüfen. Aktualisiere auf 1.2 oder neuer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version d'apple/container ne peut pas vérifier de condensat. Passez à la version 1.2 ou ultérieure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de apple/container no puede verificar un digest. Actualiza a la 1.2 o posterior."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione di apple/container non può verificare un digest. Aggiorna alla 1.2 o successiva."
