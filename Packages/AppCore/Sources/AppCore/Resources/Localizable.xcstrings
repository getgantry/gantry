    "Enter a domain name: letters, digits, dots and hyphens.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a domain name: letters, digits, dots and hyphens."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入域名：仅限字母、数字、点和连字符。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Domainnamen ein: Buchstaben, Ziffern, Punkte und Bindestriche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un nom de domaine : lettres, chiffres, points et traits d'union."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un nombre de dominio: letras, dígitos, puntos y guiones."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un nome di dominio: lettere, cifre, punti e trattini."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza um nome de domínio: letras, algarismos, pontos e hífenes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een domeinnaam in: letters, cijfers, punten en koppeltekens."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange ett domännamn: bokstäver, siffror, punkter och bindestreck."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast et domænenavn: bogstaver, cifre, punktummer og bindestreger."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn et domenenavn: bokstaver, sifre, punktum og bindestreker."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna verkkotunnus: kirjaimia, numeroita, pisteitä ja yhdysmerkkejä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź nazwę domeny: litery, cyfry, kropki i łączniki."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte název domény: písmena, číslice, tečky a spojovníky."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadajte názov domény: písmená, číslice, bodky a spojovníky."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjon meg egy tartománynevet: betűk, számjegyek, pontok és kötőjelek."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduceți un nume de domeniu: litere, cifre, puncte și cratime."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Въведете име на домейн: букви, цифри, точки и тирета."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε όνομα τομέα: γράμματα, ψηφία, τελείες και παύλες."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite naziv domene: slova, znamenke, točke i crtice."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vnesite ime domene: črke, števke, pike in vezaji."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Унесите име домена: слова, цифре, тачке и цртице."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite ime domena: slova, cifre, tačke i crtice."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įveskite domeno vardą: raidės, skaitmenys, taškai ir brūkšneliai."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ievadiet domēna nosaukumu: burti, cipari, punkti un defises."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisestage domeeninimi: tähed, numbrid, punktid ja sidekriipsud."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть доменне ім’я: літери, цифри, крапки та дефіси."
          }
        },
        "ru": {
