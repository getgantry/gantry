          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs mentett SSH-jelszó a(z) %@ gazdagéphez. Csatlakozzon egyszer a Gantry appból, hogy a jelszó a Kulcskarikába kerüljön."
          }
        },
        "ro": {
