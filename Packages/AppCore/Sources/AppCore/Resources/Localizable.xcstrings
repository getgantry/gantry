    "Anonymous volumes are not supported. Give a host path or a volume name.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymous volumes are not supported. Give a host path or a volume name."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonyme Volumes werden nicht unterstützt. Gib einen Host-Pfad oder einen Volume-Namen an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les volumes anonymes ne sont pas pris en charge. Indiquez un chemin sur l'hôte ou un nom de volume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los volúmenes anónimos no son compatibles. Indica una ruta del host o un nombre de volumen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I volumi anonimi non sono supportati. Indica un percorso dell'host o il nome di un volume."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os volumes anónimos não são suportados. Indique um caminho do host ou um nome de volume."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonieme volumes worden niet ondersteund. Geef een hostpad of een volumenaam op."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonyma volymer stöds inte. Ange en sökväg på värden eller ett volymnamn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonyme volumes understøttes ikke. Angiv en sti på værten eller et volume-navn."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonyme volumer støttes ikke. Oppgi en bane på verten eller et volumnavn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimettömiä taltioita ei tueta. Anna isännän polku tai taltion nimi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonimowe woluminy nie są obsługiwane. Podaj ścieżkę na hoście lub nazwę woluminu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymní svazky nejsou podporovány. Zadejte cestu na hostiteli nebo název svazku."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymné zväzky nie sú podporované. Zadajte cestu na hostiteľovi alebo názov zväzku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A névtelen kötetek nem támogatottak. Adjon meg egy gazdagépen lévő útvonalat vagy egy kötetnevet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumele anonime nu sunt acceptate. Indicați o cale de pe gazdă sau un nume de volum."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Анонимните томове не се поддържат. Задайте път на хоста или име на том."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ανώνυμοι τόμοι δεν υποστηρίζονται. Δώστε μια διαδρομή του host ή ένα όνομα τόμου."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonimni volumeni nisu podržani. Navedite putanju na hostu ili naziv volumena."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonimni nosilci niso podprti. Navedite pot na gostitelju ali ime nosilca."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Анонимни волумени нису подржани. Наведите путању на хосту или име волумена."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonimni volumeni nisu podržani. Navedite putanju na hostu ili ime volumena."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Anoniminiai tomai nepalaikomi. Nurodykite kelią serveryje arba tomo pavadinimą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonīmi sējumi netiek atbalstīti. Norādiet ceļu resursdatorā vai sējuma nosaukumu."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonüümsed köited pole toetatud. Sisestage hosti tee või köite nimi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Анонімні томи не підтримуються. Укажіть шлях на хості або назву тому."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анонимные тома не поддерживаются. Укажите путь на хосте или имя тома."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持匿名卷。请提供主机路径或卷名称。"
          }
        },
