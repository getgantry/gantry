    "Could not create network %@; it may already exist.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not create network %@; it may already exist."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建网络 %@，它可能已存在。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netzwerk %@ konnte nicht erstellt werden; möglicherweise ist es bereits vorhanden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de créer le réseau %@ ; il existe peut-être déjà."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido crear la red %@; puede que ya exista."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile creare la rete %@; potrebbe esistere già."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível criar a rede %@; talvez já exista."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan netwerk %@ niet aanmaken; het bestaat mogelijk al."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att skapa nätverket %@; det kanske redan finns."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke oprette netværket %@; det findes muligvis allerede."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke opprette nettverket %@. Det finnes kanskje allerede."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkkoa %@ ei voitu luoda; se voi olla jo olemassa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można utworzyć sieci %@. Możliwe, że już istnieje."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Síť %@ nelze vytvořit; možná již existuje."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieť %@ sa nepodarilo vytvoriť; možno už existuje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült létrehozni a(z) %@ hálózatot; lehet, hogy már létezik."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rețeaua %@ nu a putut fi creată; este posibil să existe deja."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Мрежата %@ не може да бъде създадена; възможно е вече да съществува."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η δημιουργία του δικτύου %@· ίσως υπάρχει ήδη."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće stvoriti mrežu %@. Možda već postoji."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omrežja %@ ni bilo mogoče ustvariti; morda že obstaja."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Није могуће креирати мрежу %@; можда већ постоји."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće kreirati mrežu %@; možda već postoji."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko sukurti tinklo %@; galbūt jis jau yra."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nevarēja izveidot tīklu %@; iespējams, tas jau pastāv."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võrku %@ ei õnnestunud luua, see võib juba olemas olla."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося створити мережу %@; можливо, вона вже існує."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось создать сеть %@: возможно, она уже существует."
          }
        }
      }
    },
