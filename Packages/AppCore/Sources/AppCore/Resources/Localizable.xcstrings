    "This Mac can't run nested virtualization (it needs Apple silicon M3 or newer on macOS 15+).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac can't run nested virtualization (it needs Apple silicon M3 or newer on macOS 15+)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 无法运行嵌套虚拟化（需要 M3 或更新的 Apple 芯片，并运行 macOS 15 或更高版本）。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac unterstützt keine verschachtelte Virtualisierung (erforderlich ist Apple Chip M3 oder neuer mit macOS 15 oder neuer)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac ne prend pas en charge la virtualisation imbriquée (elle nécessite une puce Apple M3 ou ultérieure et macOS 15 ou ultérieur)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no admite la virtualización anidada (requiere un chip M3 de Apple o posterior y macOS 15 o posterior)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac non supporta la virtualizzazione annidata (richiede Apple silicon M3 o successivo con macOS 15 o successivo)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac não suporta virtualização aninhada (requer Apple silicon M3 ou posterior com macOS 15 ou posterior)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Mac ondersteunt geen geneste virtualisatie (hiervoor is Apple silicon M3 of nieuwer met macOS 15 of later nodig)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här Macen kan inte köra nästlad virtualisering (det kräver Apple-chip M3 eller senare med macOS 15 eller senare)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac kan ikke køre indlejret virtualisering (det kræver en Apple-chip M3 eller nyere med macOS 15+)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Macen kan ikke kjøre nestet virtualisering (det krever Apple-chip M3 eller nyere med macOS 15 eller nyere)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä Mac ei tue sisäkkäistä virtualisointia (se vaatii Apple-sirun M3 tai uudemman ja macOS 15:n tai uudemman)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac nie obsługuje wirtualizacji zagnieżdżonej (wymaga Apple silicon M3 lub nowszego oraz macOS 15 lub nowszego)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento Mac nepodporuje vnořenou virtualizaci (vyžaduje Apple silicon M3 nebo novější a macOS 15 nebo novější)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento Mac nepodporuje vnorenú virtualizáciu (vyžaduje Apple silicon M3 alebo novší a macOS 15 alebo novší)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a Mac nem képes beágyazott virtualizációra (Apple M3 vagy újabb chip és macOS 15 vagy újabb szükséges)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest Mac nu poate rula virtualizare imbricată (necesită Apple silicon M3 sau mai nou cu macOS 15 sau o versiune ulterioară)."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този Mac не поддържа вложена виртуализация (изисква Apple silicon M3 или по-нов с macOS 15 или по-нова версия)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το Mac δεν υποστηρίζει ένθετη εικονικοποίηση (απαιτεί Apple silicon M3 ή νεότερο με macOS 15 ή νεότερο)."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj Mac ne podržava ugniježđenu virtualizaciju (potreban je Apple silicon M3 ili noviji uz macOS 15+)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta Mac ne more izvajati ugnezdene virtualizacije (zahteva čip Apple M3 ali novejši in macOS 15 ali novejši)."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Овај Mac не може да покреће угнежђену виртуелизацију (потребан је Apple чип M3 или новији и macOS 15+)."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj Mac ne može da pokreće ugnežđenu virtuelizaciju (potreban je Apple čip M3 ili noviji i macOS 15+)."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiame „Mac“ negalima naudoti įdėtinės virtualizacijos (reikia Apple M3 ar naujesnio lusto ir macOS 15 ar naujesnės versijos)."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šajā Mac datorā nevar izmantot ligzdoto virtualizāciju (nepieciešams Apple silicon M3 vai jaunāks ar macOS 15 vai jaunāku)."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See Mac ei toeta pesastatud virtualiseerimist (vaja on Apple'i kiipi M3 või uuemat ja macOS 15+)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей Mac не підтримує вкладену віртуалізацію (потрібен Apple silicon M3 чи новіший і macOS 15 або новіша)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac не поддерживает вложенную виртуализацию (нужен Apple silicon M3 или новее и macOS 15+)."
          }
        }
      }
    },
