            "value": "apple/container hat keine Neustartrichtlinien. Die Neustartrichtlinie „%@“ wird nicht verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container ne prend pas en charge les politiques de redémarrage. La politique de redémarrage « %@ » n'est pas utilisée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container no tiene políticas de reinicio. La política de reinicio “%@” no se usa."
