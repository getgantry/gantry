    "The retry count %@ is not used. The policy restarts without a limit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The retry count %@ is not used. The policy restarts without a limit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anzahl der Wiederholungen %@ wird nicht verwendet. Die Richtlinie startet ohne Limit neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre de tentatives %@ n'est pas utilisé. La politique redémarre sans limite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El número de reintentos %@ no se usa. La política reinicia sin límite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il numero di tentativi %@ non viene usato. Il criterio riavvia senza limiti."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O número de tentativas %@ não é utilizado. A política reinicia sem limite."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het aantal pogingen %@ wordt niet gebruikt. Het beleid herstart zonder limiet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Antalet försök %@ används inte. Policyn startar om utan gräns."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Antallet genforsøg %@ bruges ikke. Politikken genstarter uden grænse."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Antall forsøk %@ brukes ikke. Regelen starter på nytt uten grense."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uusintakertojen määrää %@ ei käytetä. Käytäntö käynnistää uudelleen rajatta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczba ponownych prób %@ nie jest używana. Zasady uruchamiają ponownie bez limitu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počet opakování %@ se nepoužije. Zásada restartuje bez omezení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počet opakovaní %@ sa nepoužije. Politika reštartuje bez obmedzenia."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ újrapróbálkozási szám figyelmen kívül marad. A szabály korlát nélkül indít újra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numărul de reîncercări %@ nu este folosit. Politica repornește fără limită."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Броят повторни опити %@ не се използва. Политиката рестартира без ограничение."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο αριθμός επαναλήψεων %@ δεν χρησιμοποιείται. Η πολιτική επανεκκινεί χωρίς όριο."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Broj ponovnih pokušaja %@ se ne koristi. Pravilo ponovno pokreće bez ograničenja."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Število ponovnih poskusov %@ se ne uporabi. Pravilnik znova zaganja brez omejitve."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Број поновних покушаја %@ се не користи. Смерница поново покреће без ограничења."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Broj ponovnih pokušaja %@ se ne koristi. Smernica ponovo pokreće bez ograničenja."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakartojimų skaičius %@ nenaudojamas. Politika paleidžia iš naujo be apribojimo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atkārtojumu skaits %@ netiek izmantots. Politika restartē bez ierobežojuma."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Korduskatsete arvu %@ ei kasutata. Poliitika taaskäivitab piiranguta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кількість повторів %@ не використовується. Політика перезапускає контейнер без обмежень."
