          "stringUnit": {
            "state": "translated",
            "value": "Привилегированата команда е неуспешна."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εντολή με αυξημένα δικαιώματα απέτυχε."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Privilegirana naredba nije uspjela."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Privilegirani ukaz ni uspel."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Привилегована команда није успела."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Privilegovana komanda nije uspela."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko įvykdyti privilegijuotos komandos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Privileģētā komanda neizdevās."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Privilegeeritud käsk nurjus."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося виконати привілейовану команду."
          }
