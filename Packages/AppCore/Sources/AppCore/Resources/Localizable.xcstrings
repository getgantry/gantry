    "No local Docker socket was found. Make sure Docker is running.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No local Docker socket was found. Make sure Docker is running."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到本地 Docker 套接字。请确认 Docker 正在运行。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde kein lokaler Docker-Socket gefunden. Stelle sicher, dass Docker läuft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun socket Docker local trouvé. Assurez-vous que Docker est en cours d'exécution."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado ningún socket de Docker local. Asegúrate de que Docker está en ejecución."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
