    "Only one network is supported. The first network is used.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only one network is supported. The first network is used."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ein Netzwerk wird unterstützt. Das erste Netzwerk wird verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul réseau est pris en charge. Le premier réseau est utilisé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se admite una red. Se usa la primera red."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È supportata una sola rete. Viene usata la prima rete."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só é suportada uma rede. É utilizada a primeira rede."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt maar één netwerk ondersteund. Het eerste netwerk wordt gebruikt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara ett nätverk stöds. Det första nätverket används."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun ét netværk understøttes. Det første netværk bruges."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare ett nettverk støttes. Det første nettverket brukes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain yhtä verkkoa tuetaan. Ensimmäistä verkkoa käytetään."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsługiwana jest tylko jedna sieć. Używana jest pierwsza sieć."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podporována je jen jedna síť. Použije se první síť."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podporovaná je iba jedna sieť. Použije sa prvá sieť."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak egy hálózat támogatott. A Gantry az első hálózatot használja."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este acceptată o singură rețea. Se folosește prima rețea."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддържа се само една мрежа. Използва се първата мрежа."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υποστηρίζεται μόνο ένα δίκτυο. Χρησιμοποιείται το πρώτο δίκτυο."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržana je samo jedna mreža. Koristi se prva mreža."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podprto je samo eno omrežje. Uporabi se prvo omrežje."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Подржана је само једна мрежа. Користи се прва мрежа."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržana je samo jedna mreža. Koristi se prva mreža."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Palaikomas tik vienas tinklas. Naudojamas pirmasis tinklas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiek atbalstīts tikai viens tīkls. Tiek izmantots pirmais tīkls."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Toetatud on ainult üks võrk. Kasutatakse esimest võrku."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтримується лише одна мережа. Використовується перша."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддерживается только одна сеть. Используется первая."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅支持一个网络。将使用第一个网络。"
