          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen lokale Docker-socket gevonden. Zorg ervoor dat Docker actief is."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen lokal Docker-socket hittades. Kontrollera att Docker körs."
          }
        },
        "da": {
          "stringUnit": {
