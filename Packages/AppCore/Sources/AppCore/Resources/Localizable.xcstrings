    "Gantry does not read env files. Add the variables from %@ by hand.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry does not read env files. Add the variables from %@ by hand."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry liest keine env-Dateien. Füge die Variablen aus %@ manuell hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry ne lit pas les fichiers env. Ajoutez à la main les variables de %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry no lee archivos env. Añade a mano las variables de %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry non legge i file env. Aggiungi a mano le variabili di %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Gantry não lê ficheiros env. Adicione manualmente as variáveis de %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry leest geen env-bestanden. Voeg de variabelen uit %@ handmatig toe."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry läser inte env-filer. Lägg till variablerna från %@ för hand."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry læser ikke env-filer. Tilføj variablerne fra %@ manuelt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry leser ikke env-filer. Legg til variablene fra %@ manuelt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry ei lue env-tiedostoja. Lisää tiedoston %@ muuttujat käsin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry nie odczytuje plików env. Dodaj ręcznie zmienne z %@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry nečte soubory env. Přidejte proměnné ze souboru %@ ručně."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry nečíta súbory env. Pridajte premenné zo súboru %@ ručne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Gantry nem olvassa be az env fájlokat. Adja hozzá kézzel a változókat innen: %@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
