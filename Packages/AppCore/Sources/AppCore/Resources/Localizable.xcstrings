          "stringUnit": {
            "state": "translated",
            "value": "命令以反斜杠 (\\) 结尾。"
          }
        }
      }
    },
    "The command has a double quote (\") without a closing quote.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The command has a double quote (\") without a closing quote."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令中的双引号 (\") 缺少闭合引号。"
          }
        }
      }
    },
    "The command has a single quote (') without a closing quote.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The command has a single quote (') without a closing quote."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令中的单引号 (') 缺少闭合引号。"
