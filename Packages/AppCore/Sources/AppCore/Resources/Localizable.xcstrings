              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld 个容器"
                }
              }
            }
          }
        }
      }
    },
    "%lld containers running across %lld hosts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@containers@ running across %#@hosts@."
          },
          "substitutions": {
            "containers": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg container"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg containers"
                    }
                  }
                }
              }
            },
            "hosts": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg host"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg hosts"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 个容器正在 %2$lld 台主机上运行。"
          }
        }
      }
    },
    "%lld hosts": {
      "localizations": {
