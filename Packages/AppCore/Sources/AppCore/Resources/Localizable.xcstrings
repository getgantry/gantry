    "This restart policy is not valid.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This restart policy is not valid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Neustartrichtlinie ist ungültig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette politique de redémarrage n'est pas valide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta política de reinicio no es válida."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo criterio di riavvio non è valido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta política de reinício não é válida."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit herstartbeleid is ongeldig."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här omstartspolicyn är ogiltig."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne genstartspolitik er ugyldig."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne omstartsregelen er ugyldig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä uudelleenkäynnistyskäytäntö ei kelpaa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te zasady ponownego uruchamiania są nieprawidłowe."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato zásada restartu je neplatná."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto politika reštartu je neplatná."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az újraindítási szabály érvénytelen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această politică de repornire nu este validă."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази политика за рестартиране е невалидна."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η πολιτική επανεκκίνησης δεν είναι έγκυρη."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo pravilo ponovnog pokretanja nije valjano."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta pravilnik ponovnega zagona ni veljaven."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ова смерница поновног покретања није исправна."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova smernica ponovnog pokretanja nije ispravna."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ši paleidimo iš naujo politika netinkama."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šī restartēšanas politika nav derīga."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See taaskäivituspoliitika pole kehtiv."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю політику перезапуску вказано неправильно."
          }
        },
