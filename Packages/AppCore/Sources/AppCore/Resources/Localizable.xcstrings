            "value": "Der blev ikke fundet nogen lokal Docker-socket. Sørg for, at Docker kører."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ingen lokal Docker-socket. Kontroller at Docker kjører."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikallista Docker-socketia ei löytynyt. Varmista, että Docker on käynnissä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono lokalnego gniazda Dockera. Upewnij się, że Docker działa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebyl nalezen žádný místní socket Dockeru. Ujistěte se, že Docker běží."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
