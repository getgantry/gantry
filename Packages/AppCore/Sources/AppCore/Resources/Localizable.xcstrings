    "The `container %@` command is not installed. Install the official apple/container package, which includes the plugin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The `container %@` command is not installed. Install the official apple/container package, which includes the plugin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未安装 `container %@` 命令。请安装官方 apple/container 软件包，其中包含此插件。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Befehl `container %@` ist nicht installiert. Installiere das offizielle apple/container-Paket, das das Plug-in enthält."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La commande `container %@` n'est pas installée. Installez le paquet officiel apple/container, qui inclut le plug-in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El comando `container %@` no está instalado. Instala el paquete oficial de apple/container, que incluye el plugin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il comando `container %@` non è installato. Installa il pacchetto ufficiale di apple/container, che include il plug-in."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O comando `container %@` não está instalado. Instale o pacote oficial do apple/container, que inclui o plug-in."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het commando `container %@` is niet geïnstalleerd. Installeer het officiële apple/container-pakket, dat de plug-in bevat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommandot `container %@` är inte installerat. Installera det officiella apple/container-paketet, som innehåller pluginet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommandoen `container %@` er ikke installeret. Installer den officielle apple/container-pakke, som indeholder pluginnet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommandoen `container %@` er ikke installert. Installer den offisielle apple/container-pakken, som inneholder utvidelsen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Komentoa `container %@` ei ole asennettu. Asenna virallinen apple/container-paketti, joka sisältää laajennuksen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polecenie `container %@` nie jest zainstalowane. Zainstaluj oficjalny pakiet apple/container, który zawiera tę wtyczkę."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příkaz `container %@` není nainstalován. Nainstalujte oficiální balíček apple/container, který plugin obsahuje."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Príkaz `container %@` nie je nainštalovaný. Nainštalujte oficiálny balík apple/container, ktorý obsahuje tento plugin."
