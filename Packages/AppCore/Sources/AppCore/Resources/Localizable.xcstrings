    "apple/container cannot pick a host port. Ports without a host port are not published.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container cannot pick a host port. Ports without a host port are not published."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container kann keinen Host-Port auswählen. Ports ohne Host-Port werden nicht veröffentlicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container ne peut pas choisir de port sur l'hôte. Les ports sans port d'hôte ne sont pas publiés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container no puede elegir un puerto del host. Los puertos sin puerto del host no se publican."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container non può scegliere una porta dell'host. Le porte senza porta dell'host non vengono pubblicate."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O apple/container não consegue escolher uma porta do host. As portas sem porta do host não são publicadas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container kan geen hostpoort kiezen. Poorten zonder hostpoort worden niet gepubliceerd."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container kan inte välja en värdport. Portar utan värdport publiceras inte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container kan ikke vælge en værtsport. Porte uden værtsport publiceres ikke."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container kan ikke velge en vertsport. Porter uten vertsport publiseres ikke."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container ei voi valita isännän porttia. Portteja, joilla ei ole isännän porttia, ei julkaista."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container nie może wybrać portu hosta. Porty bez portu hosta nie są publikowane."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container nedokáže zvolit port hostitele. Porty bez portu hostitele se nepublikují."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container nedokáže zvoliť port hostiteľa. Porty bez portu hostiteľa sa nepublikujú."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az apple/container nem tud gazdagépportot választani. A gazdagépport nélküli portok nem lesznek közzétéve."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container nu poate alege un port pe gazdă. Porturile fără port pe gazdă nu sunt publicate."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container не може сам да избере порт на хоста. Портовете без порт на хоста не се публикуват."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το apple/container δεν μπορεί να επιλέξει θύρα του host. Οι θύρες χωρίς θύρα host δεν δημοσιεύονται."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container ne može sam odabrati port hosta. Portovi bez porta hosta se ne objavljuju."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container ne more izbrati vrat gostitelja. Vrata brez vrat gostitelja niso objavljena."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container не може сам да изабере порт хоста. Портови без порта хоста се не објављују."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container ne može sam da izabere port hosta. Portovi bez porta hosta se ne objavljuju."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container negali pats parinkti serverio prievado. Prievadai be serverio prievado neskelbiami."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container nevar pats izvēlēties resursdatora portu. Porti bez resursdatora porta netiek publicēti."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container ei saa hosti porti ise valida. Ilma hosti pordita porte ei avaldata."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container не може сам вибрати порт хоста. Порти без порту хоста не публікуються."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container не может сам выбрать порт хоста. Порты без порта хоста не публикуются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "apple/container 无法自动选择主机端口。未指定主机端口的端口不会发布。"
          }
        }
      }
