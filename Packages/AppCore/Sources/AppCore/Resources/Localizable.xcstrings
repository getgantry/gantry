          "stringUnit": {
            "state": "translated",
            "value": "无法将“%@”作为普通文件读取，因此未保存任何内容。"
          }
        }
      }
    },
    "“%@” is not a valid domain name.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is not a valid domain name."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不是有效的域名。"
          }
        }
      }
    },
    "“%@” is not a valid domain name. Use letters, digits, dots and hyphens.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is not a valid domain name. Use letters, digits, dots and hyphens."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不是有效的域名。请使用字母、数字、点和连字符。"
          }
        }
      }
    },
    "“%@” is not a valid IP address.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is not a valid IP address."
          }
        },
