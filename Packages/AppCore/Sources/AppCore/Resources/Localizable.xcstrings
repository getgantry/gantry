    "The nodes that this creation made so far are deleted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The nodes that this creation made so far are deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此次创建已生成的节点将被删除。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nodes, die diese Erstellung bisher angelegt hat, werden gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nœuds créés jusqu'ici par cette opération sont supprimés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan los nodos que esta creación ha generado hasta ahora."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nodi creati finora da questa operazione vengono eliminati."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nós criados até agora por esta operação são eliminados."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De nodes die tot nu toe bij het aanmaken zijn gemaakt, worden verwijderd."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De noder som har skapats hittills raderas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De noder, som denne oprettelse har lavet indtil nu, slettes."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodene som denne opprettingen har laget så langt, slettes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tähän mennessä luodut solmut poistetaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Węzły utworzone dotąd w tym procesie zostaną usunięte."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzly, které toto vytváření dosud vytvořilo, budou smazány."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzly, ktoré toto vytváranie doteraz vytvorilo, sa vymažú."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eddig létrehozott csomópontok törlődnek."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodurile create până acum de această operațiune sunt șterse."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Възлите, създадени досега от този процес, ще бъдат изтрити."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράφονται οι κόμβοι που έχει δημιουργήσει μέχρι τώρα αυτή η διαδικασία."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brišu se čvorovi koje je ovo stvaranje dosad napravilo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vozlišča, ki jih je to ustvarjanje doslej ustvarilo, bodo izbrisana."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Чворови које је ово креирање до сада направило се бришу."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Čvorovi koje je ovo kreiranje do sada napravilo se brišu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ištrinami iki šiol šio kūrimo metu sukurti mazgai."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiek dzēsti mezgli, kas līdz šim izveidoti šīs izveides laikā."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kustutatakse sõlmed, mille see loomine seni lõi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вузли, створені до цього моменту, буде видалено."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узлы, которые уже успели создаться, будут удалены."
          }
        }
      }
    },
