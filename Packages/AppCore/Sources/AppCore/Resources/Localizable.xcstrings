          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ sa nepodarilo prečítať ako bežný súbor, preto sa nič neuložilo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nem olvasható be normál fájlként, ezért nem történt mentés."
          }
        },
        "ro": {
          "stringUnit": {
