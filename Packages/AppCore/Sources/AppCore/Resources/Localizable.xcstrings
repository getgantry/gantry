{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@ can't open a debug shell. It needs a Docker engine — apple/container runs each container in its own VM and offers no way to share namespaces with it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can't open a debug shell. It needs a Docker engine — apple/container runs each container in its own VM and offers no way to share namespaces with it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 无法打开调试 Shell。它需要 Docker 引擎：apple/container 将每个容器运行在独立的虚拟机中，无法与其共享命名空间。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann keine Debug-Shell öffnen. Dafür ist eine Docker-Engine erforderlich – apple/container führt jeden Container in einer eigenen VM aus und bietet keine Möglichkeit, Namespaces mit ihm zu teilen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne peut pas ouvrir de shell de débogage. Il faut un moteur Docker : apple/container exécute chaque conteneur dans sa propre VM et ne permet pas d'en partager les espaces de noms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no puede abrir un shell de depuración. Necesita un motor Docker: apple/container ejecuta cada contenedor en su propia máquina virtual y no permite compartir sus espacios de nombres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non può aprire una shell di debug. Serve un motore Docker: apple/container esegue ogni container in una propria VM e non offre modo di condividerne i namespace."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não consegue abrir uma shell de depuração. Precisa de um motor Docker — o apple/container executa cada contentor na sua própria VM e não permite partilhar namespaces com ele."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan geen debugshell openen. Hiervoor is een Docker-engine nodig — apple/container draait elke container in een eigen VM en biedt geen manier om namespaces ermee te delen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan inte öppna ett felsökningsskal. Det kräver en Docker-motor – apple/container kör varje container i en egen VM och erbjuder inget sätt att dela namnrymder med den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan ikke åbne en fejlfindingsshell. Det kræver en Docker-motor — apple/container kører hver container i sin egen VM og giver ingen mulighed for at dele navnerum med den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan ikke åpne et feilsøkingsskall. Det krever en Docker-motor — apple/container kjører hver container i sin egen VM og kan ikke dele navnerom med den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei voi avata vianetsintäkomentotulkkia. Se vaatii Docker-moottorin – apple/container ajaa jokaista konttia omassa virtuaalikoneessaan eikä tarjoa tapaa jakaa nimiavaruuksia sen kanssa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Host %@ nie może otworzyć powłoki debugowania. Wymaga to silnika Docker — apple/container uruchamia każdy kontener w osobnej maszynie wirtualnej i nie pozwala na współdzielenie z nim przestrzeni nazw."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostitel %@ nemůže otevřít ladicí shell. Vyžaduje modul Docker – apple/container spouští každý kontejner ve vlastním virtuálním stroji a neumožňuje s ním sdílet jmenné prostory."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nedokáže otvoriť ladiaci shell. Vyžaduje Docker engine – apple/container spúšťa každý kontajner vo vlastnom virtuálnom stroji a neumožňuje s ním zdieľať menné priestory."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: nem nyitható meg hibakereső shell. Ehhez Docker-motor szükséges – az apple/container minden konténert saját virtuális gépen futtat, és nem teszi lehetővé a névterek megosztását vele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nu poate deschide un shell de depanare. Este nevoie de un motor Docker — apple/container rulează fiecare container în propria VM și nu oferă nicio modalitate de a partaja namespace-urile cu acesta."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не може да отвори обвивка за отстраняване на грешки. Необходима е среда Docker — apple/container изпълнява всеки контейнер в собствена виртуална машина и не позволява споделяне на пространства от имена с него."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο host %@ δεν μπορεί να ανοίξει shell αποσφαλμάτωσης. Χρειάζεται μηχανή Docker — το apple/container εκτελεί κάθε κοντέινερ στη δική του VM και δεν επιτρέπει κοινή χρήση namespace μαζί του."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne može otvoriti dijagnostičku ljusku. Potreban je Docker engine — apple/container pokreće svaki kontejner u vlastitom virtualnom stroju i ne omogućuje dijeljenje imenskih prostora s njim."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne more odpreti lupine za razhroščevanje. Potrebuje pogon Docker – apple/container vsak vsebnik izvaja v svojem navideznem stroju in ne omogoča skupne rabe imenskih prostorov z njim."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не може да отвори дијагностичку љуску. Потребан је Docker механизам — apple/container покреће сваки контејнер у сопственој виртуелној машини и не омогућава дељење простора имена са њим."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne može da otvori dijagnostičku ljusku. Potreban je Docker mehanizam — apple/container pokreće svaki kontejner u sopstvenoj virtuelnoj mašini i ne omogućava deljenje prostora imena sa njim."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: nepavyksta atidaryti derinimo apvalkalo. Tam reikia Docker variklio – apple/container kiekvieną konteinerį vykdo atskiroje virtualiojoje mašinoje ir neleidžia su juo bendrinti vardų sričių."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Resursdators %@ nevar atvērt atkļūdošanas čaulu. Tam nepieciešams Docker dzinējs — apple/container katru konteineru palaiž atsevišķā virtuālajā mašīnā un nenodrošina iespēju koplietot ar to nosaukumtelpas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei saa silumisshelli avada. Selleks on vaja Dockeri mootorit — apple/container käitab iga konteinerit eraldi virtuaalmasinas ega võimalda sellega nimeruume jagada."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: неможливо відкрити оболонку налагодження. Для цього потрібен рушій Docker — apple/container запускає кожен контейнер у власній віртуальній машині й не дає змоги спільно використовувати з нею простори імен."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: нельзя открыть отладочную оболочку. Для этого нужен движок Docker — apple/container запускает каждый контейнер в отдельной ВМ и не позволяет использовать с ним общие пространства имён."
          }
        }
      }
    },
    "%@ on %@ exited with code %lld.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on %@ exited with code %lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 上的 %1$@ 已退出，退出码为 %3$lld。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ auf %@ wurde mit Code %lld beendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sur %@ s'est arrêté avec le code %lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en %@ ha finalizado con el código %lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ su %@ è terminato con il codice %lld."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ em %@ terminou com o código %lld."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ op %@ is afgesloten met code %lld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ på %@ avslutades med kod %lld."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ på %@ afsluttede med kode %lld."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ på %@ avsluttet med kode %lld."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontti %@ isännällä %@ päättyi koodilla %lld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontener %@ na hoście %@ zakończył działanie z kodem %lld."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontejner %@ na hostiteli %@ skončil s kódem %lld."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontajner %@ na hostiteľovi %@ skončil s kódom %lld."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@) kilépett, kód: %lld."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pe %@ s-a oprit cu codul %lld."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ на %@ приключи с код %lld."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κοντέινερ %1$@ στο %2$@ τερματίστηκε με κωδικό %3$lld."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontejner %@ na hostu %@ završio je s izlaznim kôdom %lld."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsebnik %@ na gostitelju %@ se je končal s kodo %lld."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ на %@ је завршио рад са кодом %lld."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ na %@ je završio rad sa kodom %lld."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (serveris %@) baigė darbą su kodu %lld."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Konteiners %1$@ resursdatorā %2$@ beidza darbu ar kodu %3$lld."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (host %2$@) väljus koodiga %3$lld."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Контейнер %@ на %@ завершив роботу з кодом %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контейнер %1$@ на %2$@ завершил работу с кодом %3$lld."
          }
        }
      }
    },
    "%@ on %@ failed its health check.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on %@ failed its health check."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（%@）健康检查失败。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ auf %@ hat die Integritätsprüfung nicht bestanden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sur %@ a échoué à son contrôle d'état."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en %@ no ha superado su comprobación de estado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ su %@ non ha superato il controllo di integrità."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ em %@ falhou a verificação de estado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ op %@ heeft de statuscontrole niet doorstaan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ på %@ klarade inte sin hälsokontroll."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ på %@ fejlede sit sundhedstjek."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ på %@ besto ikke helsesjekken."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontin %@ kuntotarkistus isännällä %@ epäonnistui."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontener %@ na hoście %@ nie przeszedł testu stanu zdrowia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontejner %@ na hostiteli %@ neprošel kontrolou stavu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontajner %@ na hostiteľovi %@ neprešiel kontrolou stavu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@) nem felelt meg az állapotellenőrzésnek."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pe %@ nu a trecut verificarea de sănătate."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ на %@ не премина проверката на състоянието."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κοντέινερ %1$@ στο %2$@ απέτυχε στον έλεγχο υγείας."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontejner %@ na hostu %@ nije prošao provjeru zdravlja."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsebnik %@ na gostitelju %@ ni prestal preverjanja zdravja."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ на %@ није прошао проверу исправности."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ na %@ nije prošao proveru ispravnosti."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (serveris %@): nepavyko būsenos patikra."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Konteineram %1$@ resursdatorā %2$@ neizdevās veselības pārbaude."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (host %2$@) ei läbinud seisukontrolli."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Контейнер %@ на %@ не пройшов перевірку стану."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контейнер %@ на %@ не прошёл проверку работоспособности."
          }
        }
      }
    },
    "%@ on %@ was killed after running out of memory.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on %@ was killed after running out of memory."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（%@）因内存不足被终止。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ auf %@ wurde zwangsweise beendet, weil kein Arbeitsspeicher mehr verfügbar war."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sur %@ a été tué faute de mémoire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en %@ se ha cerrado a la fuerza por quedarse sin memoria."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ su %@ è stato terminato forzatamente per esaurimento della memoria."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ em %@ foi terminado à força após ficar sem memória."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ op %@ is beëindigd omdat het geheugen op was."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ på %@ tvångsavslutades när minnet tog slut."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ på %@ blev dræbt, fordi den løb tør for hukommelse."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ på %@ ble drept etter å ha gått tom for minne."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontti %@ isännällä %@ tapettiin, koska sen muisti loppui."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontener %@ na hoście %@ został zabity po wyczerpaniu pamięci."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontejner %@ na hostiteli %@ byl ukončen po vyčerpání paměti."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontajner %@ na hostiteľovi %@ bol ukončený, pretože minul pamäť."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@) kényszerítetten leállt, mert elfogyott a memória."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pe %@ a fost oprit forțat după ce a rămas fără memorie."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ на %@ беше прекратен, след като изчерпа паметта си."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κοντέινερ %1$@ στο %2$@ τερματίστηκε επειδή εξάντλησε τη μνήμη."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontejner %@ na hostu %@ prekinut je jer je ostao bez memorije."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsebnik %@ na gostitelju %@ je bil prisilno ustavljen, ker mu je zmanjkalo pomnilnika."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ на %@ је принудно заустављен јер је остао без меморије."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ na %@ je prinudno zaustavljen jer je ostao bez memorije."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (serveris %@) nutrauktas, nes pritrūko atminties."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Konteiners %1$@ resursdatorā %2$@ tika piespiedu kārtā apturēts, jo tam pietrūka atmiņas."
          }
        },
