    "Host file browsing requires a connected SSH host": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Host file browsing requires a connected SSH host"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览主机文件需要已连接的 SSH 主机"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Durchsuchen von Host-Dateien ist ein verbundener SSH-Host erforderlich"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La navigation dans les fichiers de l'hôte nécessite un hôte SSH connecté"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para explorar los archivos del host se necesita un host SSH conectado"
          }
