    "Gantry cannot read the saved recipes file.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry cannot read the saved recipes file."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry kann die Datei mit den gesicherten Rezepten nicht lesen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry ne peut pas lire le fichier des modèles enregistrés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry no puede leer el archivo de recetas guardadas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantry non riesce a leggere il file delle ricette salvate."
          }
