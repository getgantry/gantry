      }
    },
    "The container port must be a number from 1 to 65535.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The container port must be a number from 1 to 65535."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "容器端口必须是 1 到 65535 之间的数字。"
          }
        }
      }
    },
    "The host port must be a number from 1 to 65535.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host port must be a number from 1 to 65535."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机端口必须是 1 到 65535 之间的数字。"
          }
        }
      }
    },
    "This container port is already mapped in another row.": {
      "localizations": {
