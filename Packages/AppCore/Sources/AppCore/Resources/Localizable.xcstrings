          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije pronađena lokalna Docker utičnica. Provjerite je li Docker pokrenut."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalne vtičnice Docker ni bilo mogoče najti. Preverite, ali Docker deluje."
