    "Hosts that answer, running containers and the most important problem.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hosts that answer, running containers and the most important problem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可响应的主机、正在运行的容器和最重要的问题。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreichbare Hosts, aktive Container und das wichtigste Problem."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôtes qui répondent, conteneurs en cours d'exécution et problème le plus important."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hosts que responden, contenedores en ejecución y el problema más importante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Host che rispondono, container in esecuzione e il problema più importante."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Hosts que respondem, contentores em execução e o problema mais importante."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hosts die reageren, actieve containers en het belangrijkste probleem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Värdar som svarar, containrar som körs och det viktigaste problemet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Værter, der svarer, kørende containere og det vigtigste problem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Verter som svarer, kjørende containere og det viktigste problemet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastaavat isännät, käynnissä olevat kontit ja tärkein ongelma."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hosty, które odpowiadają, uruchomione kontenery i najważniejszy problem."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostitelé, kteří odpovídají, běžící kontejnery a nejdůležitější problém."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostitelia, ktorí odpovedajú, spustené kontajnery a najdôležitejší problém."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszoló gazdagépek, futó konténerek és a legfontosabb probléma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gazdele care răspund, containerele în execuție și cea mai importantă problemă."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отговарящи хостове, работещи контейнери и най-важният проблем."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Host που αποκρίνονται, κοντέινερ σε εκτέλεση και το σημαντικότερο πρόβλημα."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostovi koji odgovaraju, pokrenuti kontejneri i najvažniji problem."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gostitelji, ki se odzivajo, vsebniki, ki se izvajajo, in najpomembnejša težava."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Хостови који одговарају, покренути контејнери и најважнији проблем."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostovi koji odgovaraju, pokrenuti kontejneri i najvažniji problem."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atsakantys serveriai, veikiantys konteineriai ir svarbiausia problema."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atbildošie resursdatori, darbojošies konteineri un svarīgākā problēma."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastavad hostid, töötavad konteinerid ja kõige olulisem probleem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хости, що відповідають, запущені контейнери й найважливіша проблема."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвечающие хосты, работающие контейнеры и самая важная проблема."
          }
        }
      }
    },
    "Open Gantry to see your fleet here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Gantry to see your fleet here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Gantry 即可在此查看你的集群。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Gantry, um deine Flotte hier zu sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Gantry pour voir votre parc ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Gantry para ver aquí tu flota."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Gantry per vedere qui la tua flotta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Gantry para ver aqui a sua frota."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Gantry om je vloot hier te zien."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Gantry för att se din flotta här."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Gantry for at se din flåde her."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Gantry for å se flåten din her."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Gantry, niin näet isäntäsi täällä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Gantry, aby zobaczyć tutaj swoją flotę."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete Gantry, abyste zde viděli svou flotilu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorte Gantry, aby ste tu videli svoju flotilu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyissa meg a Gantryt, hogy itt lássa a flottáját."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschideți Gantry pentru a vedea aici flota dvs."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отворете Gantry, за да виждате инфраструктурата си тук."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε το Gantry για να δείτε εδώ τον στόλο σας."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite Gantry da biste ovdje vidjeli svoju infrastrukturu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odprite Gantry, da tukaj vidite svojo floto."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Отворите Gantry да бисте овде видели своју инфраструктуру."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite Gantry da biste ovde videli svoju infrastrukturu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atidarykite Gantry, kad čia matytumėte savo infrastruktūrą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atveriet Gantry, lai šeit redzētu savu infrastruktūru."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Avage Gantry, et näha siin oma taristut."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте Gantry, щоб бачити тут свій парк хостів."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Gantry, чтобы видеть здесь свой парк хостов."
          }
        }
      }
    },
